# Repository (defaults: nyharena25 / 0xTsoa)
REPO_OWNER=nyharena25
REPO_NAME=0xTsoa

# Canonical site (default: https://0xtsoa.dev, served at the root)
SITE_URL=https://0xtsoa.dev
BASE_PATH=

# Google Analytics 4 measurement ID (analytics are off when unset; ignored when GTM_CONTAINER_ID is set, since the container fires GA4)
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager container ID (default: GTM-TNS9SDDM; it waits for the same consent as GA)
# GTM_CONTAINER_ID=GTM-TNS9SDDM

# Optional: token for higher GitHub API rate limits (votes, READMEs)
# GITHUB_TOKEN=ghp_...
