{
  "$schema": "../../schema/config.schema.json",
  "name": "Aylur Dotfiles",
  "author": {
    "name": "Aylur",
    "github": "Aylur"
  },
  "lang": "en",
  "summary": "Personal Hyprland setup by the author of AGS, built around a custom GTK shell.",
  "description": "Personal configuration from Aylur, the author of AGS (Aylur's GTK Shell). At this pinned version the README only points to Marble Shell, his desktop shell project, so read it to see what the repository contains before cloning.",
  "license": "NOASSERTION",
  "updatedAt": "2026-10-18",
  "distros": [
    "any"
  ],
  "category": "dotfiles",
  "wm": "hyprland",
  "themeStyle": "material",
  "displayServer": "wayland",
  "tags": [
    "ags",
    "gtk",
    "typescript"
  ],
  "screenshots": [
    {
      "url": "/screenshots/fallback-terminal.svg",
      "alt": "Aylur Dotfiles: no screenshot published upstream"
    }
  ],
  "source": {
    "repo": "https://github.com/Aylur/dotfiles",
    "ref": "b3a43b1229d747ec089b62b06303eb09cb01d389",
    "readme": "README.md"
  },
  "install": {
    "steps": [
      {
        "id": "deps",
        "title": "Clone the repository",
        "commands": [
          "git clone --filter=blob:none https://github.com/Aylur/dotfiles",
          "git -C dotfiles checkout {{ref}}",
          "cd dotfiles"
        ]
      },
      {
        "id": "dotfiles",
        "title": "Follow the upstream README",
        "commands": [
          "xdg-open https://github.com/Aylur/dotfiles#readme"
        ]
      }
    ]
  }
}
