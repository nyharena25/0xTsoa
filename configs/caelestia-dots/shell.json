{
  "$schema": "../../schema/config.schema.json",
  "name": "Caelestia Shell",
  "author": {
    "name": "caelestia-dots",
    "github": "caelestia-dots"
  },
  "lang": "en",
  "summary": "Quickshell-based desktop shell for Hyprland with dashboard, launcher and dynamic colors.",
  "license": "GPL-3.0-only",
  "updatedAt": "2026-10-21",
  "distros": [
    "arch"
  ],
  "category": "dotfiles",
  "wm": "hyprland",
  "themeStyle": "material",
  "displayServer": "wayland",
  "tags": [
    "quickshell",
    "material-you",
    "dashboard"
  ],
  "screenshots": [
    {
      "url": "/screenshots/fallback-terminal.svg",
      "alt": "Caelestia Shell: no screenshot published upstream"
    }
  ],
  "source": {
    "repo": "https://github.com/caelestia-dots/shell",
    "ref": "29fcf69a3b66e98458f00e90817d5d5331bf6666",
    "readme": "README.md"
  },
  "install": {
    "steps": [
      {
        "id": "deps",
        "title": "Clone the repository",
        "commands": [
          "git clone --filter=blob:none https://github.com/caelestia-dots/shell",
          "git -C shell checkout {{ref}}",
          "cd shell"
        ]
      },
      {
        "id": "dotfiles",
        "title": "Follow the upstream README",
        "commands": [
          "xdg-open https://github.com/caelestia-dots/shell#readme"
        ]
      }
    ]
  }
}
