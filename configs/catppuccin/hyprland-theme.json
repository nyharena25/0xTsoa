{
  "$schema": "../../schema/config.schema.json",
  "name": "Catppuccin Hyprland",
  "author": {
    "name": "Catppuccin Org",
    "github": "catppuccin"
  },
  "lang": "en",
  "summary": "Soothing pastel color themes (Mocha, Macchiato, Frappe, Latte) for Hyprland.",
  "description": "The official Catppuccin port for Hyprland: color variables for the four flavors (Latte, Frappe, Macchiato, Mocha) that you load into your config and use for borders, shadows and other colors. Since Hyprland 0.55 the themes are Lua files; the older .conf version stays available on the v1.3 tag.",
  "license": "MIT",
  "version": "v2.0.0",
  "updatedAt": "2026-10-12",
  "distros": [
    "arch",
    "nixos",
    "fedora",
    "void"
  ],
  "category": "colorscheme",
  "wm": "hyprland",
  "themeStyle": "catppuccin",
  "displayServer": "wayland",
  "tags": [
    "pastel",
    "hyprland-theme",
    "4-flavors"
  ],
  "specs": {
    "bar": "Waybar Catppuccin",
    "terminal": "Kitty Catppuccin",
    "launcher": "Rofi Catppuccin",
    "notifications": "Dunst Mocha",
    "theme": "Catppuccin Mocha Pastel",
    "shell": "fish",
    "editor": "Neovim"
  },
  "screenshots": [
    {
      "url": "https://raw.githubusercontent.com/catppuccin/hyprland/9f03f26fc10a00e00ec6b2ac2a41e44d16297548/assets/mocha.webp",
      "alt": "Catppuccin Mocha theme preview for Hyprland",
      "caption": "01_CATPPUCCIN_MOCHA.RAW"
    },
    {
      "url": "https://raw.githubusercontent.com/catppuccin/hyprland/9f03f26fc10a00e00ec6b2ac2a41e44d16297548/assets/macchiato.webp",
      "alt": "Catppuccin Macchiato flavor preview",
      "caption": "02_CATPPUCCIN_MACCHIATO.RAW"
    }
  ],
  "source": {
    "repo": "https://github.com/catppuccin/hyprland",
    "ref": "9f03f26fc10a00e00ec6b2ac2a41e44d16297548",
    "readme": "README.md"
  },
  "install": {
    "steps": [
      {
        "id": "deps",
        "title": "Clone Catppuccin Hyprland repository",
        "commands": [
          "git clone https://github.com/catppuccin/hyprland.git ~/.config/hypr/catppuccin",
          "git -C ~/.config/hypr/catppuccin checkout {{ref}}"
        ]
      },
      {
        "id": "dotfiles",
        "title": "Copy the Mocha theme into your Hyprland config",
        "commands": [
          "mkdir -p ~/.config/hypr/themes",
          "cp ~/.config/hypr/catppuccin/themes/catppuccin-mocha.lua ~/.config/hypr/themes/",
          "# Then load it in ~/.config/hypr/hyprland.lua with local colors = require('themes.catppuccin-mocha') and use colors.base, colors.mauve and the other values in your color settings.",
          "# Other flavors: catppuccin-latte.lua, catppuccin-frappe.lua or catppuccin-macchiato.lua. On Hyprland older than 0.55 (hyprland.conf), use the v1.3 tag instead."
        ]
      },
      {
        "id": "reload",
        "title": "Reload Hyprland",
        "commands": [
          "hyprctl reload"
        ]
      }
    ]
  },
  "keybindings": [
    {
      "keys": "SUPER + Q",
      "action": "exec, kitty",
      "effect": "Open Kitty terminal"
    },
    {
      "keys": "SUPER + C",
      "action": "killactive",
      "effect": "Close window"
    }
  ],
  "example": false
}
