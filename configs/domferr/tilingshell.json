  "screenshots": [
    {
      "url": "https://raw.githubusercontent.com/domferr/tilingshell/de30eb72d5436424929e78b0be612114ba073a68/doc/horiz_summary.jpg",
      "alt": "Tiling Shell screenshot 1"
    },
    {
