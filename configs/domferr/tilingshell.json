  "source": {
    "repo": "https://github.com/domferr/tilingshell",
    "ref": "de30eb72d5436424929e78b0be612114ba073a68",
    "readme": "README.md"
  },
  "install": {
    "steps": [
      {
        "id": "deps",
        "title": "Install gnome-shell-extension-tilingshell (AUR)",
        "commands": [
          "yay -S gnome-shell-extension-tilingshell  # AUR",
          "# Other distros: see the upstream README"
        ]
      },
      {
        "id": "reload",
        "title": "Enable it",
        "commands": [
          "# Log out and back in, then enable it in Extension Manager or: gnome-extensions enable <uuid>"
        ]
      }
    ]
  },
  "version": "17.3"
}
