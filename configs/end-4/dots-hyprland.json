  "source": {
    "repo": "https://github.com/end-4/dots-hyprland",
    "ref": "2f2a376fdb2ad738bf55f693dd0b474b64bb0ab8",
    "readme": ".github/README.md"
  },
  "install": {
    "steps": [
      {
        "id": "deps",
        "title": "Clone repository dotfiles",
        "commands": [
          "git clone --filter=blob:none https://github.com/end-4/dots-hyprland.git ~/.config/hypr/dots",
          "git -C ~/.config/hypr/dots checkout {{ref}}"
        ]
      },
      {
        "id": "dotfiles",
        "title": "Deploy Quickshell & Hyprland configs",
        "commands": [
          "cd ~/.config/hypr/dots",
          "./setup install"
        ]
      },
      {
        "id": "reload",
        "title": "Reload compositor",
        "commands": [
          "hyprctl reload"
        ]
      }
    ]
  },
  "keybindings": [
    {
      "keys": "SUPER + RETURN",
      "action": "exec, foot",
      "effect": "Spawn terminal window"
    },
    {
      "keys": "SUPER + D",
      "action": "exec, quickshell -p appgrid",
      "effect": "Toggle app drawer"
    },
    {
      "keys": "SUPER + W",
      "action": "killactive",
      "effect": "Close focused client"
    },
    {
      "keys": "SUPER + TAB",
      "action": "exec, quickshell -p overview",
      "effect": "Interactive window overview"
    }
  ],
  "example": false
}
