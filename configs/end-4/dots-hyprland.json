    },
    {
      "url": "https://github.com/user-attachments/assets/6a32395f-9437-4192-8faf-2951a9e84cbe",
      "alt": "Quickshell Widgets and Quick Settings",
      "caption": "02_WIDGETS_PANEL.RAW"
    },
    {
      "url": "https://github.com/user-attachments/assets/c51bed8b-3670-4d4c-9074-873be224fb8e",
      "alt": "Window management and workspace overview",
      "caption": "03_WINDOW_MGMT.RAW"
    },
    {
      "url": "https://github.com/user-attachments/assets/98703a66-0743-439f-a721-cef7afa6ab95",
      "alt": "Dynamic Material Design color extraction theme",
      "caption": "04_MATERIAL_COLOR.RAW"
    },
    {
      "url": "https://raw.githubusercontent.com/end-4/dots-hyprland/2f2a376fdb2ad738bf55f693dd0b474b64bb0ab8/dots/.config/quickshell/ii/assets/images/default_wallpaper.png",
      "alt": "Default aesthetic backdrop and styling for Illogical Impulse",
      "caption": "05_DEFAULT_WALLPAPER.RAW"
