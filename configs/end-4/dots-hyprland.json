{
  "$schema": "../../schema/config.schema.json",
  "name": "Illogical Impulse Dots",
  "author": {
    "name": "end-4",
    "github": "end-4"
  },
  "lang": "en",
  "summary": "Usability-first, fluid and hyper-customized Wayland desktop configuration with Quickshell.",
  "description": "An advanced, highly interactive Linux desktop environment combining Hyprland and Quickshell. Features bespoke Material Design 3 inspired widgets, integrated quick settings, media controls, animated workspace switchers, and deep keyboard navigation workflows.",
  "license": "GPL-3.0-only",
  "version": "v3.2.0",
  "updatedAt": "2026-10-10",
  "distros": [
    "arch",
    "fedora",
    "nixos"
  ],
  "category": "dotfiles",
  "wm": "hyprland",
  "themeStyle": "minimalist",
  "displayServer": "wayland",
  "tags": [
    "quickshell",
    "material-you",
    "ai-sidebar",
    "auto-install"
  ],
  "specs": {
    "bar": "Quickshell Bar & Quick Settings",
    "terminal": "Foot / Kitty",
    "launcher": "Quickshell App Grid",
    "notifications": "Quickshell Popups",
    "theme": "Dynamic Material Colors",
    "shell": "fish + Starship",
    "editor": "Neovim",
    "ramIdleMiB": 380,
    "batteryProfile": true
  },
  "screenshots": [
    {
      "url": "https://github.com/user-attachments/assets/5d4e7d07-d0b4-4406-a4c9-ed7ba90e3fe4",
