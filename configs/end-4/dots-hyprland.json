{
  "$schema": "../../schema/config.schema.json",
  "name": "Illogical Impulse Dots",
  "author": {
    "name": "end-4",
    "github": "end-4"
  },
  "lang": "en",
  "summary": "Usability-first, fluid and hyper-customized Wayland desktop configuration with Quickshell.",
  "description": "The illogical-impulse desktop: Hyprland with a custom Quickshell interface that includes an overview of open windows with live previews, an AI sidebar (Gemini, Ollama and others), screen translation and Material colors taken from your wallpaper. It is mostly a graphical shell, not a system setup: it does not install graphics drivers or tune the system. Its installer shows every command before running it. Hyprland 0.55 changed the config format; if your distro does not ship it yet, the README points to an earlier release.",
  "license": "GPL-3.0-only",
  "updatedAt": "2026-10-10",
  "distros": [
    "arch",
    "fedora",
    "nixos"
  ],
  "category": "dotfiles",
  "wm": "hyprland",
  "themeStyle": "minimalist",
  "displayServer": "wayland",
  "tags": [
    "quickshell",
    "material-you",
    "ai-sidebar",
    "auto-install"
  ],
  "specs": {
    "bar": "Quickshell Bar & Quick Settings",
    "terminal": "Foot / Kitty",
    "launcher": "Quickshell App Grid",
    "notifications": "Quickshell Popups",
    "theme": "Dynamic Material Colors",
    "shell": "fish + Starship",
    "editor": "Neovim"
  },
