    {
      "url": "https://raw.githubusercontent.com/Gogh-Co/Gogh/2fbe9bbf3715173fc6f477d4992b66f11afca2b1/.images/demos/gogh-themes-showcase.gif",
      "alt": "gogh-themes-showcase"
