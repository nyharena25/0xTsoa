  },
  "install": {
    "steps": [
      {
        "id": "deps",
        "title": "Install curl",
        "commands": [
          "sudo pacman -S --needed curl"
        ]
      },
      {
        "id": "dotfiles",
        "title": "Run the interactive scheme picker",
        "commands": [
          "bash -c \"$(curl -fsSL https://raw.githubusercontent.com/Gogh-Co/Gogh/{{ref}}/gogh.sh)\""
        ]
      }
    ]
  }
