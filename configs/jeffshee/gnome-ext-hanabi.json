{
  "$schema": "../../schema/config.schema.json",
  "name": "Hanabi",
  "author": {
    "name": "jeffshee",
    "github": "jeffshee"
  },
  "lang": "en",
  "summary": "Live video wallpaper extension for GNOME.",
  "license": "GPL-3.0-only",
  "updatedAt": "2026-10-09",
  "distros": [
    "any"
  ],
  "category": "extension",
  "wm": "gnome",
  "themeStyle": "other",
  "displayServer": "wayland",
  "tags": [
    "gnome-shell",
    "live-wallpaper"
  ],
  "screenshots": [
    {
      "url": "/screenshots/fallback-terminal.svg",
      "alt": "Hanabi: no screenshot published upstream"
    }
  ],
  "source": {
    "repo": "https://github.com/jeffshee/gnome-ext-hanabi",
    "ref": "c18dd7666606f893e5caf4a96066975530761dc8",
    "readme": "README.md"
  },
  "install": {
    "steps": [
      {
        "id": "deps",
        "title": "Install gnome-shell-extension-hanabi-git (AUR)",
        "commands": [
          "yay -S gnome-shell-extension-hanabi-git  # AUR",
          "# Other distros: see the upstream README"
        ]
      },
      {
        "id": "reload",
        "title": "Enable it",
        "commands": [
          "# Log out and back in, then enable it in Extension Manager or: gnome-extensions enable <uuid>"
        ]
      }
    ]
  }
}
