{
  "$schema": "../../schema/config.schema.json",
  "name": "swww",
  "author": {
    "name": "LGFae",
    "github": "LGFae"
  },
  "lang": "en",
  "summary": "Animated wallpaper daemon for Wayland, controlled at runtime.",
  "license": "GPL-3.0-only",
  "updatedAt": "2025-10-31",
  "distros": [
    "any"
  ],
  "category": "tool",
  "wm": "any",
  "themeStyle": "other",
  "displayServer": "wayland",
  "tags": [
    "wallpaper",
    "animated",
    "archived"
  ],
  "screenshots": [
    {
      "url": "https://i.imgur.com/Leuh6wm.gif",
      "alt": "animated gif demonstration"
    }
  ],
  "source": {
    "repo": "https://github.com/LGFae/swww",
    "ref": "8a3b1bf9f3363683097aa5467d3058cc2278da1a",
    "readme": "README.md"
  },
  "install": {
    "steps": [
      {
        "id": "deps",
        "title": "Clone the repository",
        "commands": [
          "git clone --filter=blob:none https://github.com/LGFae/swww",
          "git -C swww checkout {{ref}}",
          "cd swww"
        ]
      },
      {
        "id": "dotfiles",
        "title": "Build and install with Cargo",
        "commands": [
          "cargo install --path ."
        ]
      }
    ]
  }
}
