  "screenshots": [
    {
      "url": "https://raw.githubusercontent.com/linuxmobile/hyprland-dots/ccf0161276fac2e87301d399609dcad377038c4e/assets/r-unixporn.webp",
      "alt": "linuxmobile Hyprland Dots screenshot 1"
    },
    {
      "url": "https://i.imgur.com/QopB79H.png",
      "alt": "linuxmobile Hyprland Dots screenshot 2"
    }
