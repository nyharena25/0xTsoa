{
  "$schema": "../../schema/config.schema.json",
  "name": "KDE Rounded Corners",
  "author": {
    "name": "matinlotfali",
    "github": "matinlotfali"
  },
  "lang": "en",
  "summary": "KWin effect that rounds window corners and adds an outline.",
  "license": "GPL-3.0-only",
  "updatedAt": "2026-10-19",
  "distros": [
    "any"
  ],
  "category": "extension",
  "wm": "kde",
  "themeStyle": "other",
  "displayServer": "both",
  "tags": [
    "kwin",
    "effects"
  ],
  "screenshots": [
    {
      "url": "https://github.com/user-attachments/assets/eb798ead-a8d7-43d1-88fa-24241aa5f33f",
      "alt": "KDE Rounded Corners screenshot 1"
    }
  ],
  "source": {
    "repo": "https://github.com/matinlotfali/KDE-Rounded-Corners",
    "ref": "66d7ce91a4f26062bba91bc7274ba85b6211391f",
    "readme": "README.md"
  },
  "install": {
    "steps": [
      {
        "id": "deps",
        "title": "Install kwin-effect-rounded-corners-git (AUR)",
        "commands": [
          "yay -S kwin-effect-rounded-corners-git  # AUR",
          "# Other distros: see the upstream README"
        ]
      },
      {
        "id": "reload",
        "title": "Enable it",
        "commands": [
          "# System Settings > Window Management > KWin Scripts / Desktop Effects: enable it",
          "qdbus org.kde.KWin /KWin reconfigure"
        ]
      }
    ]
  }
}
