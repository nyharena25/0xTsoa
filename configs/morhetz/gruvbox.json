  "install": {
    "steps": [
      {
        "id": "deps",
        "title": "Add the plugin (lazy.nvim)",
        "commands": [
          "# lua: { \"morhetz/gruvbox\", lazy = false, priority = 1000 }"
        ]
      },
      {
        "id": "reload",
        "title": "Activate the colorscheme",
        "commands": [
          "# Open Neovim and run :colorscheme gruvbox to try it; to keep it, add vim.cmd.colorscheme('gruvbox') to init.lua (or colorscheme gruvbox to init.vim)"
        ]
      }
    ]
  }
}
