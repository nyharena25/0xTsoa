{
  "$schema": "../../schema/config.schema.json",
  "name": "ML4W Dotfiles",
  "author": {
    "name": "mylinuxforwork",
    "github": "mylinuxforwork"
  },
  "lang": "en",
  "summary": "Full Hyprland desktop with a settings app, wallpaper-driven colors and guided installer.",
  "license": "GPL-3.0-only",
  "updatedAt": "2026-10-17",
  "distros": [
    "arch",
    "fedora",
    "opensuse"
  ],
  "category": "dotfiles",
  "wm": "hyprland",
  "themeStyle": "dynamic",
  "displayServer": "wayland",
  "tags": [
    "waybar",
    "rofi",
    "matugen",
    "auto-install"
  ],
  "screenshots": [
    {
      "url": "/screenshots/fallback-terminal.svg",
      "alt": "ML4W Dotfiles: no screenshot published upstream"
    }
  ],
  "source": {
    "repo": "https://github.com/mylinuxforwork/dotfiles",
    "ref": "d766383cc36092017940fdb9053f39ea4c7dfb21",
    "readme": "README.md"
  },
  "install": {
    "steps": [
      {
        "id": "deps",
        "title": "Clone the repository",
        "commands": [
          "git clone --filter=blob:none https://github.com/mylinuxforwork/dotfiles",
          "git -C dotfiles checkout {{ref}}",
          "cd dotfiles"
        ]
      },
      {
        "id": "dotfiles",
        "title": "Run the upstream installer",
        "commands": [
          "bash setup"
        ]
      }
    ]
  }
}
