{
  "$schema": "../../schema/config.schema.json",
  "name": "Nord",
  "author": {
    "name": "nordtheme",
    "github": "nordtheme"
  },
  "lang": "en",
  "summary": "Original specification of the arctic Nord palette.",
  "license": "MIT",
  "updatedAt": "2023-05-03",
  "distros": [
    "any"
  ],
  "category": "colorscheme",
  "wm": "any",
  "themeStyle": "nord",
  "displayServer": "both",
  "tags": [
    "palette"
  ],
  "screenshots": [
    {
      "url": "/screenshots/fallback-terminal.svg",
      "alt": "Nord: no screenshot published upstream"
    }
  ],
  "source": {
    "repo": "https://github.com/nordtheme/nord",
    "ref": "1cef71605416a222e57225b544540ce0fcec18d4",
    "readme": "readme.md"
  },
  "install": {
    "steps": [
      {
        "id": "deps",
        "title": "Clone the repository",
        "commands": [
          "git clone --filter=blob:none https://github.com/nordtheme/nord",
          "git -C nord checkout {{ref}}",
          "cd nord"
        ]
      },
      {
        "id": "dotfiles",
        "title": "Follow the upstream README",
        "commands": [
          "xdg-open https://github.com/nordtheme/nord#readme"
        ]
      }
    ]
  },
  "version": "v0.2.0"
}
