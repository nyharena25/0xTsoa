{
  "$schema": "../../schema/config.schema.json",
  "name": "owl4ce Openbox Dots",
  "author": {
    "name": "owl4ce",
    "github": "owl4ce"
  },
  "lang": "en",
  "summary": "Openbox rice with switchable modes, tint2/polybar panels and a matching GTK theme.",
  "license": "GPL-3.0-only",
  "updatedAt": "2022-09-29",
  "distros": [
    "any"
  ],
  "category": "dotfiles",
  "wm": "openbox",
  "themeStyle": "other",
  "displayServer": "x11",
  "tags": [
    "tint2",
    "polybar",
    "multi-theme",
    "archived"
  ],
  "screenshots": [
    {
      "url": "https://i.imgur.com/VMiaVX3.jpg",
      "alt": "owl4ce Openbox Dots screenshot 1"
    }
  ],
  "source": {
    "repo": "https://github.com/owl4ce/dotfiles",
    "ref": "c5c33b46ef90131fff88c2b9b954cab27e0b0972",
    "readme": "README.md"
  },
  "install": {
    "steps": [
      {
        "id": "deps",
        "title": "Clone with submodules",
        "commands": [
          "git clone --depth 1 --recurse-submodules https://github.com/owl4ce/dotfiles ~/owl4ce-dots"
        ]
      },
      {
        "id": "dotfiles",
        "title": "Copy the configs into $HOME",
        "commands": [
          "cp -r ~/owl4ce-dots/{.config,.local,.themes,.Xresources,.gtkrc-2.0} ~/  # back up first"
        ]
      }
    ]
  }
}
