  "install": {
    "steps": [
      {
        "id": "deps",
        "title": "Add the plugin (lazy.nvim)",
        "commands": [
          "# lua: { \"sainnhe/everforest\", lazy = false, priority = 1000 }"
        ]
      },
      {
        "id": "reload",
        "title": "Activate the colorscheme",
        "commands": [
          "nvim +\"colorscheme everforest\""
