{
  "$schema": "../../schema/config.schema.json",
  "name": "Burn My Windows",
  "author": {
    "name": "Schneegans",
    "github": "Schneegans"
  },
  "lang": "en",
  "summary": "Retro window open/close effects for GNOME Shell and KWin.",
  "license": "GPL-3.0-only",
  "updatedAt": "2026-10-21",
  "distros": [
    "any"
  ],
  "category": "extension",
  "wm": "gnome",
  "themeStyle": "other",
  "displayServer": "both",
  "tags": [
    "gnome-shell",
    "kwin",
    "effects"
  ],
  "screenshots": [
    {
      "url": "https://raw.githubusercontent.com/Schneegans/Burn-My-Windows/041c587e8294464a8e6fe8c55d6f5db95a8cda3a/docs/pics/custom.jpg",
      "alt": "Create your own effects"
    }
  ],
  "source": {
    "repo": "https://github.com/Schneegans/Burn-My-Windows",
    "ref": "abccd27ef2099e721cddcdb01417ca7f08684eac",
    "readme": "README.md"
  },
  "install": {
    "steps": [
      {
        "id": "deps",
        "title": "Install gnome-shell-extension-burn-my-windows (AUR)",
        "commands": [
          "yay -S gnome-shell-extension-burn-my-windows  # AUR",
          "# Other distros: see the upstream README"
        ]
      },
      {
        "id": "reload",
        "title": "Enable it",
        "commands": [
          "# Log out and back in, then enable it in Extension Manager or: gnome-extensions enable <uuid>"
        ]
      }
    ]
  },
  "version": "v49"
}
