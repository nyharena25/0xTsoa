{
  "$schema": "../../schema/config.schema.json",
  "name": "Tinted Theming",
  "author": {
    "name": "tinted-theming",
    "github": "tinted-theming"
  },
  "lang": "en",
  "summary": "Home of the Base16 and Base24 schemes, templates and builders.",
  "license": "MIT",
  "updatedAt": "2026-10-20",
  "distros": [
    "any"
  ],
  "category": "colorscheme",
  "wm": "any",
  "themeStyle": "other",
  "displayServer": "both",
  "tags": [
    "base16",
    "base24",
    "templates"
  ],
  "screenshots": [
    {
      "url": "https://raw.githubusercontent.com/tinted-theming/home/38fdf7d4c74417ea86f1e354c628fc2d2aeb5d96/color_wheel.png",
      "alt": "Tinted Theming screenshot 1"
    }
  ],
  "source": {
    "repo": "https://github.com/tinted-theming/home",
    "ref": "0134a6de9a3ffab7e2fcb588ab1d20a2dbda20da",
    "readme": "README.md"
  },
  "install": {
    "steps": [
      {
        "id": "deps",
        "title": "Clone the repository",
        "commands": [
          "git clone --filter=blob:none https://github.com/tinted-theming/home",
          "git -C home checkout {{ref}}",
          "cd home"
        ]
      },
      {
        "id": "dotfiles",
        "title": "Follow the upstream README",
        "commands": [
          "xdg-open https://github.com/tinted-theming/home#readme"
        ]
      }
    ]
  }
}
