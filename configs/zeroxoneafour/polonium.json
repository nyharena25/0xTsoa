{
  "$schema": "../../schema/config.schema.json",
  "name": "Polonium",
  "author": {
    "name": "zeroxoneafour",
    "github": "zeroxoneafour"
  },
  "lang": "en",
  "summary": "Auto-tiling KWin script, successor in spirit to Bismuth.",
  "license": "MIT",
  "updatedAt": "2026-09-08",
  "distros": [
    "any"
  ],
  "category": "extension",
  "wm": "kde",
  "themeStyle": "other",
  "displayServer": "both",
  "tags": [
    "kwin",
    "tiling"
  ],
  "screenshots": [
    {
      "url": "/screenshots/fallback-terminal.svg",
      "alt": "Polonium: no screenshot published upstream"
    }
  ],
  "source": {
    "repo": "https://github.com/zeroxoneafour/polonium",
    "ref": "cc08350138a2b191428121076ea2c2291e2c59d3",
    "readme": "readme.md"
  },
  "install": {
    "steps": [
      {
        "id": "deps",
        "title": "Install kwin-polonium (AUR)",
        "commands": [
          "yay -S kwin-polonium  # AUR",
          "# Other distros: see the upstream README"
        ]
      },
      {
        "id": "reload",
        "title": "Enable it",
        "commands": [
          "# System Settings > Window Management > KWin Scripts / Desktop Effects: enable it",
          "qdbus org.kde.KWin /KWin reconfigure"
        ]
      }
    ]
  },
  "version": "v1.2.2"
}
