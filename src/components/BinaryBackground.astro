---
// Full-page binary background: slow columns of 0 and 1, almost invisible. One fixed canvas behind
// all content (z-index -1, pointer-events none); colour, speed and size come from the --binary-*
// variables in src/styles/global.css. Reduced motion: one frozen frame.
---

<canvas id="binary-bg" aria-hidden="true"></canvas>

<style>
  #binary-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
</style>

<script>
  function initBinaryBackground() {
    const canvas = document.getElementById('binary-bg') as HTMLCanvasElement | null;
    if (!canvas || canvas.dataset.bound) return;
    canvas.dataset.bound = 'true';
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const css = getComputedStyle(document.documentElement);
    const read = (name: string, fallback: string) => css.getPropertyValue(name).trim() || fallback;
    const COLOR = read('--binary-rest', '#F1EFE8');
    const SPEED = Number.parseFloat(read('--binary-speed', '14')); // px per second, average column
    const FONT_SIZE = Number.parseFloat(read('--binary-font-size', '13'));
    const FONT = `300 ${FONT_SIZE}px ${read('--font-mono', 'monospace')}`;
    const CELL_W = Math.round(FONT_SIZE * 1.15);
    const CELL_H = Math.round(FONT_SIZE * 1.6);

    // Pre-rendered glyphs: drawImage of a sprite is far cheaper than thousands of fillText calls.
    let sprites: HTMLCanvasElement[] = []; // [digit]
    let dpr = 1;
    let cols = 0;
    let rows = 0;
    let digits: Uint8Array = new Uint8Array(0); // column-major, `rows` per column
    let offsets: Float32Array = new Float32Array(0);
    let speeds: Float32Array = new Float32Array(0);
    let last = performance.now();
    let frame = 0;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    function buildSprites() {
      sprites = ['0', '1'].map((digit) => {
        const sprite = document.createElement('canvas');
        sprite.width = Math.ceil(CELL_W * dpr);
        sprite.height = Math.ceil(CELL_H * dpr);
        const s = sprite.getContext('2d')!;
        s.scale(dpr, dpr);
        s.font = FONT;
        s.fillStyle = COLOR;
        s.textAlign = 'center';
        s.textBaseline = 'middle';
        s.fillText(digit, CELL_W / 2, CELL_H / 2);
        return sprite;
      });
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = window.innerWidth;
      const h = window.innerHeight;
      canvas!.width = Math.ceil(w * dpr);
      canvas!.height = Math.ceil(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(w / CELL_W);
      rows = Math.ceil(h / CELL_H) + 1;
      digits = new Uint8Array(cols * rows).map(() => (Math.random() < 0.5 ? 0 : 1));
      offsets = new Float32Array(cols).map(() => Math.random() * CELL_H);
      // Each column drifts at its own pace, between 0.5x and 1.5x the average speed.
      speeds = new Float32Array(cols).map(() => SPEED * (0.5 + Math.random()));
      buildSprites();
      draw(0);
    }

    function draw(dt: number) {
      ctx!.clearRect(0, 0, window.innerWidth, window.innerHeight);
      for (let c = 0; c < cols; c++) {
        offsets[c] += speeds[c] * (dt / 1000);
        // A full cell scrolled past: shift the column down by one and add a fresh digit on top.
        while (offsets[c] >= CELL_H) {
          offsets[c] -= CELL_H;
          const base = c * rows;
          digits.copyWithin(base + 1, base, base + rows - 1);
          digits[base] = Math.random() < 0.5 ? 0 : 1;
        }
        const x = c * CELL_W;
        for (let r = 0; r < rows; r++) {
          const y = (r - 1) * CELL_H + offsets[c];
          ctx!.drawImage(sprites[digits[c * rows + r]], x, y, CELL_W, CELL_H);
        }
      }
    }

    function loop(now: number) {
      const dt = Math.min(now - last, 100); // a background tab must not make the columns jump
      last = now;
      draw(dt);
      frame = requestAnimationFrame(loop);
    }

    function start() {
      cancelAnimationFrame(frame);
      if (reduced.matches) {
        draw(0); // frozen: one static frame
        return;
      }
      last = performance.now();
      frame = requestAnimationFrame(loop);
    }

    let resizeQueued = false;
    window.addEventListener('resize', () => {
      if (resizeQueued) return;
      resizeQueued = true;
      requestAnimationFrame(() => {
        resizeQueued = false;
        resize();
      });
    });
    reduced.addEventListener('change', start);

    resize();
    // Redraw the sprites once the mono font has loaded, so digits never use the fallback face.
    document.fonts?.load(FONT).then(() => {
      buildSprites();
      draw(0);
    });
    start();
  }

  initBinaryBackground();
  document.addEventListener('astro:page-load', initBinaryBackground);
</script>
