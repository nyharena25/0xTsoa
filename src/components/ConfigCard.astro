---
import { getVotesForConfig } from '../lib/votes';
import { getStarsForConfig } from '../lib/stats';
import { type ConfigData, WM_LABELS, STYLE_LABELS, CATEGORY_LABELS } from '../lib/schema';
import { withBase } from '../../site.config';
import AssuranceBadges from './AssuranceBadges.astro';

interface Props {
  id: string;
  data: ConfigData;
  locale?: string;
}

const { id, data } = Astro.props;

const votes = getVotesForConfig(id);
const stars = getStarsForConfig(id);
const specUrl = withBase(`/configs/${id}/`);
const primaryShot = data.screenshots[0];
const wmLabel = WM_LABELS[data.wm] || data.wm;
---

<article class="bg-white border border-zinc-200 rounded-xl p-4 sm:p-6 shadow-xs hover:shadow-md hover:border-zinc-300 transition-all duration-200 group w-full max-w-full overflow-hidden">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-6 items-center w-full min-w-0">
    <!-- Left Details Column (7 cols on lg, 8 on xl) -->
    <div class="lg:col-span-7 xl:col-span-8 flex flex-col justify-between h-full min-w-0 w-full">
      <div>
        <!-- Badges Row -->
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <a href={`?category=${data.category}`} class="px-2 py-0.5 rounded text-[11px] font-mono font-bold uppercase tracking-wider bg-zinc-900 text-white hover:bg-zinc-700">
            {CATEGORY_LABELS[data.category]}
          </a>
          {data.themeStyle !== 'other' && (
            <span class="px-2 py-0.5 rounded text-[11px] font-mono font-medium bg-zinc-100 text-zinc-700 border border-zinc-200">
              {STYLE_LABELS[data.themeStyle]}
            </span>
          )}
          <span class="px-2 py-0.5 rounded text-[11px] font-mono font-medium bg-zinc-100 text-zinc-700 border border-zinc-200">
            {wmLabel} ({data.displayServer})
          </span>
          <AssuranceBadges data={data} compact />
        </div>

        <!-- Title -->
        <h2 class="font-display text-xl font-bold tracking-tight text-zinc-900 group-hover:text-zinc-700 transition-colors">
          <a href={specUrl} class="hover:underline flex items-center gap-2">
            <span>{data.author.name} / {data.name}</span>
            <span class="font-mono text-sm group-hover:translate-x-1 transition-transform">&rarr;</span>
          </a>
        </h2>

        <!-- Summary Description -->
        <p class="font-sans text-sm text-zinc-600 mt-2 leading-relaxed">
          {data.summary}
        </p>

        <!-- High-Contrast Accessible Tag Pills (WCAG AAA compliant) -->
        <div class="flex flex-wrap items-center gap-1.5 mt-3.5">
          {data.tags.map((tag) => (
            <a
              href={`?tag=${tag}`}
              class="tag-pill"
            >
              #{tag}
            </a>
          ))}
        </div>
      </div>

      <!-- Card Metadata Footer -->
      <div class="font-mono text-xs flex flex-wrap items-center gap-y-2 gap-x-3 text-zinc-500 pt-4 border-t border-zinc-100 mt-5">
        <span class="font-semibold text-zinc-800 flex items-center gap-1">
          <span class="text-emerald-600 font-bold">▲</span> {votes.toLocaleString()} approved
        </span>
        <span class="text-zinc-300">|</span>
        <span title="GitHub stars upstream">★ {stars.toLocaleString()}</span>
        <span class="text-zinc-300">|</span>
        <span>{data.updatedAt}</span>
        {data.version && (
          <>
            <span class="text-zinc-300">|</span>
            <span class="px-1.5 py-0.2 rounded bg-zinc-100 font-mono text-[11px] text-zinc-700 border border-zinc-200">
              {data.version}
            </span>
          </>
        )}
        <a
          href={data.source.repo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 min-h-[36px] sm:ml-auto text-xs font-mono font-semibold rounded-md bg-white border border-zinc-300 text-zinc-800 hover:bg-zinc-900 hover:text-white hover:border-zinc-900 transition-colors shadow-xs cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          <span>Repo</span>
        </a>
      </div>
    </div>

    <!-- Right Preview Thumbnail (5 cols on lg, 4 on xl) -->
    <div class="lg:col-span-5 xl:col-span-4 order-first lg:order-last w-full min-w-0">
      <a
        href={specUrl}
        class="block w-full max-w-full aspect-video rounded-lg overflow-hidden border border-zinc-200 bg-zinc-950 relative group/thumb shadow-xs cursor-pointer"
      >
        <img
          src={primaryShot?.url ? (primaryShot.url.startsWith('/') ? withBase(primaryShot.url) : primaryShot.url) : withBase('/screenshots/fallback-terminal.svg')}
          alt={primaryShot?.alt || `${data.name} preview`}
          width="1280"
          height="720"
          loading="lazy"
          class="w-full h-auto min-h-[160px] sm:min-h-0 sm:h-full object-cover group-hover/thumb:scale-[1.03] transition-transform duration-300"
        />
        <div class="absolute inset-0 bg-zinc-950/60 opacity-0 group-hover/thumb:opacity-100 flex items-center justify-center p-2 transition-opacity duration-200">
          <span class="px-3 py-1.5 bg-white text-zinc-900 rounded-md font-mono text-xs font-semibold shadow-md">
            View full spec →
          </span>
        </div>
      </a>
    </div>
  </div>
</article>
