---
// One catalogue result: preview, name and summary first, then the facts that decide a click
// (difficulty, maintenance, stars). Trust details and repository links live on the config page.
import { getVotesForConfig, getDiscussionUrlForConfig, upvoteLabel } from '../lib/votes';
import { useTranslations } from '../lib/i18n';
import { getStarsForConfig, maintenanceForConfig, MAINTENANCE_INFO } from '../lib/stats';
import { installDifficulty, DIFFICULTY_INFO } from '../lib/install';
import { type ConfigData, WM_LABELS, STYLE_LABELS, CATEGORY_LABELS } from '../lib/schema';
import { withBase } from '../../site.config';

interface Props {
  id: string;
  data: ConfigData;
  locale?: string;
}

const { id, data, locale } = Astro.props;
const t = useTranslations(locale);

const votes = getVotesForConfig(id);
const voteUrl = getDiscussionUrlForConfig(id);
const stars = getStarsForConfig(id);
const difficulty = installDifficulty(data);
const maintenance = maintenanceForConfig(id, data.tags);
const specUrl = withBase(`/configs/${id}/`);
const primaryShot = data.screenshots[0];
const thumbUrl = primaryShot.url.startsWith('/') ? withBase(primaryShot.url) : primaryShot.url;
// The four most telling tags; the rest are on the config page and still searchable.
const tags = data.tags.filter((t) => t !== 'archived').slice(0, 4);
const updated = new Date(`${data.updatedAt}T00:00:00Z`).toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const chip = 'px-2 py-0.5 rounded text-[11px] font-mono font-medium bg-zinc-100 text-zinc-700 border border-zinc-200 hover:border-zinc-900 hover:text-zinc-900';
---

<article class="group bg-white border border-zinc-200 rounded-xl p-3 sm:p-4 shadow-xs hover:shadow-md hover:border-zinc-300 transition-[box-shadow,border-color] duration-200 w-full max-w-full overflow-hidden">
  <div class="grid grid-cols-1 sm:grid-cols-[minmax(0,15rem)_minmax(0,1fr)] gap-4 sm:gap-5 items-start">
    <a href={specUrl} tabindex="-1" aria-hidden="true" class="block w-full aspect-video rounded-lg overflow-hidden border border-zinc-200 bg-zinc-950">
      <img
        src={thumbUrl}
        alt=""
        width="480"
        height="270"
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
      />
    </a>

    <div class="flex flex-col gap-2 min-w-0">
      <div class="flex flex-wrap items-center gap-1.5">
        <a href={`?category=${data.category}`} rel="nofollow" class="px-2 py-0.5 rounded text-[11px] font-mono font-bold uppercase tracking-wider bg-zinc-900 text-white hover:bg-zinc-700">
          {CATEGORY_LABELS[data.category]}
        </a>
        {data.wm !== 'any' && <a href={`?wm=${data.wm}`} rel="nofollow" class={chip}>{WM_LABELS[data.wm]}</a>}
        {data.themeStyle !== 'other' && <a href={`?style=${data.themeStyle}`} rel="nofollow" class={chip}>{STYLE_LABELS[data.themeStyle]}</a>}
      </div>

      <h2 class="font-display text-lg sm:text-xl font-bold tracking-tight text-zinc-900 m-0 break-words">
        <a href={specUrl} class="hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-900 rounded-sm">{data.name}</a>
      </h2>
      <p class="font-sans text-sm text-zinc-600 leading-relaxed m-0">{data.summary}</p>

      <ul class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px] text-zinc-600 pt-1" aria-label="Key facts">
        {difficulty ? (
          <li class="inline-flex items-center gap-1.5 font-semibold text-zinc-900" title={DIFFICULTY_INFO[difficulty].text}>
            <span class={`w-2 h-2 rounded-full inline-block ${DIFFICULTY_INFO[difficulty].dot}`} aria-hidden="true"></span>
            {DIFFICULTY_INFO[difficulty].label}
          </li>
        ) : (
          <li class="font-semibold text-zinc-900">Reading list</li>
        )}
        {maintenance && (
          <li class="inline-flex items-center gap-1.5">
            <span class={`w-2 h-2 rounded-full inline-block ${MAINTENANCE_INFO[maintenance].dot}`} aria-hidden="true"></span>
            {MAINTENANCE_INFO[maintenance].label}
          </li>
        )}
        {stars > 0 && <li><span aria-hidden="true">★</span> {stars.toLocaleString('en')}<span class="sr-only"> GitHub stars</span></li>}
        <li>
          <a
            href={voteUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 hover:text-zinc-900 hover:underline"
            title={`${t('vote.button')}: ${t('vote.hint')}`}
          >
            <span aria-hidden="true">▲</span> {votes > 0 ? upvoteLabel(votes) : t('vote.short')}
          </a>
        </li>
        <li>by @{data.author.github}{data.author.verified && <span class="text-emerald-700 font-semibold" title="Verified by author"> ✓<span class="sr-only"> verified by author</span></span>}</li>
        <li>{updated}</li>
      </ul>

      {tags.length > 0 && (
        <div class="flex flex-wrap items-center gap-1.5">
          {tags.map((tag) => <a href={`?tag=${tag}`} rel="nofollow" class="tag-pill">#{tag}</a>)}
        </div>
      )}
    </div>
  </div>
</article>
