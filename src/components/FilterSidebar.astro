---
import { useTranslations, type Locale } from '../lib/i18n';
import { withBase } from '../../site.config';
import TopicLinks from './TopicLinks.astro';
import { WM_LABELS, DISTRO_LABELS, STYLE_LABELS, CATEGORIES, CATEGORY_LABELS } from '../lib/schema';

interface FacetCounts {
  categories: Record<string, number>;
  wms: Record<string, number>;
  styles: Record<string, number>;
  distros: Record<string, number>;
}

interface Props {
  counts: FacetCounts;
  locale?: Locale;
}

const { counts } = Astro.props;
const t = useTranslations('en');

// Fixed schema order (not by count) so each part of the desktop stays in a predictable place.
const categories = CATEGORIES.filter((c) => counts.categories[c]).map((c) => [c, counts.categories[c]] as const);

const allWms = Object.entries(counts.wms).sort((a, b) => b[1] - a[1]);
const topWms = allWms.slice(0, 8);
const restWms = allWms.slice(8);

const allStyles = Object.entries(counts.styles).sort((a, b) => b[1] - a[1]);
const topStyles = allStyles.slice(0, 8);
const restStyles = allStyles.slice(8);

const allDistros = Object.entries(counts.distros).sort((a, b) => b[1] - a[1]);
const topDistros = allDistros.slice(0, 8);
const restDistros = allDistros.slice(8);
---

<aside class="w-full flex flex-col gap-4">
  <div class="bg-white border border-zinc-200 rounded-xl p-5 shadow-xs">
    <div class="flex items-center justify-between border-b border-zinc-200 pb-3 mb-4">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-zinc-900"></span>
        <h2 class="font-mono text-xs font-bold uppercase tracking-wider text-zinc-900">
          {t('catalogue.quickFilters')}
        </h2>
      </div>
      <a
        href="?"
        id="btn-reset-filters"
        class="font-mono text-xs text-zinc-500 hover:text-zinc-900 underline cursor-pointer"
      >
        {t('catalogue.reset')}
      </a>
    </div>

    <!-- Section 0: Desktop part (category) -->
    <div class="mb-5">
      <div class="font-mono text-xs font-bold uppercase tracking-wider text-zinc-700 mb-2.5 flex items-center justify-between">
        <span>{t('catalogue.categorySection')}</span>
        <span class="text-[11px] text-zinc-400 font-normal">({categories.length})</span>
      </div>
      <ul class="space-y-2 font-mono text-xs">
        {categories.map(([key, count]) => (
          <li>
            <label class="flex items-center justify-between group cursor-pointer select-none py-1.5 min-h-[36px]">
              <div class="flex items-center gap-2.5">
                <input
                  type="checkbox"
                  name="category"
                  value={key}
                  class="filter-checkbox w-4 h-4 rounded border-zinc-300 text-zinc-900 focus:ring-1 focus:ring-zinc-900 cursor-pointer"
                />
                <span class="text-zinc-800 group-hover:text-zinc-950 font-medium">{CATEGORY_LABELS[key]}</span>
              </div>
              <span class="text-zinc-400 font-normal">({count})</span>
            </label>
          </li>
        ))}
      </ul>
    </div>

    <!-- Section 1: WM / Compositors -->
    <div class="pt-4 border-t border-zinc-100 mb-5">
      <div class="font-mono text-xs font-bold uppercase tracking-wider text-zinc-700 mb-2.5 flex items-center justify-between">
        <span>{t('catalogue.wmSection')}</span>
        <span class="text-[11px] text-zinc-400 font-normal">({allWms.length})</span>
      </div>
      <ul class="space-y-2 font-mono text-xs">
        {topWms.map(([wmKey, count]) => (
          <li>
            <label class="flex items-center justify-between group cursor-pointer select-none py-1.5 min-h-[36px]">
              <div class="flex items-center gap-2.5">
                <input
                  type="checkbox"
                  name="wm"
                  value={wmKey}
                  class="filter-checkbox w-4 h-4 rounded border-zinc-300 text-zinc-900 focus:ring-1 focus:ring-zinc-900 cursor-pointer"
                />
                <span class="text-zinc-800 group-hover:text-zinc-950 font-medium">
                  {WM_LABELS[wmKey as keyof typeof WM_LABELS] || wmKey}
                </span>
              </div>
              <span class="text-zinc-400 font-normal">({count})</span>
            </label>
          </li>
        ))}
      </ul>
      {restWms.length > 0 && (
        <details class="mt-2 font-mono text-xs">
          <summary class="cursor-pointer select-none text-zinc-500 hover:text-zinc-900 py-1 font-semibold">
            Show all
          </summary>
          <ul class="space-y-2 font-mono text-xs mt-2">
            {restWms.map(([wmKey, count]) => (
              <li>
                <label class="flex items-center justify-between group cursor-pointer select-none py-1.5 min-h-[36px]">
                  <div class="flex items-center gap-2.5">
                    <input
                      type="checkbox"
                      name="wm"
                      value={wmKey}
                      class="filter-checkbox w-4 h-4 rounded border-zinc-300 text-zinc-900 focus:ring-1 focus:ring-zinc-900 cursor-pointer"
                    />
                    <span class="text-zinc-800 group-hover:text-zinc-950 font-medium">
                      {WM_LABELS[wmKey as keyof typeof WM_LABELS] || wmKey}
                    </span>
                  </div>
                  <span class="text-zinc-400 font-normal">({count})</span>
                </label>
              </li>
            ))}
          </ul>
        </details>
      )}
    </div>

    <!-- Section 2: Styles / Themes -->
    <div class="pt-4 border-t border-zinc-100 mb-5">
      <div class="font-mono text-xs font-bold uppercase tracking-wider text-zinc-700 mb-2.5 flex items-center justify-between">
        <span>{t('catalogue.styleSection')}</span>
        <span class="text-[11px] text-zinc-400 font-normal">({allStyles.length})</span>
      </div>
      <ul class="space-y-2 font-mono text-xs">
        {topStyles.map(([styleKey, count]) => (
          <li>
            <label class="flex items-center justify-between group cursor-pointer select-none py-1.5 min-h-[36px]">
              <div class="flex items-center gap-2.5">
                <input
                  type="checkbox"
                  name="style"
                  value={styleKey}
                  class="filter-checkbox w-4 h-4 rounded border-zinc-300 text-zinc-900 focus:ring-1 focus:ring-zinc-900 cursor-pointer"
                />
                <span class="text-zinc-800 group-hover:text-zinc-950 font-medium">
                  {STYLE_LABELS[styleKey as keyof typeof STYLE_LABELS] || styleKey}
                </span>
              </div>
              <span class="text-zinc-400 font-normal">({count})</span>
            </label>
          </li>
        ))}
      </ul>
      {restStyles.length > 0 && (
        <details class="mt-2 font-mono text-xs">
          <summary class="cursor-pointer select-none text-zinc-500 hover:text-zinc-900 py-1 font-semibold">
            Show all
          </summary>
          <ul class="space-y-2 font-mono text-xs mt-2">
            {restStyles.map(([styleKey, count]) => (
              <li>
                <label class="flex items-center justify-between group cursor-pointer select-none py-1.5 min-h-[36px]">
                  <div class="flex items-center gap-2.5">
                    <input
                      type="checkbox"
                      name="style"
                      value={styleKey}
                      class="filter-checkbox w-4 h-4 rounded border-zinc-300 text-zinc-900 focus:ring-1 focus:ring-zinc-900 cursor-pointer"
                    />
                    <span class="text-zinc-800 group-hover:text-zinc-950 font-medium">
                      {STYLE_LABELS[styleKey as keyof typeof STYLE_LABELS] || styleKey}
                    </span>
                  </div>
                  <span class="text-zinc-400 font-normal">({count})</span>
                </label>
              </li>
            ))}
          </ul>
        </details>
      )}
    </div>

    <!-- Section 3: Distros -->
    <div class="pt-4 border-t border-zinc-100 mb-5">
      <div class="font-mono text-xs font-bold uppercase tracking-wider text-zinc-700 mb-2.5 flex items-center justify-between">
        <span>{t('catalogue.distroSection')}</span>
        <span class="text-[11px] text-zinc-400 font-normal">({allDistros.length})</span>
      </div>
      <ul class="space-y-2 font-mono text-xs">
        {topDistros.map(([distroKey, count]) => (
          <li>
            <label class="flex items-center justify-between group cursor-pointer select-none py-1.5 min-h-[36px]">
              <div class="flex items-center gap-2.5">
                <input
                  type="checkbox"
                  name="distro"
                  value={distroKey}
                  class="filter-checkbox w-4 h-4 rounded border-zinc-300 text-zinc-900 focus:ring-1 focus:ring-zinc-900 cursor-pointer"
                />
                <span class="text-zinc-800 group-hover:text-zinc-950 font-medium">
                  {DISTRO_LABELS[distroKey as keyof typeof DISTRO_LABELS] || distroKey}
                </span>
              </div>
              <span class="text-zinc-400 font-normal">({count})</span>
            </label>
          </li>
        ))}
      </ul>
      {restDistros.length > 0 && (
        <details class="mt-2 font-mono text-xs">
          <summary class="cursor-pointer select-none text-zinc-500 hover:text-zinc-900 py-1 font-semibold">
            Show all
          </summary>
          <ul class="space-y-2 font-mono text-xs mt-2">
            {restDistros.map(([distroKey, count]) => (
              <li>
                <label class="flex items-center justify-between group cursor-pointer select-none py-1.5 min-h-[36px]">
                  <div class="flex items-center gap-2.5">
                    <input
                      type="checkbox"
                      name="distro"
                      value={distroKey}
                      class="filter-checkbox w-4 h-4 rounded border-zinc-300 text-zinc-900 focus:ring-1 focus:ring-zinc-900 cursor-pointer"
                    />
                    <span class="text-zinc-800 group-hover:text-zinc-950 font-medium">
                      {DISTRO_LABELS[distroKey as keyof typeof DISTRO_LABELS] || distroKey}
                    </span>
                  </div>
                  <span class="text-zinc-400 font-normal">({count})</span>
                </label>
              </li>
            ))}
          </ul>
        </details>
      )}
    </div>
  </div>

  <!-- Guides: the Docs pages for the same facets -->
  <nav aria-label="Guides" class="bg-white border border-zinc-200 rounded-xl p-5 shadow-xs font-mono text-xs flex flex-col gap-3">
    <h2 class="font-bold uppercase tracking-wider text-zinc-900 m-0">Guides</h2>
    <p class="font-sans text-xs text-zinc-600 leading-relaxed m-0">Each guide compares every entry for one topic: difficulty, what it changes, how to undo it.</p>
    <TopicLinks variant="inline" />
    <a href={withBase('/docs/')} class="font-semibold text-zinc-900 underline">All guides &rarr;</a>
  </nav>
</aside>
