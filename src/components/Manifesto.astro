---
import { useTranslations } from '../lib/i18n';

interface Props {
  locale?: string;
}

const t = useTranslations('en');
---

<section class="w-full bg-white border border-zinc-200 rounded-xl shadow-xs flex flex-col overflow-hidden" id="section-manifesto">
  <div class="bg-zinc-50 border-b border-zinc-200 p-4 sm:p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
    <div class="flex items-center gap-2.5">
      <span class="w-2 h-2 rounded-full bg-zinc-900 inline-block"></span>
      <h3 class="font-display text-base uppercase tracking-tight text-zinc-900 font-bold">
        {t('manifesto.heading')}
      </h3>
    </div>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="manifesto-scroll-left"
        aria-label="Previous manifesto card"
        class="w-8 h-8 rounded-lg border border-zinc-200 bg-white hover:bg-zinc-100 text-zinc-700 flex items-center justify-center shadow-2xs transition-colors cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button
        type="button"
        id="manifesto-scroll-right"
        aria-label="Next manifesto card"
        class="w-8 h-8 rounded-lg border border-zinc-200 bg-white hover:bg-zinc-100 text-zinc-700 flex items-center justify-center shadow-2xs transition-colors cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>

  <div class="p-4 sm:p-6 bg-zinc-50/50">
    <div class="flex items-stretch gap-4 overflow-x-auto pb-3 select-none" id="manifesto-track">
      <!-- Article 01 -->
      <article class="w-80 sm:w-96 shrink-0 border border-zinc-200 bg-white rounded-xl p-5 shadow-xs flex flex-col justify-between gap-4 hover:border-zinc-300 hover:shadow-card transition-all">
        <div class="flex flex-col gap-2.5">
          <div class="flex items-center justify-between border-b border-zinc-100 pb-2.5">
            <span class="font-mono text-xs font-bold uppercase tracking-wider text-zinc-900">01 // Architecture</span>
            <span class="bg-zinc-900 text-white text-[10px] font-mono px-2 py-0.5 rounded font-medium uppercase tracking-wider">REGISTRY</span>
          </div>
          <h4 class="font-display text-base font-bold text-zinc-900 uppercase tracking-tight mt-1">
            {t('manifesto.card1Title')}
          </h4>
          <p class="font-sans text-sm text-zinc-600 leading-relaxed">
            <span class="font-brick font-normal text-zinc-950 text-base tracking-wide inline-block mr-1">0xTsoa</span>{t('manifesto.card1Text').replace(/^0xTsoa\s*/, ' ')}
          </p>
        </div>
        <div class="pt-3 border-t border-zinc-100 flex items-center justify-between font-mono text-[11px] text-zinc-400 uppercase">
          <span>{t('manifesto.card1Stat')}</span>
          <span>ART_01</span>
        </div>
      </article>

      <!-- Article 02 -->
      <article class="w-80 sm:w-96 shrink-0 border border-zinc-200 bg-white rounded-xl p-5 shadow-xs flex flex-col justify-between gap-4 hover:border-zinc-300 hover:shadow-card transition-all">
        <div class="flex flex-col gap-2.5">
          <div class="flex items-center justify-between border-b border-zinc-100 pb-2.5">
            <span class="font-mono text-xs font-bold uppercase tracking-wider text-zinc-900">02 // Curation</span>
            <span class="bg-zinc-100 border border-zinc-200 text-zinc-700 text-[10px] font-mono px-2 py-0.5 rounded font-medium uppercase tracking-wider">CURATION</span>
          </div>
          <h4 class="font-display text-base font-bold text-zinc-900 uppercase tracking-tight mt-1">
            {t('manifesto.card2Title')}
          </h4>
          <p class="font-sans text-sm text-zinc-600 leading-relaxed">
            {t('manifesto.card2Text')}
          </p>
        </div>
        <div class="pt-3 border-t border-zinc-100 flex items-center justify-between font-mono text-[11px] text-zinc-400 uppercase">
          <span>{t('manifesto.card2Stat')}</span>
          <span>ART_02</span>
        </div>
      </article>

      <!-- Article 03 -->
      <article class="w-80 sm:w-96 shrink-0 border border-zinc-200 bg-white rounded-xl p-5 shadow-xs flex flex-col justify-between gap-4 hover:border-zinc-300 hover:shadow-card transition-all">
        <div class="flex flex-col gap-2.5">
          <div class="flex items-center justify-between border-b border-zinc-100 pb-2.5">
            <span class="font-mono text-xs font-bold uppercase tracking-wider text-zinc-900">03 // Workflow</span>
            <span class="bg-zinc-900 text-white text-[10px] font-mono px-2 py-0.5 rounded font-medium uppercase tracking-wider">1-LINE</span>
          </div>
          <h4 class="font-display text-base font-bold text-zinc-900 uppercase tracking-tight mt-1">
            {t('manifesto.card3Title')}
          </h4>
          <p class="font-sans text-sm text-zinc-600 leading-relaxed whitespace-pre-line">
            {t('manifesto.card3Text')}
          </p>
        </div>
        <div class="pt-3 border-t border-zinc-100 flex items-center justify-between font-mono text-[11px] text-zinc-400 uppercase">
          <span>{t('manifesto.card3Stat')}</span>
          <span>ART_03</span>
        </div>
      </article>

      <!-- Article 04 -->
      <article class="w-80 sm:w-96 shrink-0 border border-zinc-200 bg-white rounded-xl p-5 shadow-xs flex flex-col justify-between gap-4 hover:border-zinc-300 hover:shadow-card transition-all">
        <div class="flex flex-col gap-2.5">
          <div class="flex items-center justify-between border-b border-zinc-100 pb-2.5">
            <span class="font-mono text-xs font-bold uppercase tracking-wider text-zinc-900">04 // Jamstack</span>
            <span class="bg-zinc-100 border border-zinc-200 text-zinc-700 text-[10px] font-mono px-2 py-0.5 rounded font-medium uppercase tracking-wider">ZERO_DB</span>
          </div>
          <h4 class="font-display text-base font-bold text-zinc-900 uppercase tracking-tight mt-1">
            DECENTRALIZED & ZERO SIGN-UP
          </h4>
          <p class="font-sans text-sm text-zinc-600 leading-relaxed">
            No account required. Zero tracking, zero opaque databases: configurations and community votes live directly and transparently on GitHub.
          </p>
        </div>
        <div class="pt-3 border-t border-zinc-100 flex items-center justify-between font-mono text-[11px] text-zinc-400 uppercase">
          <span>GITHUB PR & DISCUSSIONS</span>
          <span>ART_04</span>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('manifesto-track');
  document.getElementById('manifesto-scroll-left')?.addEventListener('click', () => {
    track?.scrollBy({ left: -340, behavior: 'smooth' });
  });
  document.getElementById('manifesto-scroll-right')?.addEventListener('click', () => {
    track?.scrollBy({ left: 340, behavior: 'smooth' });
  });
</script>
