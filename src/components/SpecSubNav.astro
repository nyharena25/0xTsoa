---
import { getVotesForConfig, getDiscussionUrlForConfig } from '../lib/votes';
import { withBase } from '../../site.config';

interface Props {
  configId: string;
  name: string;
  /** Sections actually rendered on the page, already numbered (e.g. "03. Screenshot Gallery"). */
  sections: { id: string; title: string }[];
  locale?: string;
  /** Where "back" goes: the entry's topic page, or the catalogue. */
  parent?: { label: string; href: string };
}

const { configId, name, sections, parent } = Astro.props;

const votes = getVotesForConfig(configId);
const discussionUrl = getDiscussionUrlForConfig(configId);
const backHref = parent?.href ?? withBase('/catalogue/');
const backLabel = parent?.label ?? 'Catalogue';
---

<div class="sticky top-16 z-40 bg-white/95 backdrop-blur-md border-b border-zinc-200 py-2.5 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col gap-2">
    <!-- Top breadcrumb and actions bar -->
    <div class="flex items-center justify-between gap-2 text-xs font-mono">
      <div class="flex items-center gap-1.5 min-w-0">
        <a
          href={backHref}
          class="inline-flex items-center gap-1 text-zinc-600 hover:text-zinc-900 font-medium transition-colors shrink-0"
          title={`Back to ${backLabel}`}
        >
          <span>&larr;</span>
          <span class="hidden sm:inline">{backLabel}</span>
        </a>
        <span class="text-zinc-300">/</span>
        <span class="text-zinc-900 font-bold truncate text-xs font-mono">{name}</span>
      </div>

      <div class="flex items-center gap-1.5 shrink-0">
        <span class="inline-flex items-center gap-1 px-2 sm:px-2.5 py-1 rounded-md font-mono text-xs font-bold bg-zinc-100 text-zinc-900 border border-zinc-200">
          ▲ {votes.toLocaleString()}
        </span>

        <a
          href={discussionUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-solid text-xs py-1 px-2 sm:px-2.5"
          title="Sign off: react with +1 on this config's GitHub vote issue"
        >
          <span>✓</span>
          <span class="hidden sm:inline">Sign-Off</span>
        </a>
      </div>
    </div>

    <!-- Quick anchor jump pills -->
    <div class="flex items-center gap-1.5 overflow-x-auto pt-1 pb-0.5 font-mono text-xs whitespace-nowrap scrollbar-none -mx-4 px-4 sm:mx-0 sm:px-0">
      {sections.map((s) => (
        <a href={`#${s.id}`} class="tag-pill">{s.title}</a>
      ))}
    </div>
  </div>
</div>
