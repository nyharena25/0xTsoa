---
import { getVotesForConfig, getDiscussionUrlForConfig } from '../lib/votes';
import { withBase } from '../../site.config';

interface Props {
  configId: string;
  name: string;
  locale?: string;
}

const { configId, name } = Astro.props;

const votes = getVotesForConfig(configId);
const discussionUrl = getDiscussionUrlForConfig(configId);
const cataloguePath = withBase('/catalogue/');
---

<div class="sticky top-16 z-40 bg-white/95 backdrop-blur-md border-b border-zinc-200 py-2.5 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col gap-2">
    <!-- Top breadcrumb and actions bar -->
    <div class="flex items-center justify-between gap-2 text-xs font-mono">
      <div class="flex items-center gap-1.5 min-w-0">
        <a
          href={cataloguePath}
          class="inline-flex items-center gap-1 text-zinc-600 hover:text-zinc-900 font-medium transition-colors shrink-0"
          title="Back to catalogue"
        >
          <span>&larr;</span>
          <span class="hidden sm:inline">Catalogue</span>
        </a>
        <span class="text-zinc-300">/</span>
        <span class="text-zinc-900 font-bold truncate" data-page-title="true">{name}</span>
      </div>

      <div class="flex items-center gap-1.5 shrink-0">
        <!-- Interactive Favorite Button -->
        <button
          type="button"
          id="btn-detail-fav"
          data-config-id={configId}
          data-label-add="Favorite"
          data-label-favorited="Saved ✓"
          class="inline-flex items-center gap-1 px-2 sm:px-2.5 py-1 rounded-md font-mono text-xs font-semibold border border-zinc-300 bg-white text-zinc-800 hover:bg-zinc-100 transition-colors shadow-xs cursor-pointer"
          title="Add to favorites"
        >
          <span id="fav-icon">★</span>
          <span id="fav-label" class="hidden sm:inline">Favorite</span>
        </button>

        <span class="inline-flex items-center gap-1 px-2 sm:px-2.5 py-1 rounded-md font-mono text-xs font-bold bg-zinc-100 text-zinc-900 border border-zinc-200">
          ▲ {votes.toLocaleString()}
        </span>

        <a
          href={discussionUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-solid text-xs py-1 px-2 sm:px-2.5"
          title="Sign-Off on GitHub"
        >
          <span>✓</span>
          <span class="hidden xs:inline">Sign-Off</span>
        </a>
      </div>
    </div>

    <!-- Quick anchor jump pills -->
    <div class="flex items-center gap-1.5 overflow-x-auto pt-1 pb-0.5 font-mono text-xs whitespace-nowrap scrollbar-none -mx-4 px-4 sm:mx-0 sm:px-0">
      <a href="#overview" class="tag-pill">
        Overview
      </a>
      <a href="#installation" class="tag-pill">
        Install
      </a>
      <a href="#screenshots" class="tag-pill">
        Screenshots
      </a>
      <a href="#readme" class="tag-pill">
        README.md
      </a>
      <a href="#keybindings" class="tag-pill">
        Keybindings
      </a>
    </div>
  </div>
</div>

<script>
  function setupFavoriteButton() {
    const btn = document.getElementById('btn-detail-fav') as HTMLButtonElement | null;
    const label = document.getElementById('fav-label');
    if (!btn || !label || btn.dataset.bound) return;
    btn.dataset.bound = 'true';

    const configId = btn.getAttribute('data-config-id');
    const labelAdd = btn.getAttribute('data-label-add') || 'Favorite';
    const labelFavorited = btn.getAttribute('data-label-favorited') || 'Saved ✓';

    function getFavs(): string[] {
      try {
        const stored = localStorage.getItem('0xtsoa_favorites');
        return stored ? JSON.parse(stored) : [];
      } catch {
        return [];
      }
    }

    function isFav(): boolean {
      if (!configId) return false;
      return getFavs().includes(configId);
    }

    function updateUi() {
      if (!btn || !label) return;
      if (isFav()) {
        btn.classList.add('bg-zinc-900', 'text-white', 'border-zinc-900');
        btn.classList.remove('bg-white', 'text-zinc-800', 'border-zinc-300');
        label.textContent = labelFavorited;
      } else {
        btn.classList.remove('bg-zinc-900', 'text-white', 'border-zinc-900');
        btn.classList.add('bg-white', 'text-zinc-800', 'border-zinc-300');
        label.textContent = labelAdd;
      }
    }

    btn.addEventListener('click', () => {
      if (!configId) return;
      const favs = getFavs();
      const idx = favs.indexOf(configId);
      if (idx >= 0) {
        favs.splice(idx, 1);
      } else {
        favs.push(configId);
      }
      try {
        localStorage.setItem('0xtsoa_favorites', JSON.stringify(favs));
      } catch {}
      updateUi();
    });

    updateUi();
  }

  setupFavoriteButton();
  document.addEventListener('astro:page-load', setupFavoriteButton);
</script>
