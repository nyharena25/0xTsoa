---
import { getDiscussionUrlForConfig, getVotesForConfig } from '../lib/votes';

interface Props {
  configId: string;
  class?: string;
  large?: boolean;
}

const { configId, class: className = '', large = false } = Astro.props;

const votes = getVotesForConfig(configId);
const discussionUrl = getDiscussionUrlForConfig(configId);
---

<div class={`flex flex-col gap-2 ${className}`}>
  <div class="flex items-center justify-between">
    <span class="font-mono text-xs uppercase font-bold text-black">COMMUNITY SIGN-OFF :</span>
    <span class="bg-surface-card border-2 border-black px-2 py-0.5 rounded-[3px] font-mono text-xs font-bold text-black shadow-[1px_1px_0px_0px_#000000]">
      ▲ {votes.toLocaleString()} SIGN-OFFS
    </span>
  </div>

  <a
    href={discussionUrl}
    target="_blank"
    rel="noopener noreferrer"
    class={`w-full inline-flex items-center justify-center gap-2 border-2 border-black rounded-[3px] shadow-[2px_2px_0px_0px_#000000] font-mono text-xs uppercase tracking-wider active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-none no-underline cursor-pointer ${
      large
        ? 'p-3 bg-black text-white hover:bg-neutral-800'
        : 'p-2 bg-surface-card text-black hover:bg-black hover:text-white'
    }`}
  >
    <span class="font-bold">✓</span>
    <span>[ SIGN-OFF VIA GITHUB ]</span>
  </a>

  <span class="font-mono text-[10px] text-ink-muted text-center uppercase tracking-tight">
    REACT 👍 ❤️ 🎉 ON THE GITHUB VOTE ISSUE. COUNTED AT EVERY REBUILD.
  </span>
</div>
