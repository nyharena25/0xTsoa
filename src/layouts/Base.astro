---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../lib/i18n';
import { withBase } from '../../site.config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  locale?: string;
  pageLabel?: string;
  statusPrefix?: string;
  statusInitial?: string;
  statusFinal?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  updatedAt?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
}

const {
  title,
  description,
  pageLabel,
  statusPrefix: propPrefix,
  statusInitial: propInitial,
  statusFinal: propFinal,
  ogImage: propOgImage,
  ogImageAlt,
  ogType = 'website',
  updatedAt,
  jsonLd,
  noindex = false,
} = Astro.props;

const t = useTranslations('en');
const pageTitle = title ? `${title} — 0xTsoa` : t('site.title');
const pageDesc = description || t('site.description');
const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(currentPath, Astro.site).href;

const defaultOgImage = new URL(withBase('/og.png'), Astro.site).href;
const isDefaultOgImage =
  !propOgImage || propOgImage === '/og.png' || propOgImage === withBase('/og.png');
const resolvedOgImage = !propOgImage
  ? defaultOgImage
  : propOgImage.startsWith('http://') || propOgImage.startsWith('https://')
    ? propOgImage
    : new URL(withBase(propOgImage), Astro.site).href;
const resolvedOgImageAlt = ogImageAlt || '0xTsoa — Linux desktop configuration registry';
const modifiedTimeIso =
  ogType === 'article' && updatedAt
    ? updatedAt.includes('T')
      ? updatedAt
      : `${updatedAt}T00:00:00Z`
    : undefined;
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

let resolvedPrefix = propPrefix;
let resolvedInitial = propInitial;
let resolvedFinal = propFinal;

if (!resolvedPrefix || !resolvedInitial || !resolvedFinal) {
  if (currentPath.includes('/contribute') || currentPath.includes('/contribuer')) {
    resolvedPrefix = resolvedPrefix || '[STATUS: ';
    resolvedInitial = resolvedInitial || 'CONTRIBUTOR';
    resolvedFinal = resolvedFinal || 'CONTRIBUTE';
  } else if (currentPath.includes('/catalogue')) {
    resolvedPrefix = resolvedPrefix || '[STATUS: ';
    resolvedInitial = resolvedInitial || 'CATALOGUE';
    resolvedFinal = resolvedFinal || 'SHOW CASE';
  } else if (currentPath.includes('/configs/')) {
    resolvedPrefix = resolvedPrefix || '[SHOW CASE: ';
    resolvedInitial = resolvedInitial || 'COMMUNITY';
    resolvedFinal = resolvedFinal || 'SHOW CASE';
  } else {
    resolvedPrefix = resolvedPrefix || '[STATUS: ';
    resolvedInitial = resolvedInitial || 'EXIT 1';
    resolvedFinal = resolvedFinal || 'EXIT 0';
  }
}
---

<!doctype html>
<html lang="en" class="bg-[#FBFBFA] text-[#0F172A]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="teSYi3Oiia7lE7wcbzWwjfrd3Qm3kc_pdzAQbeYXb2M" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'}
    />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OpenGraph / Social -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="0xTsoa" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />
    {isDefaultOgImage && <meta property="og:image:width" content="1024" />}
    {isDefaultOgImage && <meta property="og:image:height" content="526" />}
    <meta property="og:image:alt" content={resolvedOgImageAlt} />
    {modifiedTimeIso && <meta property="article:modified_time" content={modifiedTimeIso} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={resolvedOgImageAlt} />

    <link rel="alternate" type="text/plain" title="LLM summary" href={withBase('/llms.txt')} />

    <!-- Favicon SVG Data URI -->
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%230F172A'/><text x='50' y='66' font-size='44' font-family='monospace' font-weight='bold' fill='white' text-anchor='middle'>0xT</text></svg>"
    />

    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    {jsonLdItems.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col font-sans antialiased text-[#0F172A] bg-[#FBFBFA] selection:bg-[#0F172A] selection:text-white overflow-x-hidden w-full max-w-full">
    <Header
      currentPath={currentPath}
      pageLabel={pageLabel || resolvedFinal}
      statusPrefix={resolvedPrefix}
      statusInitial={resolvedInitial}
      statusFinal={resolvedFinal}
    />

    <main class="w-full pt-16 flex-1 flex flex-col">
      <slot />
    </main>

    <Footer />

    <!-- Page Transitions (Delete & Retype) -->
    <script>
      function setupTitleTransitions() {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) {
          sessionStorage.removeItem('0xtsoa_page_transition');
          return;
        }

        const getTitleEl = (): HTMLElement | null => {
          return document.querySelector<HTMLElement>('[data-page-title="true"]');
        };

        const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

        // 1. Landing: Type out page title letter-by-letter
        const titleEl = getTitleEl();
        if (titleEl) {
          const originalText = titleEl.getAttribute('data-original-title') || titleEl.textContent?.trim() || '';
          titleEl.setAttribute('data-original-title', originalText);

          const isNavTransition = sessionStorage.getItem('0xtsoa_page_transition') === 'true';
          if (isNavTransition && originalText) {
            sessionStorage.removeItem('0xtsoa_page_transition');
            const lockedHeight = titleEl.offsetHeight;
            if (lockedHeight > 0) {
              titleEl.style.minHeight = `${lockedHeight}px`;
            }
            titleEl.textContent = '';
            (async () => {
              for (let i = 1; i <= originalText.length; i++) {
                titleEl.textContent = originalText.slice(0, i);
                await sleep(18);
              }
              titleEl.style.minHeight = '';
            })();
          }
        }

        // 2. Intercept internal navigation links: Delete title letter-by-letter before navigating
        document.addEventListener('click', async (e) => {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          const targetLink = (e.target as HTMLElement)?.closest('a');
          if (!targetLink) return;

          const href = targetLink.getAttribute('href');
          if (!href) return;

          // Ignore anchors, external links, downloads, new tabs, modifier keys
          if (
            href.startsWith('#') ||
            href.startsWith('mailto:') ||
            targetLink.getAttribute('target') === '_blank' ||
            targetLink.hasAttribute('download') ||
            e.ctrlKey || e.metaKey || e.shiftKey || e.altKey
          ) {
            return;
          }

          try {
            const url = new URL(href, window.location.href);
            if (url.origin !== window.location.origin) return;
            if (url.pathname === window.location.pathname && url.search === window.location.search) return;

            e.preventDefault();
            const activeTitleEl = getTitleEl();

            if (activeTitleEl) {
              const lockedHeight = activeTitleEl.offsetHeight;
              if (lockedHeight > 0) {
                activeTitleEl.style.minHeight = `${lockedHeight}px`;
              }
              const currentText = activeTitleEl.textContent || '';
              // Delete letter-by-letter in reverse
              for (let i = currentText.length; i >= 0; i--) {
                activeTitleEl.textContent = currentText.slice(0, i);
                await sleep(14);
              }
            }

            sessionStorage.setItem('0xtsoa_page_transition', 'true');
            window.location.href = href;
          } catch {}
        });

        // 3. Tab Switching: When returning to browser tab, delete & retype document.title
        const originalDocTitle = document.title;
        let isTabRetyping = false;
        document.addEventListener('visibilitychange', async () => {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if (document.visibilityState === 'visible' && !isTabRetyping) {
            isTabRetyping = true;
            const currentTitle = document.title;
            // Delete backwards
            for (let i = currentTitle.length; i >= 0; i--) {
              document.title = currentTitle.slice(0, i);
              await sleep(12);
            }
            await sleep(60);
            // Retype forward
            for (let i = 1; i <= originalDocTitle.length; i++) {
              document.title = originalDocTitle.slice(0, i);
              await sleep(18);
            }
            isTabRetyping = false;
          }
        });
      }

      setupTitleTransitions();
      document.addEventListener('astro:page-load', setupTitleTransitions);
    </script>
  </body>
</html>
