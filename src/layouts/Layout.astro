---
import Base from './Base.astro';

interface Props {
  title?: string;
  description?: string;
  locale?: string;
  pageLabel?: string;
  statusPrefix?: string;
  statusInitial?: string;
  statusFinal?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  updatedAt?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
}

const props = Astro.props;
---

<Base {...props}>
  <slot />
</Base>
