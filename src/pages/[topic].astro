---
// Topic pages (/hyprland/, /gtk-themes/…): every entry of one facet compared side by side,
// with the hand-written introduction, tips and FAQ from src/lib/topics.ts.
import Base from '../layouts/Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { liveTopics, topicDescription, type Topic } from '../lib/topics';
import { installDifficulty, installImpact, DIFFICULTY_INFO } from '../lib/install';
import { getStarsForConfig, maintenanceForConfig, MAINTENANCE_INFO } from '../lib/stats';
import { WM_LABELS, DISTRO_LABELS } from '../lib/schema';
import { withBase } from '../../site.config';

export async function getStaticPaths() {
  const all = await getCollection('configs');
  const live = liveTopics(all);
  return live.map(({ topic, entries }) => ({
    params: { topic: topic.slug },
    props: { topic, entries, others: live.filter((t) => t.topic.slug !== topic.slug).map((t) => ({ topic: t.topic, count: t.entries.length })) },
  }));
}

interface Props {
  topic: Topic;
  entries: CollectionEntry<'configs'>[];
  others: { topic: Topic; count: number }[];
}

const { topic, entries, others } = Astro.props;

const rows = entries
  .map((e) => {
    const impact = installImpact(e.data);
    const packages = impact.packages.length + impact.aurPackages.length;
    return {
      id: e.id,
      data: e.data,
      difficulty: installDifficulty(e.data),
      maintenance: maintenanceForConfig(e.id, e.data.tags),
      stars: getStarsForConfig(e.id),
      changes: [
        packages && `${packages} package${packages === 1 ? '' : 's'}`,
        impact.userPaths.length && `${impact.userPaths.length} folder${impact.userPaths.length === 1 ? '' : 's'} in ~`,
        impact.systemCommands.length && 'sudo',
        impact.upstreamCommands.length && 'own installer',
      ].filter(Boolean) as string[],
    };
  })
  // Maintained projects first, then the most starred.
  .sort((a, b) => Number(a.maintenance === 'archived') - Number(b.maintenance === 'archived') || b.stars - a.stars || a.data.name.localeCompare(b.data.name));

const description = topicDescription(topic, entries.length);
const pageUrl = new URL(withBase(`/${topic.slug}/`), Astro.site).href;
const updated = new Date().toISOString().slice(0, 10);
const catalogueQuery = `${topic.facet.kind}=${topic.facet.value}`;
const thumb = (url: string) => (url.startsWith('http') ? url : withBase(url));
const server = (d: CollectionEntry<'configs'>['data']['displayServer']) => (d === 'both' ? 'Wayland & X11' : d === 'wayland' ? 'Wayland' : 'X11');
const formatStars = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}k` : String(n));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: topic.h1,
    description,
    url: pageUrl,
    dateModified: updated,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: rows.length,
      itemListElement: rows.map((r, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: new URL(withBase(`/configs/${r.id}/`), Astro.site).href,
        name: r.data.name,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(withBase('/'), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Catalogue', item: new URL(withBase('/catalogue/'), Astro.site).href },
      { '@type': 'ListItem', position: 3, name: topic.label, item: pageUrl },
    ],
  },
];
---

<Base
  title={topic.title}
  description={description}
  statusPrefix="[TOPIC: "
  statusInitial={topic.label.toUpperCase()}
  statusFinal={`${entries.length} ENTRIES`}
  jsonLd={jsonLd}
>
  <div class="max-w-7xl mx-auto w-full px-4 lg:px-8 py-6 sm:py-8 flex flex-col gap-6 min-w-0" data-pagefind-body>
    <nav aria-label="Breadcrumb" class="font-mono text-xs text-zinc-500">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href={withBase('/')} class="hover:text-zinc-900 underline">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={withBase('/catalogue/')} class="hover:text-zinc-900 underline">Catalogue</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-zinc-900 font-semibold" aria-current="page">{topic.label}</li>
      </ol>
    </nav>

    <header class="flex flex-col gap-3 max-w-3xl">
      <h1 class="font-display text-2xl sm:text-4xl font-bold text-zinc-900 tracking-tight m-0" data-page-title="true">{topic.h1}</h1>
      {topic.intro.map((p) => <p class="font-sans text-base text-zinc-700 leading-relaxed m-0">{p}</p>)}
      <p class="font-mono text-[11px] text-zinc-500 m-0">
        {entries.length} entries · each pinned to an exact upstream version · updated <time datetime={updated}>{updated}</time>
      </p>
    </header>

    <section aria-labelledby="compare-title" class="bg-white border border-zinc-200 rounded-xl shadow-xs p-3 sm:p-5 w-full min-w-0">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <h2 id="compare-title" class="font-mono text-xs sm:text-sm uppercase font-bold text-zinc-900 tracking-wider m-0">All {entries.length} entries, compared</h2>
        <a href={withBase(`/catalogue/?${catalogueQuery}`)} class="font-mono text-[11px] underline text-zinc-600 hover:text-zinc-900">Filter in the catalogue &rarr;</a>
      </div>
      <table class="w-full text-left font-mono text-[11px] border-collapse block md:table">
        <thead class="hidden md:table-header-group bg-zinc-50 border-b border-zinc-200 text-zinc-500 uppercase tracking-wider text-[10px]">
          <tr>
            <th scope="col" class="p-2.5">Setup</th>
            <th scope="col" class="p-2.5">Works with</th>
            <th scope="col" class="p-2.5">Difficulty</th>
            <th scope="col" class="p-2.5">What it changes</th>
            <th scope="col" class="p-2.5">Maintenance</th>
            <th scope="col" class="p-2.5 text-right">Stars</th>
          </tr>
        </thead>
        <tbody class="block md:table-row-group divide-y divide-zinc-100">
          {rows.map((r) => (
            <tr class="block md:table-row py-3 md:py-0 align-top">
              <th scope="row" class="block md:table-cell p-0 md:p-2.5 font-normal text-left">
                <a href={withBase(`/configs/${r.id}/`)} class="group flex gap-3 no-underline min-w-0">
                  <img src={thumb(r.data.screenshots[0].url)} alt="" width="96" height="60" loading="lazy" decoding="async" class="w-24 h-[60px] object-cover rounded-md border border-zinc-200 bg-zinc-100 shrink-0" />
                  <span class="flex flex-col gap-0.5 min-w-0">
                    <span class="text-xs font-bold text-zinc-900 group-hover:underline">{r.data.name}</span>
                    <span class="font-sans text-xs text-zinc-600 leading-snug">{r.data.summary}</span>
                  </span>
                </a>
              </th>
              <td class="block md:table-cell px-0 md:px-2.5 pt-2 md:py-2.5 text-zinc-700">
                <span class="md:hidden text-zinc-500 uppercase text-[10px]">Works with: </span>
                {r.data.wm === 'any' ? 'Any desktop' : WM_LABELS[r.data.wm]} ({server(r.data.displayServer)})
                {!r.data.distros.includes('any') && <span class="text-zinc-500"> · {r.data.distros.map((d) => DISTRO_LABELS[d]).join(', ')}</span>}
              </td>
              <td class="block md:table-cell px-0 md:px-2.5 pt-1 md:py-2.5 whitespace-nowrap">
                {r.difficulty ? (
                  <span class="inline-flex items-center gap-1.5 text-zinc-900 font-semibold">
                    <span class={`w-2 h-2 rounded-full inline-block ${DIFFICULTY_INFO[r.difficulty].dot}`} aria-hidden="true"></span>
                    {DIFFICULTY_INFO[r.difficulty].label}
                  </span>
                ) : <span class="text-zinc-500">Reading list</span>}
              </td>
              <td class="block md:table-cell px-0 md:px-2.5 pt-1 md:py-2.5 text-zinc-700">
                <span class="md:hidden text-zinc-500 uppercase text-[10px]">Changes: </span>
                {r.difficulty === 'manual' ? 'Nothing for you: follow the upstream guide' : r.changes.length ? r.changes.join(' · ') : '—'}
              </td>
              <td class="block md:table-cell px-0 md:px-2.5 pt-1 md:py-2.5 whitespace-nowrap">
                {r.maintenance ? (
                  <span class="inline-flex items-center gap-1.5 text-zinc-700">
                    <span class={`w-2 h-2 rounded-full inline-block ${MAINTENANCE_INFO[r.maintenance].dot}`} aria-hidden="true"></span>
                    {MAINTENANCE_INFO[r.maintenance].label}
                  </span>
                ) : <span class="text-zinc-400">Not checked yet</span>}
              </td>
              <td class="block md:table-cell px-0 md:px-2.5 pt-1 md:py-2.5 md:text-right text-zinc-700">
                <span class="md:hidden text-zinc-500 uppercase text-[10px]">Stars: </span>{formatStars(r.stars)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <section aria-labelledby="choose-title" class="bg-white border border-zinc-200 rounded-xl shadow-xs p-4 sm:p-6">
        <h2 id="choose-title" class="font-mono text-xs sm:text-sm uppercase font-bold text-zinc-900 tracking-wider mb-3">How to choose</h2>
        <ul class="flex flex-col gap-2 font-sans text-sm text-zinc-700 leading-relaxed list-disc pl-5">
          {topic.choose.map((c) => <li>{c}</li>)}
        </ul>
      </section>

      <section aria-labelledby="faq-title" class="bg-white border border-zinc-200 rounded-xl shadow-xs p-4 sm:p-6">
        <h2 id="faq-title" class="font-mono text-xs sm:text-sm uppercase font-bold text-zinc-900 tracking-wider mb-3">Questions</h2>
        <div class="flex flex-col gap-4">
          {topic.faq.map(({ q, a }) => (
            <div>
              <h3 class="font-sans text-sm font-bold text-zinc-900 mb-1">{q}</h3>
              <p class="font-sans text-sm text-zinc-700 leading-relaxed m-0">{a}</p>
            </div>
          ))}
        </div>
      </section>
    </div>

    <section aria-labelledby="more-title" class="flex flex-col gap-3">
      <h2 id="more-title" class="font-mono text-xs uppercase font-bold text-zinc-900 tracking-wider m-0">More topics</h2>
      <ul class="flex flex-wrap gap-2">
        {others.map(({ topic: t, count }) => (
          <li><a href={withBase(`/${t.slug}/`)} class="tag-pill">{t.label} <span class="text-zinc-400">({count})</span></a></li>
        ))}
      </ul>
      <p class="font-sans text-sm text-zinc-600 m-0">
        Missing a setup you use? <a href={withBase('/contribute/')} class="underline text-zinc-900 font-semibold">Submit it</a>: the form opens a pull request for you, and every entry is reviewed and pinned like the ones above.
      </p>
    </section>
  </div>
</Base>
