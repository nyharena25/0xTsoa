---
import Base from '../layouts/Base.astro';
import BdBrickLogo from '../components/BdBrickLogo.astro';
import { useTranslations } from '../lib/i18n';
import { withBase, REPO_URL } from '../../site.config';

const locale = 'en';
const t = useTranslations(locale);

const aboutUrl = new URL(withBase('/about/'), Astro.site).href;
const siteRootUrl = new URL(withBase('/'), Astro.site).href;

const aboutJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${aboutUrl}#profilepage`,
  name: t('about.metaTitle'),
  description: t('about.metaDescription'),
  url: aboutUrl,
  isPartOf: {
    '@id': `${siteRootUrl}#website`,
  },
  mainEntity: {
    '@type': 'Person',
    '@id': `${siteRootUrl}#founder`,
    name: 'Ny Harena RAVELOMANANTSOA',
    givenName: 'Ny Harena',
    familyName: 'RAVELOMANANTSOA',
    alternateName: 'nyharena25',
    nationality: {
      '@type': 'Country',
      name: 'Madagascar',
    },
    jobTitle: 'Software Developer',
    url: aboutUrl,
    sameAs: [
      'https://github.com/nyharena25',
      'https://www.linkedin.com/in/rnyharena-dev/',
      // TODO: Add X, Mastodon, and dev.to profile URLs once created
    ],
  },
};
---

<Base
  title={t('about.metaTitle')}
  description={t('about.metaDescription')}
  locale={locale}
  statusPrefix="[STATUS: "
  statusInitial="IDENTITY"
  statusFinal="ABOUT"
  jsonLd={aboutJsonLd}
>
  <div class="max-w-5xl mx-auto px-4 lg:px-8 py-8 flex flex-col gap-8" data-pagefind-body>
    <!-- Header Banner -->
    <div class="bg-white border border-zinc-200 rounded-xl p-6 sm:p-8 shadow-xs">
      <div class="inline-flex items-center gap-2 bg-zinc-100 border border-zinc-200 px-2.5 py-1 rounded-md font-mono text-xs font-semibold uppercase mb-3 text-zinc-700">
        <span class="w-2 h-2 rounded-full bg-zinc-900 inline-block"></span>
        <span>{t('about.badge')}</span>
      </div>
      <h1 class="flex flex-wrap items-center gap-x-3 gap-y-2 font-display text-2xl sm:text-4xl uppercase font-bold text-zinc-900 tracking-tight">
        <span data-page-title="true">ABOUT</span>{' '}
        <BdBrickLogo size="md" class="inline-flex text-zinc-900 align-middle shrink-0" />
        <span class="font-mono text-sm sm:text-base font-normal text-zinc-500 normal-case">(ZeroTsoa)</span>
      </h1>
      <p class="font-sans text-base sm:text-lg text-zinc-700 mt-3 leading-relaxed">
        {t('about.canonicalIntro')}
      </p>
    </div>

    <!-- What is 0xTsoa & Why the Name -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- What is 0xTsoa -->
      <section class="bg-white border border-zinc-200 rounded-xl p-6 shadow-xs flex flex-col gap-4">
        <div class="flex items-center justify-between border-b border-zinc-100 pb-3">
          <h2 class="font-mono text-xs sm:text-sm font-bold uppercase text-zinc-900 tracking-wide">
            01 // What is 0xTsoa
          </h2>
          <span class="bg-zinc-900 text-white font-mono text-[10px] px-2 py-0.5 rounded font-medium">REGISTRY</span>
        </div>

        <p class="font-sans text-sm text-zinc-700 leading-relaxed">
          <strong>0xTsoa</strong> (pronounced <strong>ZeroTsoa</strong>) is a static, zero-database community registry indexing reproducible Linux desktop configurations across Wayland compositors (Hyprland, Niri, Sway, River) and X11 window managers (i3, bspwm, AwesomeWM, dwm).
        </p>

        <p class="font-sans text-sm text-zinc-600 leading-relaxed">
          Every setup in the registry is stored as a schema-validated JSON specification in Git (<code>configs/&lt;author&gt;/&lt;slug&gt;.json</code>), referencing an upstream commit SHA or version tag, with optional SHA-256 checksum verification when an external installation script is provided.
        </p>
      </section>

      <!-- Why the Name -->
      <section class="bg-white border border-zinc-200 rounded-xl p-6 shadow-xs flex flex-col gap-4">
        <div class="flex items-center justify-between border-b border-zinc-100 pb-3">
          <h2 class="font-mono text-xs sm:text-sm font-bold uppercase text-zinc-900 tracking-wide">
            02 // Name Origin
          </h2>
          <span class="bg-zinc-100 text-zinc-700 border border-zinc-200 font-mono text-[10px] px-2 py-0.5 rounded font-medium">ETYMOLOGY</span>
        </div>

        <p class="font-sans text-sm text-zinc-700 leading-relaxed">
          The name <strong>0xTsoa</strong> combines the hexadecimal literal prefix <code>0x</code> with <strong>Tsoa</strong>, taken from the end of the creator&apos;s Malagasy family name, <strong>RAVELOMANANTSOA</strong>.
        </p>

        <div class="bg-zinc-50 border border-zinc-200/70 rounded-lg p-3.5 font-mono text-xs text-zinc-700 space-y-1.5">
          <div><span class="text-zinc-500">Written:</span> <strong class="text-zinc-900">0xTsoa</strong></div>
          <div><span class="text-zinc-500">Spoken:</span> <strong class="text-zinc-900">&ldquo;ZeroTsoa&rdquo;</strong></div>
          <div><span class="text-zinc-500">Origin:</span> <code class="text-zinc-900">0x</code> (hex prefix) + <code class="text-zinc-900">Tsoa</code> (from RAVELOMANAN<u>TSOA</u>)</div>
        </div>
      </section>
    </div>

    <!-- Creator Section -->
    <section class="bg-white border border-zinc-200 rounded-xl p-6 sm:p-7 shadow-xs flex flex-col gap-5" id="creator">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-zinc-100 pb-3">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-zinc-900 inline-block"></span>
          <h2 class="font-mono text-xs sm:text-sm font-bold uppercase text-zinc-900 tracking-wide">
            03 // Creator &amp; Maintainer
          </h2>
        </div>
        <span class="font-mono text-xs text-zinc-500">Madagascar (MG)</span>
      </div>

      <div class="border border-zinc-200 rounded-lg overflow-hidden bg-white font-mono text-xs">
        <dl class="divide-y divide-zinc-100">
          <div class="grid grid-cols-1 md:grid-cols-12 p-3.5 bg-zinc-50/70 gap-1 md:gap-0">
            <dt class="md:col-span-3 font-semibold uppercase text-zinc-500 tracking-wider text-[11px]">Full Name</dt>
            <dd class="md:col-span-9 text-zinc-900 font-sans font-semibold text-sm">Ny Harena RAVELOMANANTSOA</dd>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 p-3.5 bg-white gap-1 md:gap-0">
            <dt class="md:col-span-3 font-semibold uppercase text-zinc-500 tracking-wider text-[11px]">Role</dt>
            <dd class="md:col-span-9 text-zinc-800 font-sans text-sm">Software Developer &amp; Creator of 0xTsoa</dd>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 p-3.5 bg-zinc-50/70 gap-1 md:gap-0">
            <dt class="md:col-span-3 font-semibold uppercase text-zinc-500 tracking-wider text-[11px]">Nationality</dt>
            <dd class="md:col-span-9 text-zinc-800 font-sans text-sm">Malagasy (Madagascar)</dd>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 p-3.5 bg-white gap-1 md:gap-0">
            <dt class="md:col-span-3 font-semibold uppercase text-zinc-500 tracking-wider text-[11px]">GitHub</dt>
            <dd class="md:col-span-9">
              <a
                href="https://github.com/nyharena25"
                target="_blank"
                rel="me noopener noreferrer"
                class="underline text-zinc-900 hover:text-zinc-600 font-semibold"
              >
                github.com/nyharena25 ↗
              </a>
            </dd>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 p-3.5 bg-zinc-50/70 gap-1 md:gap-0">
            <dt class="md:col-span-3 font-semibold uppercase text-zinc-500 tracking-wider text-[11px]">LinkedIn</dt>
            <dd class="md:col-span-9">
              <a
                href="https://www.linkedin.com/in/rnyharena-dev/"
                target="_blank"
                rel="me noopener noreferrer"
                class="underline text-zinc-900 hover:text-zinc-600 font-semibold"
              >
                linkedin.com/in/rnyharena-dev ↗
              </a>
            </dd>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 p-3.5 bg-white gap-1 md:gap-0">
            <dt class="md:col-span-3 font-semibold uppercase text-zinc-500 tracking-wider text-[11px]">Contact Email</dt>
            <dd class="md:col-span-9 flex flex-wrap items-center gap-2 text-zinc-800">
              <code id="obfuscated-email" data-u="rnyharena25" data-d="gmail" data-t="com" class="bg-zinc-100 border border-zinc-200 px-2 py-0.5 rounded text-xs">
                rnyharena25 [at] gmail [dot] com
              </code>
              <button
                type="button"
                id="btn-reveal-email"
                class="border border-zinc-300 bg-white hover:bg-zinc-100 text-zinc-700 px-2 py-0.5 rounded text-[11px] font-semibold cursor-pointer transition-colors"
              >
                Reveal address
              </button>
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Official Links & Profiles -->
    <section class="bg-white border border-zinc-200 rounded-xl p-6 shadow-xs flex flex-col gap-4">
      <div class="border-b border-zinc-100 pb-3 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-zinc-900 inline-block"></span>
        <h2 class="font-mono text-xs sm:text-sm font-bold uppercase text-zinc-900 tracking-wide">
          04 // Official Links &amp; Profiles
        </h2>
      </div>

      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 font-mono text-xs">
        <li>
          <a
            href={siteRootUrl}
            class="flex items-center justify-between p-3.5 rounded-lg border border-zinc-200 bg-zinc-50/60 hover:bg-zinc-100 text-zinc-900 no-underline transition-colors"
          >
            <span class="font-semibold">Web Registry (0xTsoa)</span>
            <span class="text-zinc-500">0xtsoa.vercel.app &rarr;</span>
          </a>
        </li>
        <li>
          <a
            href={REPO_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between p-3.5 rounded-lg border border-zinc-200 bg-zinc-50/60 hover:bg-zinc-100 text-zinc-900 no-underline transition-colors"
          >
            <span class="font-semibold">Source Repository</span>
            <span class="text-zinc-500">github.com/nyharena25/0xTsoa ↗</span>
          </a>
        </li>
        <li>
          <a
            href="https://github.com/nyharena25"
            target="_blank"
            rel="me noopener noreferrer"
            class="flex items-center justify-between p-3.5 rounded-lg border border-zinc-200 bg-zinc-50/60 hover:bg-zinc-100 text-zinc-900 no-underline transition-colors"
          >
            <span class="font-semibold">Creator GitHub (@nyharena25)</span>
            <span class="text-zinc-500">github.com/nyharena25 ↗</span>
          </a>
        </li>
        <li>
          <a
            href="https://www.linkedin.com/in/rnyharena-dev/"
            target="_blank"
            rel="me noopener noreferrer"
            class="flex items-center justify-between p-3.5 rounded-lg border border-zinc-200 bg-zinc-50/60 hover:bg-zinc-100 text-zinc-900 no-underline transition-colors"
          >
            <span class="font-semibold">Creator LinkedIn</span>
            <span class="text-zinc-500">linkedin.com/in/rnyharena-dev ↗</span>
          </a>
        </li>
      </ul>
    </section>

    <!-- Privacy & Analytics Note -->
    <section class="bg-white border border-zinc-200 rounded-xl p-6 shadow-xs flex flex-col gap-3" id="privacy">
      <div class="border-b border-zinc-100 pb-3 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-zinc-900 inline-block"></span>
        <h2 class="font-mono text-xs sm:text-sm font-bold uppercase text-zinc-900 tracking-wide">
          {t('about.privacyHeading')}
        </h2>
      </div>
      <p class="font-sans text-sm text-zinc-700 leading-relaxed">
        {t('about.privacyNote')}
      </p>
    </section>
  </div>

  <script>
    function setupEmailReveal() {
      const btn = document.getElementById('btn-reveal-email');
      const codeEl = document.getElementById('obfuscated-email');
      if (!btn || !codeEl || btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';

      btn.addEventListener('click', () => {
        const u = codeEl.getAttribute('data-u') || '';
        const d = codeEl.getAttribute('data-d') || '';
        const t = codeEl.getAttribute('data-t') || '';
        if (u && d && t) {
          const addr = [u, '@', d, '.', t].join('');
          const link = document.createElement('a');
          link.href = `mailto:${addr}`;
          link.textContent = addr;
          link.className = 'underline text-zinc-900 font-semibold';
          codeEl.replaceWith(link);
          btn.remove();
        }
      });
    }

    setupEmailReveal();
    document.addEventListener('astro:page-load', setupEmailReveal);
  </script>
</Base>
