---
import Base from '../layouts/Base.astro';
import ConfigCard from '../components/ConfigCard.astro';
import FilterSidebar from '../components/FilterSidebar.astro';
import SubmitCta from '../components/SubmitCta.astro';
import { getCollection } from 'astro:content';
import { getVotesForConfig } from '../lib/votes';
import { useTranslations } from '../lib/i18n';
import { getStarsForConfig } from '../lib/stats';
import { PAGE_SIZE } from '../lib/filters';
import { withBase } from '../../site.config';
import { START_HERE_GUIDE } from '../lib/guides';
import { topicPath } from '../lib/topics';

const locale = 'en';
const t = useTranslations(locale);

const startHere = (await getCollection('guides', ({ id, data }) => id === START_HERE_GUIDE && (import.meta.env.DEV || !data.draft)))[0];
const allConfigs = await getCollection('configs');

const counts = {
  categories: {} as Record<string, number>,
  wms: {} as Record<string, number>,
  styles: {} as Record<string, number>,
  distros: {} as Record<string, number>,
};

for (const c of allConfigs) {
  const data = c.data;
  counts.categories[data.category] = (counts.categories[data.category] || 0) + 1;
  counts.wms[data.wm] = (counts.wms[data.wm] || 0) + 1;
  const style = data.themeStyle || 'minimalist';
  counts.styles[style] = (counts.styles[style] || 0) + 1;
  for (const d of data.distros) {
    counts.distros[d] = (counts.distros[d] || 0) + 1;
  }
}

// Same order as the client-side default sort ("Most upvoted", stars break ties).
const sortedConfigs = allConfigs
  .slice()
  .sort((a, b) => getVotesForConfig(b.id) - getVotesForConfig(a.id) || getStarsForConfig(b.id) - getStarsForConfig(a.id));
const totalPages = Math.max(1, Math.ceil(sortedConfigs.length / PAGE_SIZE));
---

<Base
  title={t('catalogue.metaTitle')}
  description={t('catalogue.metaDescription')}
  locale={locale}
  statusPrefix="[STATUS: "
  statusInitial="CATALOGUE"
  statusFinal="SHOW CASE"
>
  <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-6 flex flex-col gap-6">
    <header class="flex flex-col gap-2 max-w-3xl">
      <h1 class="font-display text-3xl sm:text-4xl font-bold text-zinc-900 tracking-tight m-0" data-page-title="true">Linux desktop catalogue</h1>
      <p class="font-sans text-base text-zinc-700 leading-relaxed m-0">
        {allConfigs.length} setups, themes and tools, each pinned to an exact upstream version and installed with a preview and a rollback.
        <a href={withBase(startHere ? topicPath(startHere.id) : '/docs/')} class="underline text-zinc-900 font-semibold whitespace-nowrap">New here? {startHere ? 'Start with the basics' : 'Read the guides'} &rarr;</a>
      </p>
    </header>

    <!-- Mobile Filter Toggle Button -->
    <div class="lg:hidden flex items-center justify-between gap-3">
      <button
        id="btn-toggle-filters-mobile"
        type="button"
        class="flex-1 min-h-[44px] flex items-center justify-between px-4 py-2.5 bg-white border border-zinc-200 rounded-lg text-xs font-mono font-semibold text-zinc-900 shadow-xs cursor-pointer hover:bg-zinc-50 transition-colors"
      >
        <div class="flex items-center gap-2">
          <span>{t('catalogue.quickFilters')}</span>
          <span id="mobile-filter-badge" class="px-2 py-0.5 rounded-full bg-zinc-900 text-white text-[10px] font-mono">0</span>
        </div>
        <span id="mobile-filter-chevron" class="text-zinc-500 font-bold transition-transform">▼</span>
      </button>
    </div>

    <!-- Main Layout: Sidebar + List -->
    <div class="flex flex-col lg:flex-row gap-6 items-start">
      <!-- Facets Sidebar Wrapper (collapsible on mobile, fixed on desktop) -->
      <div id="filters-sidebar-wrapper" class="hidden lg:block w-full lg:w-72 shrink-0">
        <FilterSidebar counts={counts} locale={locale} />
      </div>

      <!-- Results Main Content -->
      <main class="flex-1 w-full flex flex-col gap-5">
        <!-- Search, favorites and sort: the main controls -->
        <div class="bg-white border-2 border-zinc-900 rounded-xl p-2.5 sm:p-3 shadow-sm flex flex-col md:flex-row items-stretch md:items-center gap-2.5">
          <div class="relative flex-1 flex items-center bg-zinc-50 border border-zinc-300 rounded-lg focus-within:border-zinc-900 focus-within:ring-1 focus-within:ring-zinc-900 transition-all">
            <span class="pl-3 text-zinc-500 select-none" aria-hidden="true">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </span>
            <input
              id="live-catalogue-search"
              type="text"
              placeholder={t('catalogue.searchPlaceholder')}
              aria-label={t('catalogue.searchLabel')}
              class="w-full bg-transparent pl-2.5 pr-20 py-3 font-sans text-base sm:text-sm text-zinc-900 placeholder:text-zinc-500 focus:outline-none"
            />
            <div class="absolute right-2 flex items-center gap-1.5">
              <button
                id="btn-clear-search"
                type="button"
                class="hidden px-1.5 py-0.5 font-mono text-xs text-zinc-400 hover:text-zinc-900 font-bold cursor-pointer"
                title="Clear search (ESC)"
              >
                ✕
              </button>
              <button
                type="button"
                id="catalogue-grep-submit"
                aria-label="Filter"
                class="hidden items-center justify-center px-1.5 py-0.5 font-mono text-[11px] font-bold text-zinc-900 hover:text-white bg-zinc-200 hover:bg-zinc-900 rounded border border-zinc-300 transition-none cursor-pointer select-none instant-snap"
              >
                [ ↵ ]
              </button>
            </div>
          </div>

          <button
            id="btn-filter-favs"
            type="button"
            aria-pressed="false"
            class="px-3.5 py-2 min-h-[44px] rounded-lg font-mono text-xs font-semibold uppercase border border-zinc-200 bg-white text-zinc-800 hover:bg-zinc-100 cursor-pointer shrink-0 transition-all shadow-xs flex items-center justify-center"
          >
            ★ {t('catalogue.favoritesOnly')}
          </button>
          <label class="flex items-center gap-2 shrink-0 font-mono text-xs">
            <span class="text-zinc-600">{t('catalogue.sortBy')}</span>
            <select
              id="sort-select"
              class="min-h-[44px] border border-zinc-300 rounded-lg bg-white px-2.5 font-mono text-xs font-semibold text-zinc-800 cursor-pointer outline-none focus:border-zinc-900"
            >
              <option value="votes">{t('catalogue.sortVotes')}</option>
              <option value="new">{t('catalogue.sortNew')}</option>
              <option value="old">{t('catalogue.sortOld')}</option>
              <option value="popular">{t('catalogue.sortPopular')}</option>
            </select>
          </label>
        </div>

        <!-- Results Top Bar -->
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 px-1 font-mono text-xs" aria-live="polite">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-zinc-900 inline-block"></span>
            <span class="font-bold text-zinc-900" id="results-count-label">
              {allConfigs.length} {t('catalogue.interfacesIndexed')}
            </span>
          </div>

          <div id="active-filters-chips" class="flex flex-wrap items-center gap-1.5"></div>

        </div>

        <!-- Cards List Container -->
        <div id="cards-container" class="flex flex-col gap-4" data-pagefind-ignore>
          {sortedConfigs.map((c, idx) => (
            <div
              class="config-card-item"
              style={idx >= PAGE_SIZE ? 'display:none' : undefined}
              data-id={c.id}
              data-name={c.data.name}
              data-author={c.data.author.name}
              data-author-github={c.data.author.github}
              data-summary={c.data.summary}
              data-description={c.data.description || ''}
              data-category={c.data.category}
              data-wm={c.data.wm}
              data-style={c.data.themeStyle || 'minimalist'}
              data-display-server={c.data.displayServer}
              data-distros={c.data.distros.join(',')}
              data-specs={JSON.stringify(c.data.specs || {})}
              data-stars={getStarsForConfig(c.id)}
              data-tags={c.data.tags.join(',')}
              data-votes={getVotesForConfig(c.id)}
              data-date={c.data.updatedAt}
            >
              <ConfigCard id={c.id} data={c.data} locale={locale} />
            </div>
          ))}
        </div>

        <!-- Pagination (10 per page, ?p=N) -->
        <nav id="pagination" aria-label="Catalogue pages" class="flex flex-wrap items-center justify-center gap-1.5 font-mono text-xs" data-page-size={PAGE_SIZE}>
          {totalPages > 1 && Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
            <a
              href={n === 1 ? withBase('/catalogue/') : `?p=${n}`}
              rel={n > 1 ? 'nofollow' : undefined}
              aria-current={n === 1 ? 'page' : undefined}
              class={`min-w-[36px] min-h-[36px] px-2.5 rounded-md border font-semibold transition-colors inline-flex items-center justify-center ${
                n === 1
                  ? 'bg-zinc-900 text-white border-zinc-900'
                  : 'bg-white text-zinc-800 border-zinc-300 hover:bg-zinc-100 cursor-pointer'
              }`}
            >
              {n}
            </a>
          ))}
        </nav>

        <!-- Empty state message -->
        <div
          id="no-results-msg"
          class="hidden bg-white border border-zinc-200 rounded-xl p-8 text-center font-mono text-sm text-zinc-900 shadow-xs"
        >
          <p class="font-bold text-base mb-1 text-zinc-900">{t('catalogue.noResults')}</p>
          <p class="text-xs text-zinc-500 mb-4">Clear active filters or broaden your search keywords.</p>
          <button
            id="btn-empty-reset"
            type="button"
            class="btn-solid"
          >
            {t('catalogue.reset')}
          </button>
        </div>

        <SubmitCta heading="Missing a setup you use?" />
      </main>
    </div>
  </div>
</Base>

<script>
  import { filterConfigs, paginate, PAGE_SIZE, type CatalogueItem, type FilterState } from '../lib/filters';

  const FAV_ACTIVE_CLASSES = ['bg-zinc-900', 'text-white', 'border-zinc-900', 'hover:bg-zinc-800'];
  const FAV_INACTIVE_CLASSES = ['bg-white', 'text-zinc-800', 'border-zinc-200', 'hover:bg-zinc-100'];

  function setupFilters() {
    const cardItems = Array.from(document.querySelectorAll<HTMLElement>('.config-card-item'));
    const countLabel = document.getElementById('results-count-label');
    const noResultsMsg = document.getElementById('no-results-msg');
    const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
    const chipsContainer = document.getElementById('active-filters-chips');
    const searchInput = document.getElementById('live-catalogue-search') as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById('btn-clear-search');
    const grepSubmitBtn = document.getElementById('catalogue-grep-submit');
    const favsBtn = document.getElementById('btn-filter-favs');
    const resetEmptyBtn = document.getElementById('btn-empty-reset');
    const resetSidebarBtn = document.getElementById('btn-reset-filters');
    const paginationNav = document.getElementById('pagination');

    const cardById = new Map<string, HTMLElement>();
    const catalogueItems: CatalogueItem[] = cardItems.map((card) => {
      const id = card.getAttribute('data-id') || '';
      cardById.set(id, card);
      let specs: CatalogueItem['specs'] = {};
      try {
        specs = JSON.parse(card.getAttribute('data-specs') || '{}');
      } catch {}
      return {
        id,
        name: card.getAttribute('data-name') || '',
        author: {
          name: card.getAttribute('data-author') || '',
          github: card.getAttribute('data-author-github') || '',
        },
        summary: card.getAttribute('data-summary') || '',
        description: card.getAttribute('data-description') || '',
        category: card.getAttribute('data-category') || 'dotfiles',
        distros: (card.getAttribute('data-distros') || '').split(',').filter(Boolean),
        wm: card.getAttribute('data-wm') || '',
        themeStyle: card.getAttribute('data-style') || 'minimalist',
        displayServer: card.getAttribute('data-display-server') || 'wayland',
        tags: (card.getAttribute('data-tags') || '').split(',').filter(Boolean),
        specs,
        thumbUrl: '',
        thumbAlt: '',
        updatedAt: card.getAttribute('data-date') || '1970-01-01',
        votes: Number.parseInt(card.getAttribute('data-votes') || '0', 10) || 0,
        stars: Number.parseInt(card.getAttribute('data-stars') || '0', 10) || 0,
      };
    });

    function updateGrepState() {
      const val = searchInput?.value || '';
      if (val.length > 0) {
        grepSubmitBtn?.classList.remove('hidden');
        grepSubmitBtn?.classList.add('inline-flex');
        clearSearchBtn?.classList.remove('hidden');
      } else {
        grepSubmitBtn?.classList.add('hidden');
        grepSubmitBtn?.classList.remove('inline-flex');
        clearSearchBtn?.classList.add('hidden');
      }
    }

    function buildPageHref(n: number): string {
      const p = new URLSearchParams(window.location.search);
      if (n > 1) p.set('p', String(n));
      else p.delete('p');
      return p.toString() ? `?${p.toString()}` : window.location.pathname;
    }

    function goToPage(n: number) {
      const p = new URLSearchParams(window.location.search);
      if (n > 1) p.set('p', String(n));
      else p.delete('p');
      window.history.replaceState({}, '', p.toString() ? `?${p.toString()}` : window.location.pathname);
      readStateFromUrl();
      document.getElementById('cards-container')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function renderPagination(current: number, pageCount: number) {
      if (!paginationNav) return;
      paginationNav.innerHTML = '';
      if (pageCount <= 1) return;
      const add = (label: string, target: number | null, active = false) => {
        if (target === null) {
          const span = document.createElement('span');
          span.textContent = label;
          span.setAttribute('aria-disabled', 'true');
          span.className = 'min-w-[36px] min-h-[36px] px-2.5 rounded-md border font-semibold transition-colors inline-flex items-center justify-center bg-white text-zinc-300 border-zinc-200 cursor-default';
          paginationNav.appendChild(span);
          return;
        }
        const link = document.createElement('a');
        link.href = buildPageHref(target);
        if (target > 1) link.rel = 'nofollow';
        link.textContent = label;
        if (active) link.setAttribute('aria-current', 'page');
        link.className = `min-w-[36px] min-h-[36px] px-2.5 rounded-md border font-semibold transition-colors inline-flex items-center justify-center ${
          active
            ? 'bg-zinc-900 text-white border-zinc-900'
            : 'bg-white text-zinc-800 border-zinc-300 hover:bg-zinc-100 cursor-pointer'
        }`;
        link.addEventListener('click', (e) => {
          if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
          e.preventDefault();
          if (!active) goToPage(target);
        });
        paginationNav.appendChild(link);
      };
      add('← Prev', current > 1 ? current - 1 : null);
      // First, last and a window of two pages around the current one.
      let last = 0;
      for (let n = 1; n <= pageCount; n++) {
        if (n !== 1 && n !== pageCount && Math.abs(n - current) > 2) continue;
        if (n - last > 1) add('…', null);
        add(String(n), n, n === current);
        last = n;
      }
      add('Next →', current < pageCount ? current + 1 : null);
    }

    const checkboxes = Array.from(document.querySelectorAll<HTMLInputElement>('.filter-checkbox'));

    function getSavedFavorites(): string[] {
      try {
        const stored = localStorage.getItem('0xtsoa_favorites');
        return stored ? JSON.parse(stored) : [];
      } catch {
        return [];
      }
    }

    function readStateFromUrl() {
      const p = new URLSearchParams(window.location.search);
      const selectedCategories = p.getAll('category');
      const selectedWms = p.getAll('wm');
      const selectedStyles = p.getAll('style');
      const selectedDistros = p.getAll('distro');
      const page = Math.max(1, Number.parseInt(p.get('p') || '1', 10) || 1);
      const tag = p.get('tag');
      const q = p.get('q') || '';
      const favOnly = p.get('fav') === 'true';
      const sort = p.get('sort') || 'votes';

      checkboxes.forEach((cb) => {
        if (cb.name === 'category') cb.checked = selectedCategories.includes(cb.value);
        if (cb.name === 'wm') cb.checked = selectedWms.includes(cb.value);
        if (cb.name === 'style') cb.checked = selectedStyles.includes(cb.value);
        if (cb.name === 'distro') cb.checked = selectedDistros.includes(cb.value);
        if (cb.checked) {
          const details = cb.closest('details');
          if (details) details.open = true;
        }
      });

      document.querySelectorAll<HTMLButtonElement>('.theme-chip').forEach((chip) => {
        chip.setAttribute('aria-pressed', String(selectedStyles.includes(chip.dataset.style || '')));
      });

      if (searchInput && searchInput.value !== q) {
        searchInput.value = q;
      }
      updateGrepState();

      if (favsBtn) {
        favsBtn.classList.remove(...(favOnly ? FAV_INACTIVE_CLASSES : FAV_ACTIVE_CLASSES));
        favsBtn.classList.add(...(favOnly ? FAV_ACTIVE_CLASSES : FAV_INACTIVE_CLASSES));
        favsBtn.setAttribute('aria-pressed', String(favOnly));
      }

      if (sortSelect && sort) sortSelect.value = sort;

      applyFilter(selectedCategories, selectedWms, selectedStyles, selectedDistros, tag, q, favOnly, sort, page);
    }

    function writeStateToUrl() {
      const p = new URLSearchParams();
      checkboxes.forEach((cb) => {
        if (cb.checked) {
          p.append(cb.name, cb.value);
        }
      });

      if (searchInput && searchInput.value.trim()) {
        p.set('q', searchInput.value.trim());
      }

      const currentP = new URLSearchParams(window.location.search);
      if (currentP.get('tag')) p.set('tag', currentP.get('tag')!);
      if (currentP.get('fav') === 'true') p.set('fav', 'true');

      if (sortSelect && sortSelect.value !== 'votes') {
        p.set('sort', sortSelect.value);
      }

      const newQuery = p.toString() ? `?${p.toString()}` : window.location.pathname;
      window.history.replaceState({}, '', newQuery);
      readStateFromUrl();
    }

    function applyFilter(
      categories: string[],
      wms: string[],
      styles: string[],
      distros: string[],
      tag: string | null,
      query: string,
      favOnly: boolean,
      sort: string,
      page: number,
    ) {
      const savedFavorites = getSavedFavorites();

      if (chipsContainer) {
        chipsContainer.innerHTML = '';
        const allActive: { label: string; onRemove: () => void }[] = [];

        categories.forEach((c) => allActive.push({ label: `part:${c}`, onRemove: () => uncheck('category', c) }));
        wms.forEach((w) => allActive.push({ label: `wm:${w}`, onRemove: () => uncheck('wm', w) }));
        styles.forEach((s) => allActive.push({ label: `style:${s}`, onRemove: () => uncheck('style', s) }));
        distros.forEach((d) => allActive.push({ label: `distro:${d}`, onRemove: () => uncheck('distro', d) }));
        if (tag) allActive.push({ label: `#${tag}`, onRemove: () => removeQueryParam('tag') });
        if (query) allActive.push({ label: `"${query}"`, onRemove: () => clearSearch() });
        if (favOnly) allActive.push({ label: '★ favorites', onRemove: () => toggleFavFilter() });

        allActive.forEach((item) => {
          const chip = document.createElement('span');
          chip.className = 'px-2.5 py-1 bg-zinc-900 text-white font-mono text-[11px] font-semibold rounded-md flex items-center gap-1.5 cursor-pointer hover:bg-zinc-800 transition-colors shadow-xs';
          const labelSpan = document.createElement('span');
          labelSpan.textContent = item.label;
          const closeSpan = document.createElement('span');
          closeSpan.className = 'text-zinc-400 hover:text-white';
          closeSpan.textContent = '✕';
          chip.appendChild(labelSpan);
          chip.appendChild(closeSpan);
          chip.onclick = item.onRemove;
          chipsContainer.appendChild(chip);
        });

        const mobileBadge = document.getElementById('mobile-filter-badge');
        if (mobileBadge) {
          mobileBadge.textContent = String(allActive.length);
        }
      }

      const filtered = filterConfigs(catalogueItems, {
        category: categories,
        wm: wms,
        style: styles,
        distro: distros,
        tag: tag || undefined,
        query,
        favoritesOnly: favOnly,
        favorites: savedFavorites,
        sort: (sort as FilterState['sort']) || 'votes',
      });

      const visibleCount = filtered.length;
      const { items: pageItems, page: current, pageCount } = paginate(filtered, page);
      const pageIds = new Set(pageItems.map((item) => item.id));

      const container = document.getElementById('cards-container');
      filtered.forEach((item) => {
        const el = cardById.get(item.id);
        if (el) container?.appendChild(el);
      });

      cardItems.forEach((card) => {
        const id = card.getAttribute('data-id') || '';
        card.style.display = pageIds.has(id) ? '' : 'none';
      });

      const start = (current - 1) * PAGE_SIZE;
      if (countLabel) {
        countLabel.textContent = visibleCount === 0
          ? '0 entries'
          : `${start + 1}–${Math.min(start + PAGE_SIZE, visibleCount)} of ${visibleCount} entries`;
      }
      renderPagination(current, pageCount);

      if (noResultsMsg) {
        if (visibleCount === 0) {
          noResultsMsg.classList.remove('hidden');
        } else {
          noResultsMsg.classList.add('hidden');
        }
      }
    }

    function uncheck(name: string, value: string) {
      checkboxes.forEach((cb) => {
        if (cb.name === name && cb.value === value) cb.checked = false;
      });
      writeStateToUrl();
    }

    function clearSearch() {
      if (searchInput) searchInput.value = '';
      updateGrepState();
      removeQueryParam('q');
    }

    function toggleFavFilter() {
      const p = new URLSearchParams(window.location.search);
      if (p.get('fav') === 'true') {
        p.delete('fav');
      } else {
        p.set('fav', 'true');
      }
      const newQuery = p.toString() ? `?${p.toString()}` : window.location.pathname;
      window.history.replaceState({}, '', newQuery);
      readStateFromUrl();
    }

    function removeQueryParam(key: string) {
      const p = new URLSearchParams(window.location.search);
      p.delete(key);
      const newQuery = p.toString() ? `?${p.toString()}` : window.location.pathname;
      window.history.replaceState({}, '', newQuery);
      readStateFromUrl();
    }

    function resetAllFilters() {
      checkboxes.forEach((cb) => (cb.checked = false));
      if (searchInput) searchInput.value = '';
      updateGrepState();
      window.history.replaceState({}, '', window.location.pathname);
      readStateFromUrl();
    }

    checkboxes.forEach((cb) => {
      if (!cb.dataset.bound) {
        cb.dataset.bound = 'true';
        cb.addEventListener('change', writeStateToUrl);
      }
    });

    document.querySelectorAll<HTMLButtonElement>('.theme-chip').forEach((chip) => {
      if (chip.dataset.bound) return;
      chip.dataset.bound = 'true';
      chip.addEventListener('click', () => {
        const cb = checkboxes.find((c) => c.name === 'style' && c.value === chip.dataset.style);
        if (!cb) return;
        cb.checked = !cb.checked;
        writeStateToUrl();
      });
    });

    if (sortSelect && !sortSelect.dataset.bound) {
      sortSelect.dataset.bound = 'true';
      sortSelect.addEventListener('change', writeStateToUrl);
    }

    let searchDebounceTimer: ReturnType<typeof setTimeout>;
    if (searchInput && !searchInput.dataset.bound) {
      searchInput.dataset.bound = 'true';
      searchInput.addEventListener('input', () => {
        updateGrepState();
        clearTimeout(searchDebounceTimer);
        searchDebounceTimer = setTimeout(writeStateToUrl, 180);
      });

      searchInput.addEventListener('keydown', (e) => {
        // Snap [ ↵ ] into place immediately on very first character keystroke
        if (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
          grepSubmitBtn?.classList.remove('hidden');
          grepSubmitBtn?.classList.add('inline-flex');
        }
        if (e.key === 'Enter') {
          clearTimeout(searchDebounceTimer);
          writeStateToUrl();
        }
        if (e.key === 'Escape') {
          clearSearch();
        }
      });
    }

    if (grepSubmitBtn && !grepSubmitBtn.dataset.bound) {
      grepSubmitBtn.dataset.bound = 'true';
      grepSubmitBtn.addEventListener('click', () => {
        clearTimeout(searchDebounceTimer);
        writeStateToUrl();
      });
    }

    if (clearSearchBtn && !clearSearchBtn.dataset.bound) {
      clearSearchBtn.dataset.bound = 'true';
      clearSearchBtn.addEventListener('click', clearSearch);
    }
    if (favsBtn && !favsBtn.dataset.bound) {
      favsBtn.dataset.bound = 'true';
      favsBtn.addEventListener('click', toggleFavFilter);
    }
    if (resetEmptyBtn && !resetEmptyBtn.dataset.bound) {
      resetEmptyBtn.dataset.bound = 'true';
      resetEmptyBtn.addEventListener('click', resetAllFilters);
    }
    if (resetSidebarBtn && !resetSidebarBtn.dataset.bound) {
      resetSidebarBtn.dataset.bound = 'true';
      resetSidebarBtn.addEventListener('click', (e) => {
        e.preventDefault();
        resetAllFilters();
      });
    }

    // Mobile filter drawer toggle
    const toggleMobileBtn = document.getElementById('btn-toggle-filters-mobile');
    const sidebarWrapper = document.getElementById('filters-sidebar-wrapper');
    const chevron = document.getElementById('mobile-filter-chevron');

    if (toggleMobileBtn && sidebarWrapper && !toggleMobileBtn.dataset.bound) {
      toggleMobileBtn.dataset.bound = 'true';
      toggleMobileBtn.addEventListener('click', () => {
        const isHidden = sidebarWrapper.classList.contains('hidden');
        if (isHidden) {
          sidebarWrapper.classList.remove('hidden');
          if (chevron) chevron.textContent = '▲';
        } else {
          sidebarWrapper.classList.add('hidden');
          if (chevron) chevron.textContent = '▼';
        }
      });
    }

    readStateFromUrl();
  }

  setupFilters();
  document.addEventListener('astro:page-load', setupFilters);
</script>
