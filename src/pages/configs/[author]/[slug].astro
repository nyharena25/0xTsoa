---
import Base from '../../../layouts/Base.astro';
import SpecSubNav from '../../../components/SpecSubNav.astro';
import CopyButton from '../../../components/CopyButton.astro';
import Accordion from '../../../components/Accordion.astro';
import CommandLine from '../../../components/CommandLine.astro';
import ScreenshotGallery from '../../../components/ScreenshotGallery.astro';
import AssuranceBadges from '../../../components/AssuranceBadges.astro';
import AtAGlance from '../../../components/AtAGlance.astro';
import RelatedSetups from '../../../components/RelatedSetups.astro';
import AuthorBox from '../../../components/AuthorBox.astro';
import SubmitCta from '../../../components/SubmitCta.astro';
import { getCollection } from 'astro:content';
import { getRenderedReadme, extractScreenshotsFromReadme, readmeExcerpt } from '../../../lib/readme';
import { rawToBlobUrl, blobUrl, hasInstallSteps, isAllowedImageUrl, WM_LABELS, DISTRO_LABELS, STYLE_LABELS, CATEGORY_LABELS } from '../../../lib/schema';
import { buildInstallScript, renderCommand, verifiedScriptCommand, downloadInstallCommand, installScriptPath, installImpact, installDifficulty, attestationVerifyCommand, UPSTREAM_BACKUP_PATHS } from '../../../lib/install';
import { configSeoTitle, configSeoDescription } from '../../../lib/seo';
import { getStarsForConfig, getRepoStats, maintenanceForConfig } from '../../../lib/stats';
import { relatedConfigs, maintainedAlternatives } from '../../../lib/related';
import { liveTopics, primaryTopic, topicForFacet, topicPath } from '../../../lib/topics';
import { useTranslations } from '../../../lib/i18n';
import { withBase, REPO_URL } from '../../../../site.config';

export async function getStaticPaths() {
  const configs = await getCollection('configs');
  return configs.map((entry) => {
    const [author, slug] = entry.id.split('/');
    return {
      params: { author, slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const data = entry.data;
// Reading lists (category resource) may have no steps: they get "Read online" instead of the installer.
const install = hasInstallSteps(data) ? data.install : undefined;
const locale = 'en';
const t = useTranslations(locale);

const { html: rawReadmeHtml, rawUrl: rawReadmeUrl, missing: readmeMissing } = await getRenderedReadme(entry.id, data.source);
const readmeHtml = rawReadmeHtml.replace(
  /<(\/?)h([1-5])(\b[^>]*)>/gi,
  (_, slash: string, level: string, attrs: string) =>
    `<${slash}h${Math.min(6, Math.max(3, Number(level) + 1))}${attrs}>`,
);

const readme = readmeExcerpt(readmeHtml);
const forgeName = ({ 'github.com': 'GitHub', 'gitlab.com': 'GitLab', 'codeberg.org': 'Codeberg' } as Record<string, string>)[new URL(data.source.repo).hostname] ?? 'the forge';
const readmeScreenshots = extractScreenshotsFromReadme(readmeHtml).filter((s) => isAllowedImageUrl(s.url));
const existingShotUrls = new Set(data.screenshots.map((s) => s.url));
const mergedScreenshots = [...data.screenshots];
for (const shot of readmeScreenshots) {
  if (!existingShotUrls.has(shot.url)) {
    existingShotUrls.add(shot.url);
    mergedScreenshots.push({
      url: shot.url,
      alt: shot.alt || `${data.name} screenshot`,
      caption: shot.caption || `CAPTURE_${String(mergedScreenshots.length + 1).padStart(2, '0')}.RAW`,
    });
  }
}

const allConfigs = await getCollection('configs');
const maintenance = maintenanceForConfig(entry.id, data.tags);
const relatedOptions = { stars: getStarsForConfig, status: (id: string, d: typeof data) => maintenanceForConfig(id, d.tags) };
const related = relatedConfigs({ id: entry.id, data }, allConfigs, relatedOptions);
// Topic pages this entry belongs to: the breadcrumb parent and the header's category / WM links.
const topics = liveTopics(allConfigs).map((t) => t.topic);
const parentTopic = primaryTopic(data, topics);
const categoryTopic = topicForFacet(topics, { kind: 'category', value: data.category });
const wmTopic = topicForFacet(topics, { kind: 'wm', value: data.wm });
const categoryHref = withBase(categoryTopic ? topicPath(categoryTopic.slug) : `/catalogue/?category=${data.category}`);
const wmHref = withBase(wmTopic ? topicPath(wmTopic.slug) : `/catalogue/?wm=${data.wm}`);
const parent = parentTopic
  ? { label: parentTopic.label, href: withBase(topicPath(parentTopic.slug)) }
  : { label: 'Catalogue', href: withBase('/catalogue/') };
const alternatives = maintenance === 'archived' ? maintainedAlternatives({ id: entry.id, data }, allConfigs, relatedOptions) : [];

// Sections exist only when upstream has the content; numbering and the sticky nav follow.
const realScreenshots = mergedScreenshots.filter((s) => !s.url.endsWith('/screenshots/fallback-terminal.svg'));
const sections = (
  [
    ['overview', t('spec.sectionOverview')],
    install ? ['installation', t('spec.sectionInstall')] : ['read-online', t('spec.sectionReadOnline')],
    realScreenshots.length > 0 && ['screenshots', t('spec.sectionScreenshots')],
    !readmeMissing && ['readme', t('spec.sectionReadme')],
    data.keybindings.length > 0 && ['keybindings', t('spec.keybindings')],
    related.length > 0 && ['related', t('spec.sectionRelated')],
    ['author', t('spec.sectionAuthor')],
  ].filter(Boolean) as [string, string][]
).map(([id, label], i) => ({ id, title: `${String(i + 1).padStart(2, '0')}. ${label}` }));
const sectionTitle = Object.fromEntries(sections.map((s) => [s.id, s.title]));

const distroLabels = data.distros.map((d) => DISTRO_LABELS[d] || d).join(', ');
const wmLabel = WM_LABELS[data.wm] || data.wm;

// Every fact on the page (title, description, At a glance, trust panel) comes from the same classification the installer uses.
const impact = installImpact(data);
const difficulty = installDifficulty(data);
const seoTitle = configSeoTitle(data);
const seoDescription = configSeoDescription(data, difficulty, impact);

const primaryShot = data.screenshots[0];
const ogImageUrl = primaryShot?.url;
const ogImageAlt = primaryShot?.alt || `${data.name} (${wmLabel}) desktop screenshot`;
const resolvedShotUrl = !ogImageUrl
  ? new URL(withBase('/og.png'), Astro.site).href
  : ogImageUrl.startsWith('http://') || ogImageUrl.startsWith('https://')
    ? ogImageUrl
    : new URL(withBase(ogImageUrl), Astro.site).href;
const canonicalPageUrl = new URL(Astro.url.pathname, Astro.site).href;
const siteRootUrl = new URL(withBase('/'), Astro.site).href;
const aboutUrl = new URL(withBase('/about/'), Astro.site).href;

const setupJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: data.name,
    description: seoDescription,
    url: canonicalPageUrl,
    codeRepository: data.source.repo,
    ...(data.version ? { version: data.version } : {}),
    author:
      data.author.github.toLowerCase() === 'nyharena25'
        ? {
            '@type': 'Person',
            '@id': `${siteRootUrl}#founder`,
            name: 'Ny Harena RAVELOMANANTSOA',
            url: aboutUrl,
            sameAs: [
              'https://github.com/nyharena25',
              'https://www.linkedin.com/in/rnyharena-dev/',
            ],
          }
        : {
            '@type': 'Person',
            name: data.author.name,
            url: `https://github.com/${data.author.github}`,
          },
    license: /^[A-Za-z0-9.+-]+$/.test(data.license)
      ? `https://spdx.org/licenses/${data.license}.html`
      : data.license,
    dateModified: data.updatedAt,
    image: resolvedShotUrl,
    operatingSystem: 'Linux',
    ...(data.tags.length > 0 ? { keywords: data.tags.join(', ') } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: new URL(withBase('/'), Astro.site).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: parent.label,
        item: new URL(parent.href, Astro.site).href,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: data.name,
        item: canonicalPageUrl,
      },
    ],
  },
];

const scriptBlobUrl = install?.script ? rawToBlobUrl(install.script.url) : '';
const verifiedScriptCmd = install?.script ? verifiedScriptCommand(install.script) : null;
const installScriptContent = install ? buildInstallScript(data, entry.id) : '';
const downloadCmd = downloadInstallCommand(entry.id);
const scriptHref = withBase(installScriptPath(entry.id));
const verifyCmd = attestationVerifyCommand();
const repoUrl = data.source.repo.replace(/\.git$/, '');
const commitUrl = `${repoUrl}/tree/${data.source.ref}`;
const configFileUrl = `${REPO_URL}/blob/main/configs/${entry.id}.json`;
const reviewDir = `~/0xtsoa-review/${entry.id.replace('/', '-')}`;
const reviewClone = `git clone ${repoUrl} ${reviewDir}`;
const reviewCheckout = `git -C ${reviewDir} checkout --detach ${data.source.ref}`;
// Manual path: copy every home path the steps write (plus the usual desktop folders when an
// upstream installer runs) before running them. Same list as the guided installer.
const manualBackupPaths = [
  ...impact.userPaths.map((p) => p.replace(/\/$/, '')),
  ...(impact.upstreamCommands.length ? UPSTREAM_BACKUP_PATHS.map((p) => `~/${p}`) : []),
].filter((p, i, all) => all.indexOf(p) === i);
const manualBackup = manualBackupPaths.length
  ? `for p in ${manualBackupPaths.join(' ')}; do [ -e "$p" ] && cp -a "$p" "$p.bak-0xtsoa"; done`
  : '';
const allPackages = [...impact.packages, ...impact.aurPackages];
const renderedSteps = (install?.steps ?? []).map((step) => ({
  ...step,
  commands: step.commands.map((cmd) => renderCommand(cmd, data)),
}));
---

<Base
  title={seoTitle}
  description={seoDescription}
  locale={locale}
  statusPrefix="[SHOW CASE: "
  statusInitial={data.author.name.toUpperCase()}
  statusFinal={data.name.toUpperCase()}
  ogImage={ogImageUrl}
  ogImageAlt={ogImageAlt}
  ogType="article"
  updatedAt={data.updatedAt}
  jsonLd={setupJsonLd}
>
  <SpecSubNav configId={entry.id} name={data.name} sections={sections} locale={locale} parent={parent} />

  <div class="max-w-7xl mx-auto px-4 lg:px-8 py-6 flex flex-col gap-6 w-full min-w-0" data-pagefind-body>
    <span class="hidden" data-pagefind-meta="wm">{data.wm}</span>
    <span class="hidden" data-pagefind-meta="author">{data.author.name}</span>
    <span class="hidden" data-pagefind-meta="distros">{data.distros.join(' ')}</span>

    <!-- PAGE HEADER: the one H1, then what it is in plain words -->
    <header class="flex flex-col gap-2.5 w-full min-w-0 pt-1">
      <p class="font-mono text-[11px] uppercase tracking-wider text-zinc-500 flex flex-wrap items-center gap-x-1.5 gap-y-1">
        <a href={categoryHref} class="underline hover:text-zinc-900">{CATEGORY_LABELS[data.category]}</a>
        {data.wm !== 'any' && <><span aria-hidden="true">·</span><a href={wmHref} class="underline hover:text-zinc-900">{wmLabel}</a></>}
        <span aria-hidden="true">·</span>
        <span>by <a href={`https://github.com/${data.author.github}`} target="_blank" rel="noopener noreferrer" class="underline hover:text-zinc-900 normal-case">@{data.author.github}</a></span>
      </p>
      <h1 class="font-display text-2xl sm:text-4xl font-bold text-zinc-900 tracking-tight break-words m-0" data-page-title="true">{data.name}</h1>
      <p class="font-sans text-base sm:text-lg text-zinc-700 leading-relaxed max-w-3xl m-0">{data.summary}</p>
      {data.description && <p class="font-sans text-sm sm:text-base text-zinc-600 leading-relaxed max-w-3xl m-0">{data.description}</p>}
    </header>

    {maintenance === 'archived' && (
      <aside class="border border-amber-200 bg-amber-50/70 rounded-xl p-3.5 font-mono text-[11px] text-amber-950 leading-relaxed flex flex-col gap-1.5" aria-label="Upstream archived">
        <span class="font-bold text-xs">Upstream archived</span>
        <span>The author has made the repository read-only. It may still work, but bugs will not be fixed and new {data.wm === 'any' ? 'desktop' : wmLabel} releases may break it.</span>
        {alternatives.length > 0 && (
          <span>
            Maintained alternatives:{' '}
            {alternatives.map((a, i) => <>{i > 0 && ', '}<a href={withBase(`/configs/${a.id}/`)} class="underline font-semibold">{a.data.name}</a></>)}
          </span>
        )}
      </aside>
    )}

    <AtAGlance
      data={data}
      difficulty={difficulty}
      impact={impact}
      maintenance={maintenance}
      repoStats={getRepoStats(entry.id)}
      commitUrl={commitUrl}
    />

    <!-- SPECIFICATION OVERVIEW -->
    <section class="bg-white border border-zinc-200 rounded-xl shadow-xs p-4 sm:p-7 w-full min-w-0" id="overview">
      <div class="border-b border-zinc-200 pb-3 mb-4 sm:mb-5 flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2.5">
          <span class="w-2 h-2 rounded-full bg-zinc-900 inline-block"></span>
          <h2 class="font-mono text-xs sm:text-sm uppercase font-bold text-zinc-900 tracking-wider">
            {sectionTitle.overview}
          </h2>
        </div>
        {data.version && (
          <span class="font-mono text-xs text-zinc-600 bg-zinc-100 border border-zinc-200 px-2.5 py-0.5 rounded-md">Profile: {data.version}</span>
        )}
      </div>

      <div class="mb-4">
        <AssuranceBadges data={data} />
      </div>

      <div class="border border-zinc-200 rounded-lg overflow-hidden bg-white font-mono text-xs">
        <dl class="divide-y divide-zinc-100">
          <div class="grid grid-cols-1 md:grid-cols-12 p-3 sm:p-3.5 bg-zinc-50/70 min-w-0 break-words gap-1 md:gap-0">
            <dt class="md:col-span-3 font-semibold uppercase text-zinc-500 tracking-wider text-[11px] mb-1 md:mb-0">Purpose</dt>
            <dd class="md:col-span-9 text-zinc-900 font-sans leading-relaxed text-sm min-w-0 break-words">{data.summary}</dd>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 p-3 sm:p-3.5 bg-white min-w-0 break-words gap-1 md:gap-0">
            <dt class="md:col-span-3 font-semibold uppercase text-zinc-500 tracking-wider text-[11px] mb-1 md:mb-0">Compatibility</dt>
            <dd class="md:col-span-9 text-zinc-900 font-medium min-w-0 break-words">{distroLabels} (Server: {data.displayServer.toUpperCase()})</dd>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 p-3 sm:p-3.5 bg-zinc-50/70 min-w-0 break-words gap-1 md:gap-0">
            <dt class="md:col-span-3 font-semibold uppercase text-zinc-500 tracking-wider text-[11px] mb-1 md:mb-0">Desktop Part</dt>
            <dd class="md:col-span-9 text-zinc-900 font-medium min-w-0 break-words"><a class="underline" href={categoryHref}>{CATEGORY_LABELS[data.category]}</a></dd>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 p-3 sm:p-3.5 bg-white min-w-0 break-words gap-1 md:gap-0">
            <dt class="md:col-span-3 font-semibold uppercase text-zinc-500 tracking-wider text-[11px] mb-1 md:mb-0">Window Manager & Theme</dt>
            <dd class="md:col-span-9 text-zinc-900 font-medium min-w-0 break-words">{wmLabel} <span class="text-zinc-400">/</span> {data.specs.theme || STYLE_LABELS[data.themeStyle]}</dd>
          </div>

          {(data.specs.bar || data.specs.terminal || data.specs.launcher || data.specs.notifications || data.specs.editor || data.specs.shell) && (
          <div class="grid grid-cols-1 md:grid-cols-12 p-3 sm:p-3.5 bg-zinc-50/70 min-w-0 break-words gap-1.5 md:gap-0">
            <dt class="md:col-span-3 font-semibold uppercase text-zinc-500 tracking-wider text-[11px] mb-1 md:mb-0">Key Components</dt>
            <dd class="md:col-span-9 text-zinc-900 leading-relaxed font-sans text-sm min-w-0 break-words">
              <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5 text-xs">
                {(
                  [
                    data.specs.bar && ['Bar', data.specs.bar],
                    data.specs.terminal && ['Terminal', data.specs.terminal],
                    data.specs.launcher && ['Launcher', data.specs.launcher],
                    data.specs.notifications && ['Notifications', data.specs.notifications],
                    data.specs.editor && ['Editor', data.specs.editor],
                    data.specs.shell && ['Shell', data.specs.shell],
                  ].filter(Boolean) as [string, string][]
                ).map(([label, value], idx) => (
                  <>
                    {idx > 0 && <span class="text-zinc-300">•</span>}
                    <span class="inline-flex items-center gap-1">
                      <span class="font-mono font-semibold text-zinc-500">{label}:</span>
                      <span class="font-medium text-zinc-900">{value}</span>
                    </span>
                  </>
                ))}
              </div>
            </dd>
          </div>
          )}

        </dl>
      </div>
    </section>

    <!-- INSTALLATION & PACKAGES (or READ ONLINE for reading lists) -->
    {install ? (
    <section class="bg-white border border-zinc-200 rounded-xl shadow-xs p-4 sm:p-7 flex flex-col gap-4 w-full min-w-0 overflow-hidden" id="installation">
      <div class="border-b border-zinc-200 pb-3 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="w-2 h-2 rounded-full bg-zinc-900 inline-block"></span>
          <h2 class="font-mono text-xs sm:text-sm uppercase font-bold text-zinc-900 tracking-wider">
            {sectionTitle.installation}
          </h2>
        </div>
      </div>

      <div class="flex flex-col gap-3 w-full min-w-0">
        <!-- Before you install: only claims the installer and its tests guarantee -->
        <div class="border border-amber-200 bg-amber-50/70 rounded-xl p-3.5 font-mono text-[11px] text-amber-950 leading-relaxed flex flex-col gap-1.5">
          <span class="font-bold text-xs">Before you install</span>
          <span>This changes your desktop configuration{allPackages.length > 0 && ' and installs packages'}. Run it as your normal user, never with <code>sudo</code>: it asks for sudo only where a step needs it (listed below).</span>
          <span>The guided installer shows its plan first. Files it would replace are kept unless you approve. Everything it copies, clones or appends to in your home folder is backed up and verified first, and <code>--rollback</code> restores it. Packages, sudo changes and the other commands listed under Impact are not undone.</span>
        </div>

        <!-- Trust panel: origin, integrity, impact, recovery -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 font-mono text-[11px]">
          <div class="border border-zinc-200 rounded-xl p-3 flex flex-col gap-1 min-w-0">
            <span class="uppercase font-bold text-zinc-500 tracking-wider text-[10px]">Origin</span>
            <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="text-zinc-900 font-semibold underline break-all">{repoUrl.replace('https://', '')}</a>
            <span class="text-zinc-600">Pinned to <a href={commitUrl} target="_blank" rel="noopener noreferrer" class="underline">{data.source.ref.slice(0, 12)}</a> · reviewed in <a href={configFileUrl} target="_blank" rel="noopener noreferrer" class="underline">this config file</a></span>
          </div>
          <div class="border border-zinc-200 rounded-xl p-3 flex flex-col gap-1 min-w-0">
            <span class="uppercase font-bold text-zinc-500 tracking-wider text-[10px]">Integrity</span>
            <span class="text-zinc-700">Each release from <code class="text-zinc-900">main</code> builds the installers in GitHub Actions and signs them with a GitHub build attestation. Verify your download against the repository, not this website (Option B, step 2). If it does not verify, don't run it.</span>
          </div>
          <div class="border border-zinc-200 rounded-xl p-3 flex flex-col gap-1 min-w-0">
            <span class="uppercase font-bold text-zinc-500 tracking-wider text-[10px]">Impact</span>
            {allPackages.length > 0 && <span class="text-zinc-700">Packages: <strong class="text-zinc-900">{allPackages.join(', ')}</strong>{impact.aurPackages.length > 0 && ' (some from the Arch AUR)'}</span>}
            {impact.userPaths.length > 0 && <span class="text-zinc-700 break-all">Writes: <strong class="text-zinc-900">{impact.userPaths.join(', ')}</strong></span>}
            {impact.systemCommands.map((c) => <span class="text-zinc-700 break-all">Uses sudo: <code class="text-zinc-900">{c}</code></span>)}
            {impact.upstreamCommands.map((c) => <span class="text-zinc-700 break-all">Runs the upstream installer <code class="text-zinc-900">{c}</code>, which manages its own files. The guided installer backs up your usual desktop config folders first.</span>)}
            {impact.execCommands.length > 0 && <span class="text-zinc-700 break-all">Also runs (not undone by rollback): {impact.execCommands.map((c, i) => <>{i > 0 && ', '}<code class="text-zinc-900">{c}</code></>)}</span>}
            {allPackages.length + impact.userPaths.length + impact.systemCommands.length + impact.upstreamCommands.length + impact.execCommands.length === 0 && <span class="text-zinc-700">Runs the commands listed in the steps below.</span>}
          </div>
          <div class="border border-zinc-200 rounded-xl p-3 flex flex-col gap-1 min-w-0">
            <span class="uppercase font-bold text-zinc-500 tracking-wider text-[10px]">Recovery</span>
            <span class="text-zinc-700">Guided: backups in <code class="text-zinc-900">~/.local/state/0xtsoa/backups/</code>, undo with <code class="text-zinc-900">bash install.sh --rollback</code>.</span>
            <span class="text-zinc-700">{manualBackup ? 'Manual: back up first (Option A, step 3).' : 'Manual: the steps below only write in the download folder or run listed commands.'}</span>
          </div>
        </div>

        <!-- Option A: manual, for people who want to read and run every step -->
        <div class="flex flex-col gap-2 border border-zinc-200 rounded-xl p-3.5">
          <div class="flex items-center justify-between gap-2">
            <span class="font-mono text-xs font-bold text-zinc-900">Option A: manual install</span>
            <span class="font-mono text-[10px] uppercase font-bold text-zinc-500 border border-zinc-200 rounded px-1.5 py-0.5">Advanced</span>
          </div>
          <span class="font-mono text-[11px] text-zinc-600">Read the source at the reviewed commit, back up, then run each step yourself.</span>
          <CommandLine cmd={reviewClone} comment="# 1. clone to a review folder" />
          <CommandLine cmd={reviewCheckout} comment="# 2. the reviewed commit" />
          {manualBackup && <CommandLine cmd={manualBackup} comment="# 3. back up what the steps write" />}
          {impact.upstreamCommands.length > 0 && (
            <span class="font-mono text-[11px] text-zinc-600">Read the upstream installer in <code class="text-zinc-900">{reviewDir}</code> before running it, and every script it calls.</span>
          )}
          <span class="font-mono text-[11px] text-zinc-500">Then the steps. Package commands are written for Arch; on other distros use your package manager.</span>
          <Accordion steps={renderedSteps} data={data} locale={locale} />
        </div>

        <!-- Option B: guided installer: download, verify, read, preview, install -->
        <div class="flex flex-col gap-2 border-2 border-zinc-900 rounded-xl p-3.5">
          <div class="flex items-center justify-between gap-2">
            <span class="font-mono text-xs font-bold text-zinc-900">Option B: guided installer</span>
            <span class="font-mono text-[10px] uppercase font-bold text-white bg-zinc-900 rounded px-1.5 py-0.5">Recommended</span>
          </div>
          <span class="font-mono text-[11px] text-zinc-600 leading-relaxed">
            The same steps as one script for any distro. It shows the plan first, keeps files you already have unless you approve replacing them,
            and backs up everything it changes in your home folder. Never pipe it into a shell.
          </span>
          <CommandLine cmd={downloadCmd} comment="# 1. download" />
          <CommandLine cmd={verifyCmd} comment="# 2. verify (GitHub CLI 2.49+, signed in)" />
          <CommandLine cmd="less install.sh" comment="# 3. read it" />
          <CommandLine cmd="bash install.sh --dry-run" comment="# 4. preview: changes nothing" />
          <CommandLine cmd="bash install.sh" comment="# 5. install (asks first)" />
          <CommandLine cmd="bash install.sh --rollback" comment="# undo the file changes" />
          <div class="flex flex-wrap items-center gap-2.5 pt-1">
            <a
              href={scriptHref}
              target="_blank"
              rel="noopener"
              class="min-h-[44px] inline-flex items-center justify-center gap-2 border border-zinc-300 bg-white hover:bg-zinc-100 text-zinc-800 px-4 py-2 rounded-lg font-mono text-xs font-semibold shadow-2xs transition-colors"
            >
              View script in browser
            </a>
            <button
              type="button"
              id="btn-download-sh"
              data-filename="install.sh"
              data-script={installScriptContent}
              class="min-h-[44px] inline-flex items-center justify-center gap-2 border border-zinc-300 bg-white hover:bg-zinc-100 text-zinc-800 px-4 py-2 rounded-lg font-mono text-xs font-semibold shadow-2xs transition-colors cursor-pointer"
            >
              <svg class="w-4 h-4 text-zinc-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
              </svg>
              <span>Download install.sh</span>
            </button>
            <span class="font-mono text-[11px] text-zinc-500">Other options: <code class="text-zinc-800">--force</code> (replace conflicts, backed up first), <code class="text-zinc-800">--yes</code>, <code class="text-zinc-800">--help</code></span>
          </div>
        </div>

        <!-- Security Notice & Hash Verification -->
        {install.script && (
          <div class="bg-amber-50/80 border border-amber-200 rounded-xl p-3.5 font-mono text-xs text-amber-900 flex flex-col sm:flex-row sm:items-center justify-between gap-2 shadow-2xs">
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-md bg-amber-200 text-amber-900 font-bold flex items-center justify-center text-xs shrink-0">!</span>
              <span>{t('spec.securityNotice')}</span>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <a
                href={scriptBlobUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="underline font-semibold text-amber-950 hover:text-black"
              >
                {t('spec.viewSource')}
              </a>
            </div>
          </div>
        )}

        {install.script && verifiedScriptCmd && (
          <div class="border border-zinc-800 bg-zinc-900 text-zinc-100 p-2.5 rounded-lg flex items-center justify-between gap-2.5 font-mono text-xs shadow-inner w-full max-w-full overflow-hidden">
            <div class="flex items-center gap-2 min-w-0 flex-1 overflow-x-auto py-0.5">
              <span class="text-emerald-400 font-bold select-none shrink-0">$</span>
              <code class="text-zinc-200 select-all whitespace-nowrap font-mono text-[11px] sm:text-xs">{verifiedScriptCmd}</code>
            </div>
            <div class="shrink-0">
              <CopyButton text={verifiedScriptCmd} tone="dark" />
            </div>
          </div>
        )}

        {install.script && (
          <div class="border border-zinc-200 rounded-xl bg-zinc-50 p-3 font-mono text-xs text-zinc-600 flex flex-wrap items-center justify-between gap-2">
            <span class="font-medium">{t('spec.checksum')}</span>
            <code class="text-zinc-900 font-semibold select-all break-all">{install.script.sha256}</code>
            <CopyButton text={install.script.sha256} label="Copy Hash" class="py-0.5 text-[11px]" />
          </div>
        )}
      </div>

      <!-- Alternative package archives -->
      {install.packages.length > 0 && (
        <div class="flex items-center gap-2 font-mono text-xs pt-1">
          <span class="text-zinc-500 uppercase">Alternative Packages:</span>
          <div class="flex flex-wrap gap-2">
            {install.packages.map((pkg) => (
              <a
                href={pkg.url}
                target="_blank"
                rel="noopener noreferrer"
                class="border border-zinc-200 bg-white hover:bg-zinc-900 hover:text-white px-2.5 py-1 rounded-md shadow-2xs uppercase font-medium transition-colors"
              >
                .{pkg.type}
              </a>
            ))}
          </div>
        </div>
      )}

    </section>
    ) : (
    <section class="bg-white border border-zinc-200 rounded-xl shadow-xs p-4 sm:p-7 flex flex-col gap-4 w-full min-w-0" id="read-online">
      <div class="border-b border-zinc-200 pb-3 flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-zinc-900 inline-block"></span>
        <h2 class="font-mono text-xs sm:text-sm uppercase font-bold text-zinc-900 tracking-wider">
          {sectionTitle['read-online']}
        </h2>
      </div>
      <p class="font-mono text-[11px] text-zinc-600 leading-relaxed">
        A reading list: nothing to install. Browse it at the reviewed commit{' '}
        <a href={commitUrl} target="_blank" rel="noopener noreferrer" class="underline text-zinc-900">{data.source.ref.slice(0, 12)}</a>.
      </p>
      <div class="flex flex-wrap gap-2.5">
        <a href={commitUrl} target="_blank" rel="noopener noreferrer" class="btn-solid min-h-[44px] justify-center">
          <span>Browse the repository</span>
          <span>&rarr;</span>
        </a>
        <a href={blobUrl(data.source)} target="_blank" rel="noopener noreferrer" class="btn-outline min-h-[44px] justify-center">
          Open {data.source.readme}
        </a>
      </div>
    </section>
    )}

    <!-- SCREENSHOT GALLERY -->
    {realScreenshots.length > 0 && (
      <ScreenshotGallery screenshots={realScreenshots} configName={data.name} title={sectionTitle.screenshots} />
    )}

    <!-- DOCUMENTATION // README.MD -->
    {!readmeMissing && (
    <section class="bg-white border border-zinc-200 rounded-xl shadow-xs p-4 sm:p-7 flex flex-col gap-4 w-full min-w-0 overflow-hidden" id="readme">
      <div class="border-b border-zinc-200 pb-3 flex flex-wrap items-center justify-between gap-2 font-mono text-xs">
        <div class="flex items-center gap-2.5">
          <span class="w-2 h-2 rounded-full bg-zinc-900 inline-block"></span>
          <h2 class="text-xs sm:text-sm uppercase font-bold text-zinc-900 tracking-wider">
            {sectionTitle.readme}
          </h2>
        </div>
        <div class="flex items-center gap-3 text-zinc-500">
          <span>Source: <a href={data.source.repo} target="_blank" rel="noopener noreferrer" class="underline text-zinc-900 font-semibold">{data.source.repo.replace(/^https:\/\/(github\.com|gitlab\.com|codeberg\.org)\//, '')}</a></span>
          <span>Ref: <code class="text-zinc-900 font-medium">{data.source.ref.slice(0, 10)}</code></span>
        </div>
      </div>

      <!-- Authentic GitHub Repository File Box -->
      <div class="border border-zinc-300 rounded-lg overflow-hidden bg-white shadow-2xs w-full min-w-0">
        <!-- GitHub File Header Bar -->
        <div class="bg-[#f6f8fa] border-b border-[#d0d7de] px-4 py-2.5 flex items-center justify-between flex-wrap gap-2 text-xs">
          <div class="flex items-center gap-2 text-zinc-800 font-mono font-semibold">
            <!-- GitHub Book Octicon -->
            <svg class="w-4 h-4 text-zinc-500 shrink-0 fill-current" viewBox="0 0 16 16">
              <path d="M0 1.75A.75.75 0 0 1 .75 1h4.253c1.227 0 2.317.59 3 1.501A3.743 3.743 0 0 1 11.006 1h4.241a.75.75 0 0 1 .75.75v10.5a.75.75 0 0 1-.75.75h-4.25a2.25 2.25 0 0 0-1.5.572V14.5a.75.75 0 0 1-1.5 0v-1.178A2.25 2.25 0 0 0 6.5 12.75H2.25a.75.75 0 0 1-.75-.75V1.75ZM1.5 12.008a3.74 3.74 0 0 1 2.25-.758h2.75v-9.5H2.253a2.25 2.25 0 0 0-1.753.84v9.418ZM7.5 11.25V2.41a2.25 2.25 0 0 0-1.747-.66H2.253v9.5H6.5c.348 0 .686.04 1 .116Zm1 0c.314-.076.652-.116 1-.116h4.25v-9.5H11.006a2.25 2.25 0 0 0-1.753.66v8.84Zm5.5.758a3.74 3.74 0 0 1-2.25-.758v-9.5h2.241a2.25 2.25 0 0 0-1.741.84v9.418Z"></path>
            </svg>
            <span class="font-bold text-zinc-900">{data.source.readme || 'README.md'}</span>
            <span class="text-zinc-400 font-normal">|</span>
            <span class="text-zinc-500 font-mono text-[11px] font-normal">GitHub Flavored Markdown</span>
          </div>

          <div class="flex items-center gap-2">
            <a
              href={rawReadmeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono font-medium text-zinc-700 bg-white border border-zinc-300 rounded hover:bg-zinc-100 hover:text-zinc-900 transition-colors shadow-2xs"
            >
              <span>Raw</span>
            </a>
            <a
              href={blobUrl(data.source)}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono font-medium text-zinc-700 bg-white border border-zinc-300 rounded hover:bg-zinc-100 hover:text-zinc-900 transition-colors shadow-2xs"
            >
              <span>Source ↗</span>
            </a>
          </div>
        </div>

        <!-- Official GitHub Markdown Body -->
        <div class="p-5 sm:p-8 md:p-10 bg-white w-full max-w-full overflow-x-auto">
          <article class="markdown-body" set:html={readme.html} />
        </div>
        {readme.truncated && (
          <div class="border-t border-[#d0d7de] bg-[#f6f8fa] px-4 py-3 flex flex-wrap items-center justify-between gap-2 font-mono text-xs">
            <span class="text-zinc-600">This is the opening of the README. The full guide lives in the repository.</span>
            <a href={blobUrl(data.source)} target="_blank" rel="noopener noreferrer" class="btn-solid text-xs py-1.5 px-3">
              <span>Continue reading on {forgeName}</span>
              <span>&rarr;</span>
            </a>
          </div>
        )}
      </div>

      <div class="border-t border-zinc-100 pt-3 flex items-center justify-between font-mono text-xs text-zinc-400">
        <span>{readme.truncated ? 'Excerpt of the upstream README' : 'Upstream README'}</span>
        <span>at {data.source.ref.slice(0, 10)}</span>
      </div>
    </section>
    )}

    <!-- KEYBOARD KEYBINDINGS -->
    {data.keybindings && data.keybindings.length > 0 && (
      <section class="bg-white border border-zinc-200 rounded-xl shadow-xs p-4 sm:p-7 w-full min-w-0 overflow-hidden" id="keybindings">
        <div class="border-b border-zinc-200 pb-3 mb-4 flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-2.5">
            <span class="w-2 h-2 rounded-full bg-zinc-900 inline-block"></span>
            <h2 class="font-mono text-xs sm:text-sm uppercase font-bold text-zinc-900 tracking-wider">
              {sectionTitle.keybindings}
            </h2>
          </div>
          <span class="font-mono text-xs text-zinc-400">Total: {data.keybindings.length} shortcuts</span>
        </div>

        <!-- Desktop Table View -->
        <div class="hidden sm:block border border-zinc-200 rounded-lg overflow-x-auto bg-white">
          <table class="w-full text-left font-mono text-xs border-collapse">
            <thead class="bg-zinc-50 border-b border-zinc-200 font-semibold text-zinc-600 text-[11px] uppercase">
              <tr>
                <th class="p-3 border-r border-zinc-100">Keys</th>
                <th class="p-3 border-r border-zinc-100">Action</th>
                <th class="p-3">Effect</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-100 bg-white">
              {data.keybindings.map((kb) => (
                <tr class="hover:bg-zinc-50/60 transition-colors">
                  <td class="p-3 border-r border-zinc-100 font-medium text-zinc-900 whitespace-nowrap">
                    <kbd class="px-2 py-0.5 bg-zinc-100 border border-zinc-300 rounded font-semibold text-zinc-800 shadow-2xs">{kb.keys}</kbd>
                  </td>
                  <td class="p-3 border-r border-zinc-100 font-semibold text-zinc-900">{kb.action}</td>
                  <td class="p-3 text-zinc-500">{kb.effect || '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Mobile Stacked Card View (Eliminates horizontal clipping) -->
        <div class="sm:hidden flex flex-col gap-2.5">
          {data.keybindings.map((kb) => (
            <div class="border border-zinc-200 rounded-lg p-3 bg-zinc-50/50 flex flex-col gap-1.5 shadow-2xs">
              <div class="flex items-center justify-between gap-2">
                <kbd class="px-2.5 py-1 bg-white border border-zinc-300 rounded font-mono text-xs font-bold text-zinc-900 shadow-2xs">
                  {kb.keys}
                </kbd>
                <span class="font-mono text-[10px] text-zinc-400 uppercase">Shortcut</span>
              </div>
              <div class="font-mono text-xs font-bold text-zinc-900 break-words pt-0.5">
                {kb.action}
              </div>
              {kb.effect && (
                <div class="font-sans text-xs text-zinc-600 leading-normal break-words border-t border-zinc-200/60 pt-1.5 mt-0.5">
                  {kb.effect}
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    {related.length > 0 && <RelatedSetups entries={related} title={sectionTitle.related} />}

    <AuthorBox id={entry.id} name={data.name} github={data.author.github} repo={data.source.repo} verified={data.author.verified} title={sectionTitle.author} />

    <SubmitCta heading="Have a setup like this one?" context={{ category: data.category, wm: data.wm }} />
  </div>

  <script>
    function setupDetailActions() {
      // 1. Download shell script (.sh)
      const btnDownloadSh = document.getElementById('btn-download-sh');
      if (btnDownloadSh && !btnDownloadSh.dataset.bound) {
        btnDownloadSh.dataset.bound = 'true';
        btnDownloadSh.addEventListener('click', () => {
          const filename = btnDownloadSh.getAttribute('data-filename') || 'install.sh';
          const scriptContent = btnDownloadSh.getAttribute('data-script') || '';
          const blob = new Blob([scriptContent], { type: 'text/x-shellscript;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = filename;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        });
      }
    }

    setupDetailActions();
    document.addEventListener('astro:page-load', setupDetailActions);
  </script>
</Base>
