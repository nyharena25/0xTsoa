---
import Base from '../../../layouts/Base.astro';
import SpecSubNav from '../../../components/SpecSubNav.astro';
import CopyButton from '../../../components/CopyButton.astro';
import Accordion from '../../../components/Accordion.astro';
import ScreenshotGallery from '../../../components/ScreenshotGallery.astro';
import { getCollection } from 'astro:content';
import { getRenderedReadme, extractScreenshotsFromReadme } from '../../../lib/readme';
import { rawToBlobUrl, WM_LABELS, DISTRO_LABELS } from '../../../lib/schema';
import { useTranslations } from '../../../lib/i18n';
import { withBase } from '../../../../site.config';

export async function getStaticPaths() {
  const configs = await getCollection('configs');
  return configs.map((entry) => {
    const [author, slug] = entry.id.split('/');
    return {
      params: { author, slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const data = entry.data;
const locale = 'en';
const t = useTranslations(locale);

const { html: rawReadmeHtml, rawUrl: rawReadmeUrl } = await getRenderedReadme(
  entry.id,
  data.source,
  data,
);
const readmeHtml = rawReadmeHtml.replace(
  /<(\/?)h([1-5])(\b[^>]*)>/gi,
  (_, slash: string, level: string, attrs: string) =>
    `<${slash}h${Math.min(6, Math.max(3, Number(level) + 1))}${attrs}>`,
);

const readmeScreenshots = extractScreenshotsFromReadme(readmeHtml);
const existingShotUrls = new Set(data.screenshots.map((s) => s.url));
const mergedScreenshots = [...data.screenshots];
for (const shot of readmeScreenshots) {
  if (!existingShotUrls.has(shot.url)) {
    existingShotUrls.add(shot.url);
    mergedScreenshots.push({
      url: shot.url,
      alt: shot.alt || `${data.name} screenshot`,
      caption: shot.caption || `CAPTURE_${String(mergedScreenshots.length + 1).padStart(2, '0')}.RAW`,
    });
  }
}

const distroLabels = data.distros.map((d) => DISTRO_LABELS[d] || d).join(', ');
const primaryDistro = DISTRO_LABELS[data.distros[0]] || data.distros[0];
const wmLabel = WM_LABELS[data.wm] || data.wm;

// SEO Title: "{name} by @{github} · {WM} on {Distro}", kept under ~60 chars (drop distro if it doesn't fit)
const fullTitle = `${data.name} by @${data.author.github} · ${wmLabel} on ${primaryDistro}`;
const noDistroTitle = `${data.name} by @${data.author.github} · ${wmLabel}`;
const shortTitle = `${data.name} · ${wmLabel}`;
const seoTitle =
  fullTitle.length <= 60
    ? fullTitle
    : noDistroTitle.length <= 60
      ? noDistroTitle
      : shortTitle.slice(0, 60);

// SEO Description: built from real fields (summary + WM + displayServer + key specs), 140–160 chars
const serverLabel =
  data.displayServer === 'both'
    ? 'Wayland/X11'
    : data.displayServer === 'wayland'
      ? 'Wayland'
      : 'X11';

function buildSetupDescription(): string {
  const baseSummary = data.summary.trim().replace(/\.+$/, '');
  const cleanSpec = (val?: string) => val?.replace(/\s*\([^)]*\)/g, '').trim();
  const specFragments: string[] = [
    `${wmLabel} (${serverLabel}) on ${distroLabels}`,
    ...(data.specs.bar ? [`Bar: ${data.specs.bar}`, `Bar: ${cleanSpec(data.specs.bar)}`] : []),
    ...(data.specs.terminal ? [`Terminal: ${data.specs.terminal}`, `Terminal: ${cleanSpec(data.specs.terminal)}`] : []),
    ...(data.specs.launcher ? [`Launcher: ${data.specs.launcher}`, `Launcher: ${cleanSpec(data.specs.launcher)}`] : []),
    ...(data.specs.theme ? [`Theme: ${data.specs.theme}`, `Theme: ${cleanSpec(data.specs.theme)}`] : []),
    ...(data.specs.shell ? [`Shell: ${data.specs.shell}`] : []),
    ...(data.specs.editor ? [`Editor: ${data.specs.editor}`] : []),
    ...(data.specs.ramIdleMiB ? [`~${data.specs.ramIdleMiB} MiB idle RAM`] : []),
    `License: ${data.license}`,
    `Source: ${data.source.repo.replace(/^https?:\/\//, '')}`,
  ];

  const usedPrefixes = new Set<string>();
  let desc = `${baseSummary}.`;
  for (const frag of specFragments) {
    const prefix = frag.split(':')[0];
    if (usedPrefixes.has(prefix)) continue;
    const cleanFrag = frag.replace(/\.+$/, '');
    const candidate = `${desc} ${cleanFrag}.`;
    if (candidate.length <= 160) {
      desc = candidate;
      usedPrefixes.add(prefix);
    } else if (desc.length < 140) {
      const budget = 159 - desc.length - 1;
      if (budget >= 12) {
        const trimmed = cleanFrag
          .slice(0, budget)
          .replace(/\s*\([^)]*$/, '')
          .replace(/[,;:\s/]+\S*$/, '')
          .trim();
        if (trimmed && !trimmed.includes('(') && desc.length + 1 + trimmed.length + 1 >= 140) {
          desc = `${desc} ${trimmed}.`;
          usedPrefixes.add(prefix);
        }
      }
    }
  }
  if (desc.length > 160) {
    desc = `${desc.slice(0, 157).replace(/\s+\S*$/, '')}...`;
  }
  return desc;
}

const seoDescription = buildSetupDescription();

const primaryShot = data.screenshots[0];
const ogImageUrl = primaryShot?.url;
const ogImageAlt = primaryShot?.alt || `${data.name} (${wmLabel}) desktop screenshot`;
const resolvedShotUrl = !ogImageUrl
  ? new URL(withBase('/og.png'), Astro.site).href
  : ogImageUrl.startsWith('http://') || ogImageUrl.startsWith('https://')
    ? ogImageUrl
    : new URL(withBase(ogImageUrl), Astro.site).href;
const canonicalPageUrl = new URL(Astro.url.pathname, Astro.site).href;

const setupJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: data.name,
    description: seoDescription,
    url: canonicalPageUrl,
    codeRepository: data.source.repo,
    ...(data.version ? { version: data.version } : {}),
    author: {
      '@type': 'Person',
      name: data.author.name,
      url: `https://github.com/${data.author.github}`,
    },
    license: `https://spdx.org/licenses/${data.license}.html`,
    dateModified: data.updatedAt,
    image: resolvedShotUrl,
    operatingSystem: 'Linux',
    ...(data.tags.length > 0 ? { keywords: data.tags.join(', ') } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: new URL(withBase('/'), Astro.site).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Catalogue',
        item: new URL(withBase('/catalogue/'), Astro.site).href,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: data.name,
        item: canonicalPageUrl,
      },
    ],
  },
];

let defaultInstallCmd = `git clone ${data.source.repo} ~/.dotfiles`;
let scriptBlobUrl = '';
if (data.install.script) {
  defaultInstallCmd = `curl -fsSL ${data.install.script.url} | ${data.install.script.shell || 'bash'}`;
  scriptBlobUrl = rawToBlobUrl(data.install.script.url);
}

const installScriptContent = `#!/usr/bin/env bash
# ==============================================================================
# 0xTSOA AUTOMATED INSTALLER // ${data.name.toUpperCase()}
# Version: ${data.version || 'v1.0'}
# Maintainer: ${data.author.name} (@${data.author.github})
# Source: ${data.source.repo}
# Window Manager: ${wmLabel}
# Supported Distros: ${distroLabels}
# ==============================================================================
set -euo pipefail

echo "======================================================================"
echo " [0xTSOA] Starting installation of ${data.name}..."
echo "======================================================================"

${
  data.install.steps && data.install.steps.length > 0
    ? data.install.steps
        .map(
          (step) =>
            `# --- Step: ${step.title} ---\n${step.commands.join('\n')}`,
        )
        .join('\n\n')
    : defaultInstallCmd
}

echo "======================================================================"
echo " [0xTSOA] Installation completed successfully!"
echo "======================================================================"
`;
---

<Base
  title={seoTitle}
  description={seoDescription}
  locale={locale}
  statusPrefix="[SHOW CASE: "
  statusInitial={data.author.name.toUpperCase()}
  statusFinal={data.name.toUpperCase()}
  ogImage={ogImageUrl}
  ogImageAlt={ogImageAlt}
  ogType="article"
  updatedAt={data.updatedAt}
  jsonLd={setupJsonLd}
>
  <SpecSubNav configId={entry.id} name={data.name} locale={locale} />

  <div class="max-w-7xl mx-auto px-4 lg:px-8 py-6 flex flex-col gap-6 w-full min-w-0" data-pagefind-body>
    <span class="hidden" data-pagefind-meta="wm">{data.wm}</span>
    <span class="hidden" data-pagefind-meta="author">{data.author.name}</span>
    <span class="hidden" data-pagefind-meta="distros">{data.distros.join(' ')}</span>

    <!-- 01. SPECIFICATION OVERVIEW -->
    <section class="bg-white border border-zinc-200 rounded-xl shadow-xs p-4 sm:p-7 w-full min-w-0" id="overview">
      <div class="border-b border-zinc-200 pb-3 mb-4 sm:mb-5 flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2.5">
          <span class="w-2 h-2 rounded-full bg-zinc-900 inline-block"></span>
          <h2 class="font-mono text-xs sm:text-sm uppercase font-bold text-zinc-900 tracking-wider">
            {t('spec.sectionOverview')}
          </h2>
        </div>
        <span class="font-mono text-xs text-zinc-600 bg-zinc-100 border border-zinc-200 px-2.5 py-0.5 rounded-md">Profile: {data.version || 'v1.0'}</span>
      </div>

      <div class="border border-zinc-200 rounded-lg overflow-hidden bg-white font-mono text-xs">
        <dl class="divide-y divide-zinc-100">
          <div class="grid grid-cols-1 md:grid-cols-12 p-3 sm:p-3.5 bg-zinc-50/70 min-w-0 break-words gap-1 md:gap-0">
            <dt class="md:col-span-3 font-semibold uppercase text-zinc-500 tracking-wider text-[11px] mb-1 md:mb-0">Purpose</dt>
            <dd class="md:col-span-9 text-zinc-900 font-sans leading-relaxed text-sm min-w-0 break-words">{data.summary}</dd>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 p-3 sm:p-3.5 bg-white min-w-0 break-words gap-1 md:gap-0">
            <dt class="md:col-span-3 font-semibold uppercase text-zinc-500 tracking-wider text-[11px] mb-1 md:mb-0">Compatibility</dt>
            <dd class="md:col-span-9 text-zinc-900 font-medium min-w-0 break-words">{distroLabels} (Server: {data.displayServer.toUpperCase()})</dd>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 p-3 sm:p-3.5 bg-zinc-50/70 min-w-0 break-words gap-1 md:gap-0">
            <dt class="md:col-span-3 font-semibold uppercase text-zinc-500 tracking-wider text-[11px] mb-1 md:mb-0">Window Manager & Theme</dt>
            <dd class="md:col-span-9 text-zinc-900 font-medium min-w-0 break-words">{wmLabel} <span class="text-zinc-400">/</span> {data.specs.theme || 'Paper Monochrome'}</dd>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 p-3 sm:p-3.5 bg-white min-w-0 break-words gap-1.5 md:gap-0">
            <dt class="md:col-span-3 font-semibold uppercase text-zinc-500 tracking-wider text-[11px] mb-1 md:mb-0">Key Components</dt>
            <dd class="md:col-span-9 text-zinc-900 leading-relaxed font-sans text-sm min-w-0 break-words">
              <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5 text-xs">
                <span class="inline-flex items-center gap-1"><span class="font-mono font-semibold text-zinc-500">Bar:</span> <span class="font-medium text-zinc-900">{data.specs.bar || 'N/A'}</span></span>
                <span class="text-zinc-300">•</span>
                <span class="inline-flex items-center gap-1"><span class="font-mono font-semibold text-zinc-500">Terminal:</span> <span class="font-medium text-zinc-900">{data.specs.terminal || 'N/A'}</span></span>
                <span class="text-zinc-300">•</span>
                <span class="inline-flex items-center gap-1"><span class="font-mono font-semibold text-zinc-500">Launcher:</span> <span class="font-medium text-zinc-900">{data.specs.launcher || 'N/A'}</span></span>
                {data.specs.notifications && (
                  <>
                    <span class="text-zinc-300">•</span>
                    <span class="inline-flex items-center gap-1"><span class="font-mono font-semibold text-zinc-500">Notifications:</span> <span class="font-medium text-zinc-900">{data.specs.notifications}</span></span>
                  </>
                )}
                {data.specs.editor && (
                  <>
                    <span class="text-zinc-300">•</span>
                    <span class="inline-flex items-center gap-1"><span class="font-mono font-semibold text-zinc-500">Editor:</span> <span class="font-medium text-zinc-900">{data.specs.editor}</span></span>
                  </>
                )}
              </div>
            </dd>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 p-3 sm:p-3.5 bg-zinc-50/70 min-w-0 break-words">
            <dt class="md:col-span-3 font-semibold uppercase text-zinc-500 tracking-wider text-[11px] mb-1 md:mb-0">Hardware Metrics</dt>
            <dd class="md:col-span-9 text-zinc-900 font-semibold min-w-0 break-words">
              Idle RAM: {data.specs.ramIdleMiB ? `~${data.specs.ramIdleMiB} MiB` : 'Not benchmarked'}
              {data.specs.batteryProfile && <span class="text-emerald-700 ml-2 font-normal">• Battery profile : Active</span>}
            </dd>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 p-3 sm:p-3.5 bg-white min-w-0 break-words">
            <dt class="md:col-span-3 font-semibold uppercase text-zinc-500 tracking-wider text-[11px] mb-1 md:mb-0">Full Description</dt>
            <dd class="md:col-span-9 text-zinc-700 font-sans leading-relaxed text-sm min-w-0 break-words">{data.description || data.summary}</dd>
          </div>
        </dl>
      </div>

      {data.description && (
        <div class="mt-4 p-4 rounded-xl border border-zinc-200 bg-zinc-50/50">
          <div class="font-mono text-xs uppercase font-semibold text-zinc-500 mb-2 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-zinc-500 inline-block"></span>
            <span>Architecture & Technical Design</span>
          </div>
          <p class="font-sans text-sm text-zinc-800 leading-relaxed">
            {data.description}
          </p>
        </div>
      )}
    </section>

    <!-- 02. INSTALLATION & PACKAGES -->
    <section class="bg-white border border-zinc-200 rounded-xl shadow-xs p-4 sm:p-7 flex flex-col gap-4 w-full min-w-0 overflow-hidden" id="installation">
      <div class="border-b border-zinc-200 pb-3 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="w-2 h-2 rounded-full bg-zinc-900 inline-block"></span>
          <h2 class="font-mono text-xs sm:text-sm uppercase font-bold text-zinc-900 tracking-wider">
            {t('spec.sectionInstall')}
          </h2>
        </div>
        <span class="font-mono text-xs text-zinc-400">Method: Verified Command</span>
      </div>

      <div class="flex flex-col gap-3 w-full min-w-0">
        <!-- Action Toolbar -->
        <div class="border border-zinc-200 rounded-xl bg-zinc-50 p-3 flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center gap-2.5">
          <button
            type="button"
            id="btn-download-sh"
            data-filename={`${entry.id.replace('/', '-')}-install.sh`}
            data-script={installScriptContent}
            class="min-h-[44px] inline-flex items-center justify-center gap-2 border border-zinc-200 bg-white hover:bg-zinc-100 text-zinc-800 px-4 py-2 rounded-lg font-mono text-xs font-semibold shadow-2xs transition-colors cursor-pointer flex-1 sm:flex-initial"
          >
            <svg class="w-4 h-4 text-zinc-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
            </svg>
            <span class="truncate">Download script (.sh)</span>
          </button>
        </div>

        <!-- Security Notice & Hash Verification -->
        {data.install.script && (
          <div class="bg-amber-50/80 border border-amber-200 rounded-xl p-3.5 font-mono text-xs text-amber-900 flex flex-col sm:flex-row sm:items-center justify-between gap-2 shadow-2xs">
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-md bg-amber-200 text-amber-900 font-bold flex items-center justify-center text-xs shrink-0">!</span>
              <span>{t('spec.securityNotice')}</span>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <a
                href={scriptBlobUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="underline font-semibold text-amber-950 hover:text-black"
              >
                {t('spec.viewSource')}
              </a>
            </div>
          </div>
        )}

        {data.install.script && (
          <div class="border border-zinc-200 rounded-xl bg-zinc-50 p-3 font-mono text-xs text-zinc-600 flex flex-wrap items-center justify-between gap-2">
            <span class="font-medium">{t('spec.checksum')}</span>
            <code class="text-zinc-900 font-semibold select-all break-all">{data.install.script.sha256}</code>
            <CopyButton text={data.install.script.sha256} label="Copy Hash" class="py-0.5 text-[11px]" />
          </div>
        )}
      </div>

      <!-- Alternative package archives -->
      {data.install.packages && data.install.packages.length > 0 && (
        <div class="flex items-center gap-2 font-mono text-xs pt-1">
          <span class="text-zinc-500 uppercase">Alternative Packages:</span>
          <div class="flex flex-wrap gap-2">
            {data.install.packages.map((pkg) => (
              <a
                href={pkg.url}
                target="_blank"
                rel="noopener noreferrer"
                class="border border-zinc-200 bg-white hover:bg-zinc-900 hover:text-white px-2.5 py-1 rounded-md shadow-2xs uppercase font-medium transition-colors"
              >
                .{pkg.type}
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Deployment Accordion Steps -->
      {data.install.steps && data.install.steps.length > 0 && (
        <div class="pt-2">
          <Accordion steps={data.install.steps} locale={locale} />
        </div>
      )}
    </section>

    <!-- 03. SCREENSHOT GALLERY -->
    <ScreenshotGallery screenshots={mergedScreenshots} configName={data.name} />

    <!-- 04. DOCUMENTATION // README.MD -->
    <section class="bg-white border border-zinc-200 rounded-xl shadow-xs p-4 sm:p-7 flex flex-col gap-4 w-full min-w-0 overflow-hidden" id="readme">
      <div class="border-b border-zinc-200 pb-3 flex flex-wrap items-center justify-between gap-2 font-mono text-xs">
        <div class="flex items-center gap-2.5">
          <span class="w-2 h-2 rounded-full bg-zinc-900 inline-block"></span>
          <h2 class="text-xs sm:text-sm uppercase font-bold text-zinc-900 tracking-wider">
            {t('spec.sectionReadme')}
          </h2>
        </div>
        <div class="flex items-center gap-3 text-zinc-500">
          <span>Source: <a href={data.source.repo} target="_blank" rel="noopener noreferrer" class="underline text-zinc-900 font-semibold">{data.source.repo.replace('https://github.com/', '')}</a></span>
          <span>Ref: <code class="text-zinc-900 font-medium">{data.source.ref.slice(0, 10)}</code></span>
        </div>
      </div>

      <!-- Authentic GitHub Repository File Box -->
      <div class="border border-zinc-300 rounded-lg overflow-hidden bg-white shadow-2xs w-full min-w-0">
        <!-- GitHub File Header Bar -->
        <div class="bg-[#f6f8fa] border-b border-[#d0d7de] px-4 py-2.5 flex items-center justify-between flex-wrap gap-2 text-xs">
          <div class="flex items-center gap-2 text-zinc-800 font-mono font-semibold">
            <!-- GitHub Book Octicon -->
            <svg class="w-4 h-4 text-zinc-500 shrink-0 fill-current" viewBox="0 0 16 16">
              <path d="M0 1.75A.75.75 0 0 1 .75 1h4.253c1.227 0 2.317.59 3 1.501A3.743 3.743 0 0 1 11.006 1h4.241a.75.75 0 0 1 .75.75v10.5a.75.75 0 0 1-.75.75h-4.25a2.25 2.25 0 0 0-1.5.572V14.5a.75.75 0 0 1-1.5 0v-1.178A2.25 2.25 0 0 0 6.5 12.75H2.25a.75.75 0 0 1-.75-.75V1.75ZM1.5 12.008a3.74 3.74 0 0 1 2.25-.758h2.75v-9.5H2.253a2.25 2.25 0 0 0-1.753.84v9.418ZM7.5 11.25V2.41a2.25 2.25 0 0 0-1.747-.66H2.253v9.5H6.5c.348 0 .686.04 1 .116Zm1 0c.314-.076.652-.116 1-.116h4.25v-9.5H11.006a2.25 2.25 0 0 0-1.753.66v8.84Zm5.5.758a3.74 3.74 0 0 1-2.25-.758v-9.5h2.241a2.25 2.25 0 0 0-1.741.84v9.418Z"></path>
            </svg>
            <span class="font-bold text-zinc-900">{data.source.readme || 'README.md'}</span>
            <span class="text-zinc-400 font-normal">|</span>
            <span class="text-zinc-500 font-mono text-[11px] font-normal">GitHub Flavored Markdown</span>
          </div>

          <div class="flex items-center gap-2">
            <a
              href={rawReadmeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono font-medium text-zinc-700 bg-white border border-zinc-300 rounded hover:bg-zinc-100 hover:text-zinc-900 transition-colors shadow-2xs"
            >
              <span>Raw</span>
            </a>
            <a
              href={`${data.source.repo}/blob/${data.source.ref}/${data.source.readme || 'README.md'}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono font-medium text-zinc-700 bg-white border border-zinc-300 rounded hover:bg-zinc-100 hover:text-zinc-900 transition-colors shadow-2xs"
            >
              <span>GitHub ↗</span>
            </a>
          </div>
        </div>

        <!-- Official GitHub Markdown Body -->
        <div class="p-5 sm:p-8 md:p-10 bg-white w-full max-w-full overflow-x-auto">
          <article class="markdown-body" set:html={readmeHtml} />
        </div>
      </div>

      <div class="border-t border-zinc-100 pt-3 flex items-center justify-between font-mono text-xs text-zinc-400">
        <span>GitHub Flavored Markdown (github-markdown-css)</span>
        <span class="text-emerald-700 font-semibold">● Live Repo Synced</span>
      </div>
    </section>

    <!-- 05. KEYBOARD KEYBINDINGS -->
    {data.keybindings && data.keybindings.length > 0 && (
      <section class="bg-white border border-zinc-200 rounded-xl shadow-xs p-4 sm:p-7 w-full min-w-0 overflow-hidden" id="keybindings">
        <div class="border-b border-zinc-200 pb-3 mb-4 flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-2.5">
            <span class="w-2 h-2 rounded-full bg-zinc-900 inline-block"></span>
            <h2 class="font-mono text-xs sm:text-sm uppercase font-bold text-zinc-900 tracking-wider">
              {t('spec.keybindings')}
            </h2>
          </div>
          <span class="font-mono text-xs text-zinc-400">Total: {data.keybindings.length} shortcuts</span>
        </div>

        <!-- Desktop Table View -->
        <div class="hidden sm:block border border-zinc-200 rounded-lg overflow-x-auto bg-white">
          <table class="w-full text-left font-mono text-xs border-collapse">
            <thead class="bg-zinc-50 border-b border-zinc-200 font-semibold text-zinc-600 text-[11px] uppercase">
              <tr>
                <th class="p-3 border-r border-zinc-100">Keys</th>
                <th class="p-3 border-r border-zinc-100">Action</th>
                <th class="p-3">Effect</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-100 bg-white">
              {data.keybindings.map((kb) => (
                <tr class="hover:bg-zinc-50/60 transition-colors">
                  <td class="p-3 border-r border-zinc-100 font-medium text-zinc-900 whitespace-nowrap">
                    <kbd class="px-2 py-0.5 bg-zinc-100 border border-zinc-300 rounded font-semibold text-zinc-800 shadow-2xs">{kb.keys}</kbd>
                  </td>
                  <td class="p-3 border-r border-zinc-100 font-semibold text-zinc-900">{kb.action}</td>
                  <td class="p-3 text-zinc-500">{kb.effect || 'System action'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Mobile Stacked Card View (Eliminates horizontal clipping) -->
        <div class="sm:hidden flex flex-col gap-2.5">
          {data.keybindings.map((kb) => (
            <div class="border border-zinc-200 rounded-lg p-3 bg-zinc-50/50 flex flex-col gap-1.5 shadow-2xs">
              <div class="flex items-center justify-between gap-2">
                <kbd class="px-2.5 py-1 bg-white border border-zinc-300 rounded font-mono text-xs font-bold text-zinc-900 shadow-2xs">
                  {kb.keys}
                </kbd>
                <span class="font-mono text-[10px] text-zinc-400 uppercase">Shortcut</span>
              </div>
              <div class="font-mono text-xs font-bold text-zinc-900 break-words pt-0.5">
                {kb.action}
              </div>
              {kb.effect && (
                <div class="font-sans text-xs text-zinc-600 leading-normal break-words border-t border-zinc-200/60 pt-1.5 mt-0.5">
                  {kb.effect}
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    )}
  </div>

  <script>
    function setupDetailActions() {
      // 1. Download shell script (.sh)
      const btnDownloadSh = document.getElementById('btn-download-sh');
      if (btnDownloadSh && !btnDownloadSh.dataset.bound) {
        btnDownloadSh.dataset.bound = 'true';
        btnDownloadSh.addEventListener('click', () => {
          const filename = btnDownloadSh.getAttribute('data-filename') || 'install.sh';
          const scriptContent = btnDownloadSh.getAttribute('data-script') || '';
          const blob = new Blob([scriptContent], { type: 'text/x-shellscript;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = filename;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        });
      }
    }

    setupDetailActions();
    document.addEventListener('DOMContentLoaded', setupDetailActions);
    document.addEventListener('astro:page-load', setupDetailActions);
  </script>
</Base>
