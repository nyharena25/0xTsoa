---
// Redirect legacy French route /contribuer to /contribute/
import { withBase } from '../../site.config';
const target = withBase('/contribute/');
const canonicalUrl = new URL(target, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={canonicalUrl} />
    <title>Redirecting...</title>
  </head>
  <body>
    <p>Redirecting to <a href={target}>{target}</a>...</p>
  </body>
</html>
