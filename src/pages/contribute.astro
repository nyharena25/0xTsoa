---
import Base from '../layouts/Base.astro';
import CopyButton from '../components/CopyButton.astro';
import BdBrickLogo from '../components/BdBrickLogo.astro';
import { useTranslations } from '../lib/i18n';
import { NEW_CONFIG_ISSUE_URL, REPO_URL, ALLOWED_IMAGE_HOSTS } from '../../site.config';
import { CATEGORIES } from '../lib/schema';
// Single source for the example: validated against the schema in tests/schema.test.ts
import exampleJsonSnippet from '../../schema/example.config.json?raw';

const locale = 'en';
const t = useTranslations(locale);

---

<Base
  title={t('contribute.metaTitle')}
  description={t('contribute.metaDescription')}
  locale={locale}
  statusPrefix="[STATUS: "
  statusInitial="CONTRIBUTOR"
  statusFinal="CONTRIBUTE"
>
  <div class="max-w-5xl mx-auto px-4 lg:px-8 py-8 flex flex-col gap-8">
    <!-- Header banner -->
    <div class="bg-white border border-zinc-200 rounded-xl p-6 sm:p-8 shadow-xs">
      <div class="inline-flex items-center gap-2 bg-zinc-100 border border-zinc-200 px-2.5 py-1 rounded-md font-mono text-xs font-semibold uppercase mb-3 text-zinc-700">
        <span class="w-2 h-2 rounded-full bg-zinc-900 inline-block"></span>
        <span>Contribution Guide</span>
      </div>
      <h1
        class="flex flex-wrap items-center gap-x-3 gap-y-2 font-display text-2xl sm:text-4xl uppercase font-bold text-zinc-900 tracking-tight"
      >
        <span data-page-title="true">{t('contribute.title').replace(/\s*0xTsoa$/i, '')}</span>{' '}
        <BdBrickLogo size="md" class="inline-flex text-zinc-900 align-middle shrink-0" />
      </h1>
      <p class="font-sans text-base text-zinc-600 mt-2 leading-relaxed">
        {t('contribute.subtitle')}
      </p>
    </div>

    <!-- 2 Methods grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Method 1: Pull Request -->
      <section class="bg-white border border-zinc-200 rounded-xl p-6 shadow-xs flex flex-col justify-between gap-5">
        <div class="flex flex-col gap-3">
          <div class="flex items-center justify-between border-b border-zinc-100 pb-3">
            <h2 class="font-mono text-xs sm:text-sm font-bold uppercase text-zinc-900 tracking-wide">
              {t('contribute.method1Title')}
            </h2>
            <span class="bg-zinc-900 text-white font-mono text-[10px] px-2 py-0.5 rounded font-medium">DEV_RECOMMENDED</span>
          </div>

          <p class="font-sans text-sm text-zinc-600 leading-relaxed">
            {t('contribute.method1Desc')}
          </p>

          <ol class="list-decimal list-inside font-mono text-xs space-y-2 text-zinc-700 bg-zinc-50 p-3.5 rounded-lg border border-zinc-200/60">
            <li>Fork the <span class="inline-flex items-center align-middle bg-zinc-100 border border-zinc-200 px-1.5 py-0.5 rounded mx-1"><BdBrickLogo size="xs" class="inline-block text-zinc-900" /></span> repository on GitHub.</li>
            <li>Create the file <code>configs/&lt;your-handle&gt;/&lt;slug&gt;.json</code>.</li>
            <li>Validate locally with <code>npm run validate</code>.</li>
            <li>Open your Pull Request towards <code>main</code>.</li>
          </ol>
        </div>

        <a
          href={`${REPO_URL}/blob/main/schema/config.schema.json`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 border border-zinc-200 bg-zinc-50 hover:bg-zinc-100 text-zinc-800 p-2.5 rounded-lg font-mono text-xs uppercase font-semibold text-center shadow-2xs transition-colors no-underline cursor-pointer"
        >
          {t('contribute.btnViewSchema')}
        </a>
      </section>

      <!-- Method 2: GitHub Issue Form -->
      <section class="bg-white border border-zinc-200 rounded-xl p-6 shadow-xs flex flex-col justify-between gap-5">
        <div class="flex flex-col gap-3">
          <div class="flex items-center justify-between border-b border-zinc-100 pb-3">
            <h2 class="font-mono text-xs sm:text-sm font-bold uppercase text-zinc-900 tracking-wide">
              {t('contribute.method2Title')}
            </h2>
            <span class="bg-zinc-100 text-zinc-700 border border-zinc-200 font-mono text-[10px] px-2 py-0.5 rounded font-medium">ZERO_CODE</span>
          </div>

          <p class="font-sans text-sm text-zinc-600 leading-relaxed">
            {t('contribute.method2Desc')}
          </p>

          <div class="bg-zinc-50 border border-zinc-200/60 rounded-lg p-3.5 font-mono text-xs text-zinc-600 leading-relaxed">
            Pick the desktop part, paste your install commands (dependencies, deploy, reload) and screenshots. Our GitHub Action builds the JSON, computes the SHA-256 of any install script, and opens the Pull Request with CI validation.
          </div>
        </div>

        <a
          href={NEW_CONFIG_ISSUE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-zinc-900 hover:bg-zinc-800 text-white p-2.5 rounded-lg font-mono text-xs uppercase font-semibold text-center shadow-2xs transition-colors no-underline cursor-pointer"
        >
          {t('contribute.btnOpenIssue')}
        </a>
      </section>
    </div>

    <!-- Security Rules Section -->
    <section class="bg-white border border-zinc-200 rounded-xl p-6 shadow-xs flex flex-col gap-3 font-mono text-xs">
      <div class="border-b border-zinc-100 pb-3 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-zinc-900 inline-block"></span>
        <h2 class="font-bold uppercase text-zinc-900 tracking-wide">CI VALIDATION & SECURITY RULES</h2>
      </div>

      <ul class="space-y-2.5 text-zinc-700 font-sans text-sm leading-relaxed">
        <li class="flex items-start gap-2">
          <span class="font-mono font-bold text-zinc-900 shrink-0">1.</span>
          <div>
            <strong class="font-semibold text-zinc-900">Reproducible install scripts:</strong> If you provide an install script URL (<code>.sh</code>), it must point to a full 40-character commit SHA or immutable tag, and include a verified <code>sha256</code> checksum.
          </div>
        </li>
        <li class="flex items-start gap-2">
          <span class="font-mono font-bold text-zinc-900 shrink-0">2.</span>
          <div>
            <strong class="font-semibold text-zinc-900">Allowed screenshot hosts:</strong> Screenshots must be hosted on:
            <code class="font-mono text-xs bg-zinc-100 px-1 py-0.5 rounded">{ALLOWED_IMAGE_HOSTS.join(', ')}</code>.
          </div>
        </li>
        <li class="flex items-start gap-2">
          <span class="font-mono font-bold text-zinc-900 shrink-0">3.</span>
          <div>
            <strong class="font-semibold text-zinc-900">Pinned README reference:</strong> The <code>source.ref</code> property must be a fixed tag or commit for deterministic builds and historical preservation.
          </div>
        </li>
        <li class="flex items-start gap-2">
          <span class="font-mono font-bold text-zinc-900 shrink-0">4.</span>
          <div>
            <strong class="font-semibold text-zinc-900">Installation is required:</strong> <code>install.steps</code> needs at least a <code>deps</code> step (packages or clone); <code>dotfiles</code> and <code>reload</code> are optional. They render as "02. Installation &amp; Deployment".
          </div>
        </li>
        <li class="flex items-start gap-2">
          <span class="font-mono font-bold text-zinc-900 shrink-0">5.</span>
          <div>
            <strong class="font-semibold text-zinc-900">Desktop part &amp; tags:</strong> set <code>category</code> to one of <code class="font-mono text-xs bg-zinc-100 px-1 py-0.5 rounded">{CATEGORIES.join(', ')}</code>. Tags name components and features, never the WM, distro or theme style (those are filters already).
          </div>
        </li>
      </ul>
    </section>

    <!-- Example JSON Block -->
    <section class="bg-white border border-zinc-200 rounded-xl p-6 shadow-xs flex flex-col gap-3">
      <div class="flex items-center justify-between border-b border-zinc-100 pb-3">
        <h2 class="font-mono text-xs uppercase font-bold text-zinc-900 tracking-wide">
          Standardized JSON Format Example
        </h2>
        <CopyButton text={exampleJsonSnippet} label="Copy Example" />
      </div>

      <pre class="bg-zinc-900 text-zinc-200 rounded-xl border border-zinc-800 p-4 font-mono text-xs overflow-x-auto shadow-inner"><code>{exampleJsonSnippet}</code></pre>
    </section>
  </div>
</Base>
