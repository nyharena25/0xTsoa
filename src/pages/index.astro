---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Spotlight from '../components/Spotlight.astro';
import Manifesto from '../components/Manifesto.astro';
import TopicLinks from '../components/TopicLinks.astro';
import { getCollection } from 'astro:content';
import { recentlyUpdated } from '../lib/stats';
import { useTranslations } from '../lib/i18n';
import { withBase, REPO_URL } from '../../site.config';

const t = useTranslations('en');
const allConfigs = await getCollection('configs');
// The five entries most recently updated upstream on GitHub (nightly sync data).
const spotlightConfigs = recentlyUpdated(allConfigs);

const siteRootUrl = new URL(withBase('/'), Astro.site).href;
const aboutUrl = new URL(withBase('/about/'), Astro.site).href;
const logoUrl = new URL(withBase('/logo.png'), Astro.site).href;
const searchTargetUrl = `${new URL(withBase('/catalogue/'), Astro.site).href}?q={search_term_string}`;
const founderId = `${siteRootUrl}#founder`;
const orgId = `${siteRootUrl}#org`;
const websiteId = `${siteRootUrl}#website`;

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': founderId,
      name: 'Ny Harena RAVELOMANANTSOA',
      givenName: 'Ny Harena',
      familyName: 'RAVELOMANANTSOA',
      alternateName: 'nyharena25',
      nationality: {
        '@type': 'Country',
        name: 'Madagascar',
      },
      jobTitle: 'Software Developer',
      url: aboutUrl,
      sameAs: [
        'https://github.com/nyharena25',
        'https://www.linkedin.com/in/rnyharena-dev/',
        // TODO: Add X, Mastodon, and dev.to profile URLs once created
      ],
    },
    {
      '@type': 'Organization',
      '@id': orgId,
      name: '0xTsoa',
      alternateName: ['ZeroTsoa', '0x Tsoa', '0xtsoa'],
      url: siteRootUrl,
      logo: logoUrl,
      description: t('site.description'),
      founder: { '@id': founderId },
      sameAs: [
        REPO_URL,
        // TODO: Add official 0xTsoa / creator profiles (X, Mastodon, dev.to) once created
      ],
    },
    {
      '@type': 'SoftwareApplication',
      name: '0xTsoa',
      alternateName: 'ZeroTsoa',
      url: siteRootUrl,
      description: t('site.description'),
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Linux',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      license: 'https://spdx.org/licenses/MIT.html',
      codeRepository: REPO_URL,
      author: { '@id': founderId },
      publisher: { '@id': orgId },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: '0xTsoa',
      alternateName: 'ZeroTsoa',
      url: siteRootUrl,
      description: t('site.description'),
      publisher: { '@id': orgId },
      potentialAction: {
        '@type': 'SearchAction',
        target: searchTargetUrl,
        'query-input': 'required name=search_term_string',
      },
    },
  ],
};
---

<Base
  locale="en"
  statusPrefix="[STATUS: "
  statusInitial="EXIT 1"
  statusFinal="EXIT 0"
  jsonLd={homeJsonLd}
>
  <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-5 sm:py-8 flex flex-col gap-6 sm:gap-10">
    <Hero />
    <Spotlight configs={spotlightConfigs} />

    <!-- Browse by topic: the published topic pages -->
    <section class="bg-white border border-zinc-200 rounded-xl p-4 sm:p-5 shadow-xs flex flex-col gap-3" aria-labelledby="browse-topics-title">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 id="browse-topics-title" class="flex items-center gap-2.5 font-mono text-xs font-bold uppercase tracking-wider text-zinc-900 m-0">
          <span class="w-2 h-2 rounded-full bg-zinc-900 inline-block"></span>
          Browse by topic
        </h2>
        <a href={withBase('/catalogue/')} class="btn-solid text-xs py-1 px-3">
          <span>View all</span>
          <span>&rarr;</span>
        </a>
      </div>
      <TopicLinks />
    </section>

    <Manifesto />
  </div>
</Base>
